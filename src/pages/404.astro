---
import Base from "../layouts/Base.astro";
---

<Base
  lang="en"
  title="Page not found"
  description="Find your next field note."
  noindex={true}
>
  <section class="page-heading">
    <p class="eyebrow">404 / NO FIELD NOTE HERE</p>
    <h1>This shelf is empty.</h1>
    <p>The URL may have changed. The catalog is still here.</p>
    <a class="button primary" href="/en/catalog/">
      Explore the catalog →
    </a>
    <div class="resource-links">
      <a href="/ko/">한국어 →</a>
      <a href="/ja/">日本語 →</a>
    </div>
  </section>
</Base>
