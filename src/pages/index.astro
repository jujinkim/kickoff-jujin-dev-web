---
import { strings, siteName, siteTitle } from "../lib/i18n";
const t = strings.en;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href="https://kickoff.jujin.dev/en/" />
    <title>{t.hero} · {siteTitle}</title>
    <meta name="description" content={t.siteDescription} />
    <meta property="og:title" content={t.hero} />
    <meta property="og:description" content={t.siteDescription} />
    <meta property="og:url" content="https://kickoff.jujin.dev/en/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
  </head>
  <body>
    <main>
      <h1>
        {siteName} <small>by jujin</small>
      </h1>
      <p>{t.intro}</p>
      <p>Choose your language</p>
      <nav aria-label="Language">
        <a href="/en/" lang="en">
          English
        </a>
        <a href="/ko/" lang="ko">
          한국어
        </a>
        <a href="/ja/" lang="ja">
          日本語
        </a>
      </nav>
    </main>
    <footer class="site-footer">
      <p>{t.siteNotice}</p>
    </footer>
    <script>
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 1500);
      let selected = false;
      const suffix = window.location.search + window.location.hash;

      for (const link of document.querySelectorAll<HTMLAnchorElement>(
        "nav a",
      )) {
        link.href += suffix;
        link.addEventListener("click", (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
            return;
          selected = true;
          controller.abort();
          window.clearTimeout(timeout);
        });
      }

      async function openDefaultLanguage() {
        let language = "en";
        try {
          const response = await fetch("https://api.country.is/", {
            signal: controller.signal,
            credentials: "omit",
            referrerPolicy: "no-referrer",
          });
          if (response.ok) {
            const { country } = await response.json();
            if (country === "KR") language = "ko";
            else if (country === "JP") language = "ja";
          }
        } catch {
          // Keep English when the lookup is unavailable, blocked, or too slow.
        } finally {
          window.clearTimeout(timeout);
        }
        if (!selected) window.location.replace(`/${language}/${suffix}`);
      }

      void openDefaultLanguage();
    </script>
  </body>
</html>

<style>
  :global(html) {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
  }
  :global(body) {
    box-sizing: border-box;
    max-width: 720px;
    margin: 0 auto;
    padding: 24px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.6;
  }
  footer {
    margin-top: 24px;
    font-size: 0.9rem;
  }
  h1 {
    font-size: 28px;
  }
  small {
    font-size: 14px;
    font-weight: 400;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  a {
    color: inherit;
    text-underline-offset: 4px;
    padding-block: 12px;
  }
</style>
