---
import Base from "../../../layouts/Base.astro";
import StartupPrompt from "../../../components/StartupPrompt.astro";
import { languages, strings, siteTitle } from "../../../lib/i18n";
import { startupText } from "../../../lib/startup";
import { Content as English } from "../../../startup/v1/en.md";
import { Content as Korean } from "../../../startup/v1/ko.md";
import { Content as Japanese } from "../../../startup/v1/ja.md";
export const getStaticPaths = () =>
  languages.map((lang) => ({ params: { lang }, props: { lang } }));
const { lang } = Astro.props;
const t = startupText[lang];
const Content = { en: English, ko: Korean, ja: Japanese }[lang];
---

<Base lang={lang} title={`${t.title} · v1`} description={t.intro}>
  <section class="page-heading">
    <p class="eyebrow">provided by {siteTitle} · v1</p>
    <h1>{t.title}</h1>
    <p>{t.intro}</p>
    <p class="site-notice">{strings[lang].siteNotice}</p>
  </section>
  <div class="guide-content">
    <StartupPrompt lang={lang} version="v1" />
    <div class="prose">
      <Content />
    </div>
    <section>
      <h2>{t.versions}</h2>
      <p>{t.history}</p>
      <a href={`/${lang}/start/`}>{t.versions} →</a>
    </section>
  </div>
</Base>
