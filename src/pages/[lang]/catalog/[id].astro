---
import Article from "../../../components/Article.astro";
import { published, articleUrl } from "../../../lib/content";
export async function getStaticPaths() {
  return (await published()).map((article) => ({
    params: { lang: article.data.lang, id: article.data.articleId },
    props: { article },
  }));
}
const { article } = Astro.props;
---

{article.data.kind === "concept" ? (
  <Article article={article} />
) : (
  <html lang={article.data.lang}>
    <head>
      <meta charset="utf-8" />
      <meta http-equiv="refresh" content={`0;url=${articleUrl(article)}`} />
      <meta name="robots" content="noindex" />
      <link
        rel="canonical"
        href={`https://kickoff.jujin.dev${articleUrl(article)}`}
      />
      <title>{article.data.title}</title>
    </head>
    <body>
      <a href={articleUrl(article)}>{article.data.title}</a>
    </body>
  </html>
)}
