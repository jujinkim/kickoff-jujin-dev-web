---
import Base from "../../../layouts/Base.astro";
import { languages, strings } from "../../../lib/i18n";
import { childrenOf } from "../../../lib/catalog";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
const categories = childrenOf(null);
---

<Base lang={lang} title={t.catalog} description={t.intro}>
  <section class="page-heading">
    <h1>{t.catalog}</h1>
    <p>
      {lang === "ko"
        ? "카테고리를 선택해 개념과 도구를 탐색하고 비교하세요."
        : lang === "ja"
          ? "カテゴリーを選んで、概念とツールを探し、比較します。"
          : "Choose a category to explore and compare concepts and tools."}
    </p>
  </section>
  <nav aria-label={t.catalog}>
    <ul class="catalog-categories">
      {categories.map((category, index) => (
        <li>
          <a
            class="category-card"
            href={`/${lang}/catalog/categories/${category.id}/`}
          >
            <span class="category-card-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h2>{category.names[lang]}</h2>
            <p>
              {childrenOf(category.id)
                .map((child) => child.names[lang])
                .join(" · ")}
            </p>
            <span class="category-card-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Base>

<style>
  .catalog-categories {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0 0 3.5rem;
    margin: 0;
  }
  .category-card {
    display: flex;
    flex-direction: column;
    min-height: 260px;
    height: 100%;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow-wrap: anywhere;
    transition:
      background 150ms ease,
      border-color 150ms ease;
  }
  .category-card:hover,
  .category-card:focus-visible {
    background: var(--soft);
    border-color: var(--green);
    text-decoration: none;
  }
  .category-card-number {
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .category-card h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
  }
  .category-card p {
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .category-card-arrow {
    align-self: flex-end;
    margin-top: auto;
    color: var(--green);
    font-size: 1.75rem;
    line-height: 1;
  }
  @media (max-width: 900px) {
    .catalog-categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .catalog-categories {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .category-card {
      min-height: 220px;
      padding: 1.5rem;
    }
  }
</style>
