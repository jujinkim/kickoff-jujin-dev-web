---
import Base from "../../../layouts/Base.astro";
import ArticleListing from "../../../components/ArticleListing.astro";
import { languages, strings } from "../../../lib/i18n";
import { childrenOf } from "../../../lib/catalog";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
const categories = childrenOf(null);
---

<Base lang={lang} title={t.catalog} description={t.catalogIntro}>
  <section class="page-heading">
    <p class="eyebrow">{t.fieldGuide}</p>
    <h1>{t.catalog}</h1>
    <p>{t.catalogIntro}</p>
  </section>
  <nav aria-label={t.catalog}>
    <ul class="catalog-categories">
      {categories.map((category, index) => (
        <li>
          <a
            class="category-card"
            href={`/${lang}/catalog/categories/${category.id}/`}
          >
            <span aria-hidden="true">0{index + 1}</span>
            <strong>{category.names[lang]}</strong>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <ArticleListing lang={lang} kind="concept" />
</Base>
<style>
  .catalog-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }
  .category-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.85rem;
    min-height: 48px;
  }
  .category-card:hover {
    background: var(--soft);
    text-decoration: none;
  }
  .category-card span {
    color: var(--muted);
    font-size: 0.75rem;
  }
  @media (max-width: 440px) {
    .catalog-categories li {
      flex: 1 1 100%;
    }
    .category-card strong {
      flex: 1;
    }
  }
</style>
