---
import Base from "../../../layouts/Base.astro";
import ArticleListing from "../../../components/ArticleListing.astro";
import CategoryTree from "../../../components/CategoryTree.astro";
import { languages, strings } from "../../../lib/i18n";
import { candidates } from "../../../lib/catalog";
import { published } from "../../../lib/content";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
const count = (await published()).filter(
  (a) => a.data.lang === lang && a.data.kind === "concept",
).length;
---

<Base lang={lang} title={t.catalog} description={t.intro}>
  <section class="page-heading">
    <h1>{t.catalog}</h1>
    <p>
      {lang === "ko"
        ? "분류를 따라 개념과 도구를 탐색하고 비교하세요."
        : lang === "ja"
          ? "分類から概念とツールを探し、比較します。"
          : "Explore and compare concepts and tools by category."}
    </p>
    <p>
      {count} {t.count} · {candidates.length}{" "}
      {lang === "ko"
        ? "초기 후보"
        : lang === "ja"
          ? "初期候補"
          : "initial candidates"}
    </p>
    <a href={`/${lang}/guides/`}>{t.guides} →</a>
  </section>
  <details class="category-index">
    <summary>
      {lang === "ko"
        ? "분류 탐색"
        : lang === "ja"
          ? "分類を探す"
          : "Browse categories"}
      <span class="category-index-arrow" aria-hidden="true">
        ⌄
      </span>
    </summary>
    <CategoryTree lang={lang} />
  </details>
  <ArticleListing lang={lang} kind="concept" />
</Base>

<style>
  .category-index {
    margin-bottom: 1rem;
  }
  .category-index > summary {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }
  .category-index > summary::-webkit-details-marker {
    display: none;
  }
  .category-index-arrow {
    line-height: 1;
  }
  .category-index[open] .category-index-arrow {
    transform: rotate(180deg);
  }
  .category-index :global(.category-tree) {
    margin: 0;
    padding-left: 1rem;
  }
  .category-index :global(.category-tree > li) {
    margin: 0.35rem 0;
  }
  .category-index :global(.category-tree[data-root="true"]) {
    gap: 1rem 1.5rem;
    padding: 0.5rem 0 1rem;
  }
  .category-index :global(.category-tree[data-root="true"] > li) {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .category-index :global(.category-tree[data-root="true"] > li > a) {
    font-size: 1rem;
  }
</style>
