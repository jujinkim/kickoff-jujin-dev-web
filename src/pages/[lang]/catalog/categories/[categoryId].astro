---
import Base from "../../../../layouts/Base.astro";
import CategoryTree from "../../../../components/CategoryTree.astro";
import Comparison from "../../../../components/Comparison.astro";
import ArticleListing from "../../../../components/ArticleListing.astro";
import { taxonomy, candidates, ancestors } from "../../../../lib/catalog";
import { listed } from "../../../../lib/content";
import { languages, strings } from "../../../../lib/i18n";
import { categoryReplacement } from "../../../../lib/catalog-scope";
export function getStaticPaths() {
  return languages.flatMap((lang) =>
    taxonomy.map((category) => ({
      params: { lang, categoryId: category.id },
      props: { lang, category },
    })),
  );
}
const { lang, category } = Astro.props;
const t = strings[lang];
const replacement = categoryReplacement(category.id);
const articles = (await listed()).filter(
  (a) =>
    a.data.lang === lang &&
    a.data.kind === "concept" &&
    a.data.category === category.id,
);
const pending = candidates.filter(
  (c) =>
    c.category === category.id &&
    !articles.some((a) => a.data.articleId === c.id),
);
---

{replacement ? (
  <html lang={lang}>
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta
        http-equiv="refresh"
        content={`0;url=/${lang}/guides/${replacement}/`}
      />
      <meta name="robots" content="noindex" />
      <link
        rel="canonical"
        href={`https://jujin.dev/${lang}/guides/${replacement}/`}
      />
      <title>{t.guides}</title>
    </head>
    <body>
      <a href={`/${lang}/guides/${replacement}/`}>{t.guides} →</a>
    </body>
  </html>
) : (
  <Base
    lang={lang}
    title={category.names[lang]}
    description={category.descriptions[lang]}
  >
    <section class="page-heading">
      <nav class="breadcrumb" aria-label={t.catalog}>
        <a href={`/${lang}/catalog/`}>{t.catalog}</a>
        {ancestors(category.id).map((c) => (
          <>
            {" "}
            /{" "}
            <a
              href={`/${lang}/catalog/categories/${c.id}/`}
              aria-current={c.id === category.id ? "page" : undefined}
            >
              {c.names[lang]}
            </a>
          </>
        ))}
      </nav>
      <h1>{category.names[lang]}</h1>
      <p>{category.descriptions[lang]}</p>
    </section>
    <section class="section">
      <CategoryTree parent={category.id} lang={lang} />
      <ArticleListing lang={lang} kind="concept" categoryId={category.id} />
      <ul class="concept-list">
        {pending.map((c) => (
          <li data-candidate={c.id}>
            <strong>{c.titles[lang]}</strong>{" "}
            <span class="tiny-label">{t.pending}</span>
          </li>
        ))}
      </ul>
      <Comparison articles={articles} lang={lang} />
    </section>
  </Base>
)}
