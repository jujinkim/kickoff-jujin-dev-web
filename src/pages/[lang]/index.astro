---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import PromptExample from "../../components/PromptExample.astro";
import { helpText } from "../../lib/help";
import { languages, strings, categories, categoryNames } from "../../lib/i18n";
import { ancestors } from "../../lib/catalog";
import { listed } from "../../lib/content";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
const h = helpText[lang];
const all = await listed();
const concepts = all.filter(
  (a) => a.data.lang === lang && a.data.kind === "concept",
);
const articles = all.filter(
  (a) => a.data.lang === lang && a.data.kind === "guide",
);
const recommended = ["srs", "architecture", "layout"].map((id) =>
  articles.find((a) => a.data.articleId === id)!,
);
---

<Base lang={lang} title={t.hero} description={t.siteDescription}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span></span>
        {t.eyebrow}
      </p>
      <h1>{t.hero}</h1>
      <p class="hero-description">{t.intro}</p>
      <div class="hero-actions">
        <a class="button primary" href={`/${lang}/start/`}>
          {t.createPrompt} <span>↗</span>
        </a>
        <a class="text-link" href={`/${lang}/help/`}>
          {t.help} →
        </a>
      </div>
      <p class="hero-handoff">{t.siteNotice}</p>
    </div>
    <PromptExample lang={lang} />
  </section>
  <section
    class="prompt-value"
    data-home-section="prompt-value"
    aria-labelledby="prompt-value-title"
  >
    <h2 id="prompt-value-title">{t.promptValue.title}</h2>
    <p class="section-intro">{t.promptValue.intro}</p>
    <dl class="prompt-benefits">
      {t.promptValue.benefits.map((benefit) => (
        <div>
          <dt>{benefit.title}</dt>
          <dd>{benefit.body}</dd>
        </div>
      ))}
    </dl>
    <p class="prompt-limits">
      {t.promptValue.limits}{" "}
      <a class="text-link" href={`/${lang}/ai/`}>
        {t.promptValue.readRules} →
      </a>
    </p>
  </section>
  <figure class="hero-art prompt-art" aria-labelledby="prompt-flow-title">
    <figcaption id="prompt-flow-title">{h.flowTitle}</figcaption>
    <ol class="prompt-flow" role="list">
      {h.flow.map((group) => (
        <li>
          <strong class="flow-place">{group.place}</strong>
          <ol class="flow-steps" role="list">
            {group.steps.map((step, i) => (
              <li>
                <span aria-hidden="true">{i === 0 ? "→" : "↓"}</span>
                {step}
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </figure>
  <section class="section" data-home-section="examples">
    <div class="section-heading">
      <h2>{t.examplesTitle}</h2>
      <a class="text-link" href={`/${lang}/catalog/`}>
        {t.browse} →
      </a>
    </div>
    <p class="section-intro">{t.examplesIntro}</p>
    <div class="catalog-grid">
      {concepts
        .filter((a) =>
          ["two-columns", "serif", "hexagonal-architecture"].includes(
            a.data.articleId,
          ),
        )
        .map((article) => (
          <Card article={article} />
        ))}
    </div>
  </section>
  <section class="category-section" data-home-section="catalog">
    <div class="section-heading">
      <h2>{t.catalog}</h2>
      <span class="tiny-label">
        THE INDEX / 01—{categories.length.toString().padStart(2, "0")}
      </span>
    </div>
    <p class="section-intro">{t.catalogIntro}</p>
    <div class="category-grid">
      {categories.map((category, i) => (
        <a href={`/${lang}/catalog/categories/${category}/`}>
          <span class="category-number">0{i + 1}</span>
          <strong>{categoryNames[lang][category]}</strong>
          <span>
            {concepts
              .filter((a) =>
                ancestors(a.data.category).some((c) => c.id === category),
              )
              .length.toString()
              .padStart(2, "0")}{" "}
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="section" data-home-section="planning">
    <div class="section-heading">
      <div>
        <h2>{t.guides}</h2>
      </div>
      <a class="text-link" href={`/${lang}/guides/`}>
        {t.guides} →
      </a>
    </div>
    <p class="section-intro">{t.guidesIntro}</p>
    <div class="catalog-grid home-grid">
      {recommended.map((article, index) => (
        <Card article={article} index={index} />
      ))}
    </div>
  </section>
</Base>

<style>
  .prompt-value {
    padding: 8px 0 24px;
  }
  .prompt-benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 24px 0;
  }
  .prompt-benefits > div {
    padding-top: 16px;
    border-top: 2px solid var(--line);
  }
  dt {
    font-weight: 600;
    margin-bottom: 10px;
  }
  dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .prompt-limits {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .prompt-art {
    padding: 24px 0 36px;
    background: none;
    border-bottom: 1px solid var(--line);
    max-width: none;
  }
  .prompt-flow {
    grid-template-columns: 1fr 1fr;
  }
  .prompt-flow > li,
  .prompt-flow > li:last-child {
    background: transparent;
    color: var(--ink);
    border: 0;
    border-radius: 0;
    border-left: 2px solid var(--line);
    padding: 8px 20px;
  }
  .flow-steps {
    font-size: 0.9rem;
  }
  @media (max-width: 760px) {
    .prompt-benefits {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  @media (max-width: 440px) {
    .prompt-flow {
      grid-template-columns: 1fr;
    }
  }
</style>
