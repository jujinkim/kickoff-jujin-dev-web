---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { helpText } from "../../lib/help";
import { languages, strings, categories, categoryNames } from "../../lib/i18n";
import { ancestors } from "../../lib/catalog";
import { listed } from "../../lib/content";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
const h = helpText[lang];
const all = await listed();
const concepts = all.filter(
  (a) => a.data.lang === lang && a.data.kind === "concept",
);
const articles = all.filter(
  (a) => a.data.lang === lang && a.data.kind === "guide",
);
const recommended = ["srs", "architecture", "layout"].map((id) =>
  articles.find((a) => a.data.articleId === id)!,
);
---

<Base lang={lang} title={t.hero} description={t.siteDescription}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span></span>
        {t.eyebrow}
      </p>
      <h1>{t.hero}</h1>
      <p class="hero-description">{t.intro}</p>
      <div class="hero-actions">
        <a class="button primary" href={`/${lang}/start/`}>
          {t.createPrompt} <span>↗</span>
        </a>
        <a class="text-link" href={`/${lang}/help/`}>
          {t.help} →
        </a>
      </div>
      <p class="hero-handoff">{t.siteNotice}</p>
    </div>
    <figure class="hero-art prompt-art" aria-labelledby="prompt-flow-title">
      <figcaption id="prompt-flow-title">{h.flowTitle}</figcaption>
      <ol class="prompt-flow" role="list">
        {h.flow.map((group) => (
          <li>
            <strong class="flow-place">{group.place}</strong>
            <ol class="flow-steps" role="list">
              {group.steps.map((step, i) => (
                <li>
                  <span aria-hidden="true">{i === 0 ? "→" : "↓"}</span>
                  {step}
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    </figure>
  </section>
  <section class="category-section" data-home-section="catalog">
    <div class="section-heading">
      <h2>{t.catalog}</h2>
      <span class="tiny-label">
        THE INDEX / 01—{categories.length.toString().padStart(2, "0")}
      </span>
    </div>
    <p class="section-intro">{t.catalogIntro}</p>
    <div class="category-grid">
      {categories.map((category, i) => (
        <a href={`/${lang}/catalog/categories/${category}/`}>
          <span class="category-number">0{i + 1}</span>
          <strong>{categoryNames[lang][category]}</strong>
          <span>
            {concepts
              .filter((a) =>
                ancestors(a.data.category).some((c) => c.id === category),
              )
              .length.toString()
              .padStart(2, "0")}{" "}
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="section" data-home-section="planning">
    <div class="section-heading">
      <div>
        <h2>{t.guides}</h2>
      </div>
      <a class="text-link" href={`/${lang}/guides/`}>
        {t.guides} →
      </a>
    </div>
    <p class="section-intro">{t.guidesIntro}</p>
    <div class="catalog-grid home-grid">
      {recommended.map((article, index) => (
        <Card article={article} index={index} />
      ))}
    </div>
  </section>
</Base>
