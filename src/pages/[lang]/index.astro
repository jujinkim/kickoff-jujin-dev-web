---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import Example from "../../components/Example.astro";
import { languages, strings, categories, categoryNames } from "../../lib/i18n";
import { ancestors } from "../../lib/catalog";
import { listed } from "../../lib/content";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
const all = await listed();
const concepts = all.filter(
  (a) => a.data.lang === lang && a.data.kind === "concept",
);
const articles = all.filter(
  (a) => a.data.lang === lang && a.data.kind === "guide",
);
const recommended = ["srs", "architecture", "layout"].map((id) =>
  articles.find((a) => a.data.articleId === id)!,
);
const recent = [...articles]
  .sort(
    (a, b) =>
      b.data.updated.localeCompare(a.data.updated) ||
      a.data.articleId.localeCompare(b.data.articleId),
  )
  .slice(0, 3);
---

<Base lang={lang} title={t.eyebrow} description={t.intro}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span></span>
        {t.eyebrow}
      </p>
      <h1>{t.hero}</h1>
      <p class="hero-description">{t.intro}</p>
      <div class="hero-actions">
        <a class="button primary" href={`/${lang}/catalog/`}>
          {t.browse} <span>↗</span>
        </a>
        <a class="text-link" href={`/${lang}/guides/`}>
          {t.guides} →
        </a>
      </div>
      <p class="hero-note">
        {articles.length} {t.guides} <span> / </span> EN · KO · JA{" "}
        <span> / </span> Human + AI
      </p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-caption">FIELD NOTE / 009</div>
      <div class="art-window">
        <div class="window-bar">
          <i></i>
          <i></i>
          <i></i>
          <span>anatomy of a good idea</span>
        </div>
        <Example kind="layout" lang={lang} />
      </div>
      <div class="floating-note">
        <span>01 → 02 → 03</span>
        <strong>
          {lang === "ko"
            ? "상상 → 비교 → 결정"
            : lang === "ja"
              ? "想像 → 比較 → 決定"
              : "Imagine. Compare. Decide."}
        </strong>
        <small>
          {lang === "ko"
            ? "그 다음에 프롬프트."
            : lang === "ja"
              ? "プロンプトは、その後。"
              : "The prompt comes next."}
        </small>
      </div>
      <span class="art-star">✳</span>
    </div>
  </section>
  <section class="category-section">
    <div class="section-heading">
      <h2>{t.categories}</h2>
      <span class="tiny-label">
        THE INDEX / 01—{categories.length.toString().padStart(2, "0")}
      </span>
    </div>
    <div class="category-grid">
      {categories.map((category, i) => (
        <a href={`/${lang}/catalog/categories/${category}/`}>
          <span class="category-number">0{i + 1}</span>
          <strong>{categoryNames[lang][category]}</strong>
          <span>
            {concepts
              .filter((a) =>
                ancestors(a.data.category).some((c) => c.id === category),
              )
              .length.toString()
              .padStart(2, "0")}{" "}
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LESS GUESSING, MORE BUILDING</p>
        <h2>{t.guides}</h2>
      </div>
      <a class="text-link" href={`/${lang}/start/`}>
        {t.start} →
      </a>
    </div>
    <div class="catalog-grid home-grid">
      {recommended.map((article, index) => (
        <Card article={article} index={index} />
      ))}
    </div>
  </section>
  <section class="ai-banner">
    <span class="ai-mark">[ ai ]</span>
    <div>
      <h2>{t.aiIntro}</h2>
      <p>{t.aiWarning}</p>
    </div>
    <a class="button" href={`/${lang}/ai/`}>
      {t.ai} ↗
    </a>
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>{t.recent}</h2>
      <a class="text-link" href={`/${lang}/guides/`}>
        {t.guides} →
      </a>
    </div>
    <div class="recent-list">
      {recent.map((a) => (
        <a href={`/${lang}/guides/${a.data.articleId}/`}>
          <span class="tiny-label">{categoryNames[lang][a.data.category]}</span>
          <strong>{a.data.title}</strong>
          <time>{a.data.updated}</time>
          <span>↗</span>
        </a>
      ))}
    </div>
  </section>
</Base>
