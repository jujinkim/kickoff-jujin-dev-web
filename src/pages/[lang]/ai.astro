---
import StartupPrompt from "../../components/StartupPrompt.astro";
import Base from "../../layouts/Base.astro";
import { languages, strings } from "../../lib/i18n";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
const steps = {
  en: [
    [
      "Paste into project instructions",
      "Paste the block below into your external AI tool. It requests the startup guidelines and behavior rules, the only two required site documents.",
    ],
    [
      "Describe the result and constraints",
      "Describe a goal such as keeping each saved link once. AI derives decisions from your requirements, including options outside this site. Read catalog articles when requested or helpful. Write in your preferred language; technical names are optional.",
    ],
    [
      "Compare, decide, then build",
      "Try: ‘I want a bookshop cart. Ask about every undecided behavior and produce acceptance criteria.’ A strong recommendation still needs your decision.",
    ],
    [
      "Let AI handle the implementation",
      "AI chooses internal data structures and document formats within agreed requirements. You can also delegate a project decision explicitly. Missing product rules or changed cost and operating constraints still need your decision.",
    ],
  ],
  ko: [
    [
      "프로젝트 지침에 붙여넣기",
      "아래 문구를 사용하는 외부 AI 도구에 붙여넣으세요. 필수 사이트 문서인 개발 시작 지침과 AI 행동 지침 두 개를 읽도록 요청합니다.",
    ],
    [
      "원하는 결과와 제약 설명하기",
      "‘저장한 링크는 중복 없이 하나씩’처럼 원하는 결과를 설명하세요. AI는 요구사항에서 필요한 결정을 도출하고 사이트 밖 선택지도 검토합니다. 카탈로그 글은 요청하거나 도움 될 때 참고하세요. 편한 언어로 작성하고 기술 이름은 몰라도 됩니다.",
    ],
    [
      "비교하고 결정한 뒤 만들기",
      "예: ‘서점 장바구니를 만들고 싶어. 미결정 동작을 전부 질문하고 완료 조건을 작성해줘.’ 추천이 강해도 결정은 필요합니다.",
    ],
    [
      "내부 구현은 AI에게 맡기기",
      "AI는 합의된 요구 안에서 자료구조와 문서 형식을 스스로 정합니다. 프로젝트의 선택도 명시적으로 범위를 정해 위임할 수 있습니다. 제품 규칙이 빠졌거나 비용·운영 제약이 바뀌면 사용자에게 확인합니다.",
    ],
  ],
  ja: [
    [
      "プロジェクトの指示に貼り付ける",
      "下の文章をお使いの外部AIツールに貼り付けます。必須のサイト文書である開始ガイドラインとAI行動規則の二つを読むよう依頼します。",
    ],
    [
      "望む結果と制約を説明する",
      "「保存したリンクは重複なく一つずつ」のように結果を説明します。AIは要件から必要な判断を導き、サイト外の選択肢も検討します。カタログ記事は依頼時や役立つ場合に参照します。使いやすい言語で書き、技術名は知らなくても構いません。",
    ],
    [
      "比較し、決定してから作る",
      "例：「書店のカートを作りたい。未決定の動作をすべて質問して、受け入れ条件を作って」。強い推薦にも決定が必要です。",
    ],
    [
      "内部実装をAIに任せる",
      "AIは合意した要件内でデータ構造と文書形式を自分で選びます。全体の判断も明示的に範囲を定めて委任できます。製品規則が不明な場合や費用・運用制約が変わる場合は確認します。",
    ],
  ],
}[lang];
---

<Base lang={lang} title={t.ai} description={t.aiIntro}>
  <section class="page-heading">
    <p class="eyebrow">START WITH YOUR PROJECT</p>
    <h1>{t.ai}</h1>
    <p>{t.aiIntro}</p>
  </section>
  <div class="guide-content">
    <p>
      <a href={`/${lang}/start/`}>{t.createPrompt} →</a>
    </p>
    <StartupPrompt lang={lang} promptId="project-prompt" />
    <p class="notice">{t.aiWarning}</p>
    <div class="steps">
      {steps.map(([title, body]) => (
        <section class="step">
          <div>
            <h2>{title}</h2>
            <p>{body}</p>
          </div>
        </section>
      ))}
    </div>
    <h2>
      {
        {
          en: "Optional references",
          ko: "선택 참고자료",
          ja: "任意の参考資料",
        }[lang]
      }
    </h2>
    <div class="resource-links">
      <a class="button" href="/llms.txt">
        llms.txt ↗
      </a>
      <a class="button" href="/ai/catalog.json">
        catalog.json ↗
      </a>
    </div>
  </div>
</Base>
