---
import { startupText } from "../../lib/startup";
import StartupPrompt from "../../components/StartupPrompt.astro";
import Base from "../../layouts/Base.astro";
import { languages, strings } from "../../lib/i18n";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
const steps = {
  en: [
    [
      "Describe the result",
      "Say who needs what and in which situation. For a bookshop cart, explain what should happen after duplicate additions or a payment failure. AI asks about missing behavior.",
      "srs",
    ],
    [
      "Point to examples",
      "Show a layout or style you like and explain what matters. AI proposes screen structure, interaction and success/failure states; you do not need to draw every screen.",
      "layout",
    ],
    [
      "Agree on structure and cost",
      "Compare module roles, dependencies and maintenance costs against your constraints. Confirm the project direction or delegate a named decision. AI records the reasons.",
      "architecture",
    ],
    [
      "Let AI write the plan",
      "AI turns the conversation into requirements, acceptance criteria, decision records and tasks. Review the plan, then request development. Internal implementation details follow the agreed boundaries.",
      "ai",
    ],
  ],
  ko: [
    [
      "원하는 결과 설명하기",
      "누가 어떤 상황에서 무엇을 원하는지 말하세요. 서점 장바구니라면 중복 추가나 결제 실패 시 원하는 동작을 설명합니다. 빠진 동작은 AI가 질문합니다.",
      "srs",
    ],
    [
      "마음에 드는 예시 가리키기",
      "원하는 레이아웃이나 스타일을 보여주고 중요한 점을 설명하세요. AI가 화면 구성·상호작용·성공과 실패 상태를 제안합니다. 모든 화면을 직접 그릴 필요는 없습니다.",
      "layout",
    ],
    [
      "구조와 비용 합의하기",
      "모듈의 역할, 의존 관계, 유지 비용을 제약과 함께 비교하세요. 프로젝트 방향을 확인하거나 특정 선택을 위임합니다. AI가 선택 이유를 기록합니다.",
      "architecture",
    ],
    [
      "AI와 기획 구체화하기",
      "AI가 대화를 요구사항·완료 조건·결정 기록·작업으로 정리합니다. 기획을 검토한 뒤 개발을 요청하세요. 내부 구현은 합의된 경계에 맞춰 AI가 구체화합니다.",
      "ai",
    ],
  ],
  ja: [
    [
      "望む結果を説明する",
      "誰がどんな状況で何を必要とするか説明します。書店のカートなら重複追加や決済失敗時の動作を伝えます。不明な動作はAIが質問します。",
      "srs",
    ],
    [
      "好みの実例を示す",
      "望むレイアウトやスタイルを示し、重視する点を説明します。AIが画面構成・操作・成功と失敗の状態を提案します。すべての画面を自分で描く必要はありません。",
      "layout",
    ],
    [
      "構成と費用を合意する",
      "モジュールの役割、依存関係、保守費用を制約と比較します。全体の方向を確認するか、特定の判断を委任します。AIが理由を記録します。",
      "architecture",
    ],
    [
      "AIと計画を具体化する",
      "AIが対話を要件・完了条件・判断記録・タスクにまとめます。計画を確認してから開発を依頼します。内部実装はAIが合意した境界に合わせて具体化します。",
      "ai",
    ],
  ],
}[lang];
---

<Base lang={lang} title={t.start} description={t.startIntro}>
  <section class="page-heading">
    <p class="eyebrow">START WITH THE OUTCOME</p>
    <h1>{t.start}</h1>
    <p>{t.startIntro}</p>
  </section>
  <div class="guide-content">
    <StartupPrompt lang={lang} />
    <section>
      <h2>{startupText[lang].versions}</h2>
      <p>
        <a href={`/${lang}/start/v1/`}>{startupText[lang].history}</a>
      </p>
    </section>
    <div class="steps">
      {steps.map(([title, body, id]) => (
        <section class="step">
          <div>
            <h2>{title}</h2>
            <p>{body}</p>
            <p>
              <a
                class="text-link"
                href={id === "ai" ? `/${lang}/ai/` : `/${lang}/guides/${id}/`}
              >
                {t.next} →
              </a>
            </p>
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>
