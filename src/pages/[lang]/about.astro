---
import Base from "../../layouts/Base.astro";
import { languages, strings, siteName } from "../../lib/i18n";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const t = strings[lang];
---

<Base lang={lang} title={t.about} description={t.aboutIntro}>
  <section class="page-heading">
    <p class="eyebrow">A SMALL GUIDE TO BETTER QUESTIONS</p>
    <h1>
      {siteName}
      <span class="accent-dot">●</span>
    </h1>
    <p>{t.aboutIntro}</p>
    <p class="site-notice">{t.siteNotice}</p>
  </section>
  <div class="guide-content prose">
    {t.aboutParagraphs.map((p) => (
      <p>{p}</p>
    ))}
    <div class="resource-links">
      <a class="button primary" href={`/${lang}/start/`}>
        {t.createPrompt} →
      </a>
      <a class="button" href={`/${lang}/help/`}>
        {t.help} →
      </a>
      <a
        class="button"
        href="https://github.com/jujinkim/kickoff-jujin-dev-web/blob/main/CONTRIBUTING.md"
      >
        {t.contribute} ↗
      </a>
    </div>
  </div>
</Base>
