---
import type { Article } from "../lib/content";
import { articleUrl } from "../lib/content";
import { strings } from "../lib/i18n";
import { ancestors } from "../lib/catalog";
import Example from "./Example.astro";
import { isDesignId, designDemos } from "../lib/design-demos";
interface Props {
  article: Article;
  index?: number;
}
const { article, index = 0 } = Astro.props;
const d = article.data;
const categoryPath = ancestors(d.category);
---

<article
  class="catalog-card"
  data-category={d.category}
  data-category-path={categoryPath.map((c) => c.id).join(" ")}
>
  <a class="card-link" href={articleUrl(article)}>
    {isDesignId(d.articleId) && (
      <>
        <div class="card-preview">
          <img
            class="style-preview-image"
            src={`/thumbnails/${d.articleId}-${d.lang}.png`}
            alt={designDemos[d.articleId].caption[d.lang]}
            width="360"
            height="280"
            loading="lazy"
          />
        </div>
      </>
    )}
    {d.example && (
      <>
        <div class="card-preview">
          <Example kind={d.example} lang={d.lang} />
        </div>
      </>
    )}
    <div class="card-text">
      <div class="card-meta">
        <span class="card-category">
          {categoryPath.map((c) => c.names[d.lang]).join(" / ")}
        </span>
        <span>{String(index + 1).padStart(2, "0")}</span>
      </div>
      <h3>{d.title}</h3>
      <p>{d.summary}</p>
      <span class="read-link">
        {strings[d.lang].read} <span aria-hidden="true">↗</span>
      </span>
    </div>
  </a>
</article>

<style>
  .style-preview-image {
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: contain;
    display: block;
    background: #fffefb;
  }
</style>
