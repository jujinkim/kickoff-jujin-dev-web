---
import Card from "./Card.astro";
import { strings, categoryNames, type Lang } from "../lib/i18n";
import { taxonomy, ancestors, childrenOf } from "../lib/catalog";
import { listed } from "../lib/content";
interface Props {
  lang: Lang;
  kind: "guide" | "concept";
  categoryId?: string;
}
const { lang, kind, categoryId } = Astro.props;
const t = strings[lang];
const articles = (await listed()).filter(
  (a) =>
    a.data.lang === lang &&
    a.data.kind === kind &&
    (!categoryId ||
      ancestors(a.data.category).some((c) => c.id === categoryId)),
);
const orderedCategories = (parent: string | null): typeof taxonomy =>
  childrenOf(parent).flatMap((c) => [c, ...orderedCategories(c.id)]);
const allCategories = orderedCategories(null);
const categories = allCategories.filter(
  (c) =>
    (kind === "concept" || !c.parent) &&
    (!categoryId || ancestors(c.id).some((node) => node.id === categoryId)),
);
const scope = categoryId
  ? categoryNames[lang][categoryId]
  : kind === "guide"
    ? t.guides
    : t.catalog;
const parent = categoryId ? ancestors(categoryId).at(-2) : undefined;
const broaderUrl = parent
  ? `/${lang}/catalog/categories/${parent.id}/`
  : `/${lang}/catalog/`;
const otherUrl = `/${lang}/${kind === "guide" ? "catalog" : "guides"}/`;
const otherLabel = kind === "guide" ? t.catalog : t.guides;
const groupId = (category: string) => {
  const path = ancestors(category);
  return (path[1] ?? path[0]).id;
};
const groups =
  kind === "concept"
    ? allCategories.filter((c) =>
        articles.some((a) => groupId(a.data.category) === c.id),
      )
    : [];
---

<section
  class="catalog-section"
  id="catalog"
  data-kind={kind}
  data-empty={t.empty}
  data-error={t.searchError}
  data-results={t.results}
  data-scope={scope}
>
  <div class="catalog-toolbar">
    <div class="search-field">
      <label for="search">{t.search}</label>
      <input
        id="search"
        type="search"
        placeholder={t.searchHint}
        autocomplete="off"
        aria-describedby="search-scope"
      />
    </div>
    <div class="view-switch" role="group" aria-label={t.views}>
      {["card", "list"].map((view) => (
        <button data-view={view} aria-pressed={view === "card"}>
          {t[view === "card" ? "thumbnail" : "list"]}
        </button>
      ))}
    </div>
  </div>
  <p id="search-scope">
    {t.searchScope}: <strong data-search-scope>{scope}</strong>
  </p>
  <div class="filter-row">
    <label class="sr-only" for="category">
      {t.all}
    </label>
    <select id="category">
      <option value="">{t.all}</option>
      {categories.map((c) => (
        <option value={c.id}>
          {ancestors(c.id)
            .map((node) => categoryNames[lang][node.id])
            .join(" / ")}
        </option>
      ))}
    </select>
    <p id="result-status" role="status" aria-live="polite">
      {articles.length} {t.count}
    </p>
  </div>
  <div data-search-recovery hidden>
    <div class="resource-links">
      <button type="button" class="button" data-search-reset>
        {t.searchReset}
      </button>
      {categoryId && (
        <a class="button" href={broaderUrl}>
          {t.searchBroader} →
        </a>
      )}
      <a class="button" href={otherUrl}>
        {t.searchOther}: {otherLabel} →
      </a>
    </div>
  </div>
  <div id="search-results" class="search-results" hidden></div>
  <div id="catalog-grid" class:list={{ "catalog-grid": kind === "guide" }}>
    {kind === "guide"
      ? articles.map((article, index) => (
          <Card article={article} index={index} />
        ))
      : groups.map((group) => (
          <section
            class="catalog-group"
            data-catalog-group={group.id}
            aria-labelledby={`group-${group.id}`}
          >
            <h2 id={`group-${group.id}`} class="catalog-group-title">
              {group.names[lang]}
            </h2>
            <div class="catalog-grid">
              {articles
                .filter(
                  (article) => groupId(article.data.category) === group.id,
                )
                .map((article) => (
                  <Card article={article} index={articles.indexOf(article)} />
                ))}
            </div>
          </section>
        ))}
  </div>
</section>
<script is:inline type="module" src="/catalog.js"></script>
