---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const booths = [
  {
    kind: "bike",
    name: t("Bicycle checks", "자전거 점검", "自転車の点検"),
    place: t("Courtyard", "마당", "中庭"),
    time: "10:00–12:00",
  },
  {
    kind: "cloth",
    name: t("Clothes mending", "옷 수선", "服の修繕"),
    place: t("Hall", "강당", "ホール"),
    time: "11:00–13:00",
  },
  {
    kind: "bike",
    name: t("Puncture workshop", "펑크 수리 체험", "パンク修理体験"),
    place: t("Courtyard", "마당", "中庭"),
    time: "13:00–14:00",
  },
];
---

<section
  class="demo"
  data-demo="brutalism"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>
      {t(
        "NEIGHBORHOOD NOTICE / SATURDAY",
        "동네 소식 / 토요일",
        "まちの掲示 / 土曜日",
      )}
    </small>
    <h2>
      {t("Repair. Reuse. Repeat.", "고치고, 다시 쓰고.", "直して、また使う。")}
    </h2>
    <p>
      {t(
        "Bring one item. Meet a volunteer. Learn a repair.",
        "물건 하나를 가져와 자원봉사자와 수리해 보세요.",
        "品物を一つ持って、ボランティアと修理を学びましょう。",
      )}
    </p>
  </header>
  <div class="controls">
    <label>
      {t("Repair type", "수리 종류", "修理の種類")}
      <select data-filter data-interactive disabled>
        <option value="all">
          {t("All booths", "전체 부스", "すべてのブース")}
        </option>
        <option value="bike">{t("Bicycles", "자전거", "自転車")}</option>
        <option value="cloth">{t("Clothes", "의류", "衣類")}</option>
        <option value="electrical">
          {t("Electrical appliances", "전기제품", "電気製品")}
        </option>
      </select>
    </label>
  </div>
  <ol>
    {booths.map((b) => (
      <li data-booth data-kind={b.kind}>
        <h3>{b.name}</h3>
        <p>
          <strong>{b.time}</strong> · {b.place}
        </p>
      </li>
    ))}
  </ol>
  <p data-empty hidden>
    {t(
      "No electrical repair booth this time. Ask at the entrance for another event.",
      "이번 행사에는 전기제품 수리 부스가 없습니다. 입구에서 다음 행사를 문의하세요.",
      "今回は電気製品の修理ブースはありません。入口で次の催しを確認できます。",
    )}
  </p>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("brutalism", (root, say) => {
    const filter = root.querySelector<HTMLSelectElement>("[data-filter]")!;
    const rows = [...root.querySelectorAll<HTMLElement>("[data-booth]")];
    const update = () => {
      let n = 0;
      rows.forEach((r) => {
        r.hidden = filter.value !== "all" && r.dataset.kind !== filter.value;
        if (!r.hidden) n++;
      });
      root.querySelector<HTMLElement>("[data-empty]")!.hidden = n > 0;
      say(`${filter.selectedOptions[0].text}: ${n}`);
    };
    filter.addEventListener("change", update);
    return () => {
      filter.value = "all";
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #fff;
    color: #111;
    border: 3px solid;
    font-family: monospace;
  }
  header {
    border-block: 6px solid;
    padding: 24px 0;
  }
  h2 {
    text-transform: uppercase;
    letter-spacing: -0.055em;
    font-size: clamp(2rem, 7cqi, 4.6rem);
    margin-top: 16px;
  }
  ol {
    padding-left: 26px;
  }
  li {
    border-top: 2px solid;
    padding: 18px 0;
  }
  li p {
    margin: 0;
  }
  button {
    background: #111;
    color: #fff;
    border: 2px solid #111;
    border-radius: 0;
  }
  select {
    border: 2px solid;
    border-radius: 0;
  }
  footer {
    border-top: 4px solid;
    padding-top: 20px;
  }

  .demo {
    border: 5px solid #111;
  }
  header {
    border-block-width: 12px;
  }
  h2 {
    font-size: clamp(2.4rem, 10cqi, 6.5rem);
    line-height: 0.98;
    font-weight: 900;
  }
  li {
    border-top-width: 4px;
    padding-block: 28px;
  }
  li h3 {
    font-size: clamp(1.25rem, 3.5cqi, 2rem);
    text-transform: uppercase;
  }
  button,
  select {
    border-radius: 0;
    box-shadow: none;
  }
</style>
