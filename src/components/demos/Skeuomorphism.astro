---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
import "./comparison-base.css";
---

<section
  class="demo"
  data-comparison="tasks"
  data-demo="skeuomorphism"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <header>
    <span>✓</span>
    <div>
      <small>
        {t("PROJECT / TODAY", "프로젝트 / 오늘", "プロジェクト / 今日")}
      </small>
      <h2>{t("Make room", "공간 만들기", "余白をつくる")}</h2>
    </div>
  </header>
  <div class="controls">
    <label>
      {t("Status", "상태", "状態")}
      <select data-filter data-interactive disabled>
        <option value="all">{t("All", "전체", "すべて")}</option>
        <option value="open">{t("Open", "진행 중", "未完了")}</option>
        <option value="done">{t("Done", "완료", "完了")}</option>
      </select>
    </label>
    <strong data-count>0 / 3</strong>
  </div>
  <ul>
    {[
      t("Gather references", "참고 자료 모으기", "参考資料を集める"),
      t("Draw the first draft", "첫 초안 그리기", "最初の案を描く"),
      t("Review labels", "라벨 검토하기", "ラベルを確認する"),
    ].map((text, i) => (
      <li data-task>
        <label>
          <input type="checkbox" data-check data-interactive disabled />
          <span>{text}</span>
        </label>
        <small>0{i + 1}</small>
      </li>
    ))}
  </ul>
  <p data-empty hidden>
    {t(
      "No tasks in this state.",
      "해당 상태의 작업이 없습니다.",
      "この状態のタスクはありません。",
    )}
  </p>

  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountTasks } from "./tasks";
  mountTasks("skeuomorphism");
</script>
<style>
  .demo {
    background: #f1f5f9;
    color: #17304e;
  }
  header {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 22px;
  }
  header > span {
    font-size: 3rem;
  }
  h2 {
    font-size: 2rem;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 20px 12px;
    border-bottom: 1px solid;
  }
  li:has(:checked) span {
    text-decoration: line-through;
  }
  .controls {
    justify-content: space-between;
  }
  .demo {
    background: repeating-linear-gradient(0deg, #704932 0 3px, #79513a 3px 7px);
    color: #493324;
    border: 5px solid #583a28;
    border-radius: 8px;
    box-shadow: inset 0 0 15px #362215;
  }
  header {
    background: #ad7050;
    color: #fff8e8;
    border: 2px dashed #efc7a2;
    border-radius: 5px;
  }
  ul {
    position: relative;
    background: repeating-linear-gradient(#fff8e6 0 31px, #c8d2cf 31px 32px);
    padding: 16px 20px 16px 32px;
    box-shadow:
      3px 4px #e3d8bd,
      6px 7px #c2ac8f;
  }
  ul::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 20px;
    border-left: 2px solid #ce9691;
  }
  li {
    border: 0;
    min-height: 96px;
    font-family: Georgia, serif;
  }
  .controls,
  [role="status"] {
    color: #fff8e8;
  }
  button {
    background: linear-gradient(#f8e6c5, #d5b994);
    border: 1px solid #392a1b;
    border-radius: 5px;
    color: #493324;
    box-shadow: 0 3px 2px #38251d;
  }
  input {
    accent-color: #79513a;
  }
</style>
