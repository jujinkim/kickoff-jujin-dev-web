---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { photo } from "./photos";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const recipes = [
  {
    name: t("Tomato pasta", "토마토 파스타", "トマトパスタ"),
    ingredients: [
      [t("Pasta", "파스타", "パスタ"), 100, "g"],
      [t("Tomatoes", "토마토", "トマト"), 150, "g"],
      [t("Olive oil", "올리브유", "オリーブ油"), 10, "ml"],
    ],
    note: t(
      "Simmer the tomatoes, then toss with cooked pasta.",
      "토마토를 끓인 뒤 익힌 파스타와 버무립니다.",
      "トマトを煮て、ゆでたパスタと和えます。",
    ),
  },
  {
    name: t("Tomato salad", "토마토 샐러드", "トマトサラダ"),
    ingredients: [
      [t("Tomatoes", "토마토", "トマト"), 200, "g"],
      [t("Mozzarella", "모차렐라", "モッツァレラ"), 80, "g"],
      [t("Olive oil", "올리브유", "オリーブ油"), 5, "ml"],
    ],
    note: t(
      "Slice the tomatoes and cheese, then add the oil.",
      "토마토와 치즈를 썰고 기름을 더합니다.",
      "トマトとチーズを切り、オイルを加えます。",
    ),
  },
];
---

<section
  class="demo"
  data-demo="skeuomorphism"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <div class="notebook">
    <header>
      <small>{t("FROM THE KITCHEN", "부엌에서", "台所より")}</small>
      <h2>{t("Recipe notebook", "요리 수첩", "料理ノート")}</h2>
    </header>
    <nav aria-label={t("Recipes", "요리", "料理")}>
      {recipes.map((r, i) => (
        <button
          type="button"
          data-recipe={i}
          aria-pressed={i === 0}
          data-interactive
          disabled
        >
          {r.name}
        </button>
      ))}
    </nav>
    <div class="spread">
      <img
        {...photo("tomato-pasta.png")}
        width="1536"
        height="1024"
        alt={t(
          "A bowl of tomato pasta",
          "토마토 파스타 한 그릇",
          "トマトパスタの一皿",
        )}
      />
      <div>
        <label>
          {t("Servings", "인분", "人数")}
          <select data-servings data-interactive disabled>
            {[1, 2, 4].map((n) => (
              <option value={n} selected={n === 2}>
                {n}
              </option>
            ))}
          </select>
        </label>
        {recipes.map((r, i) => (
          <section data-recipe-panel hidden={i !== 0}>
            <h3>{r.name}</h3>
            <ul>
              {r.ingredients.map(([name, amount, unit]) => (
                <li>
                  <span>{name}</span>
                  <strong>
                    <span data-amount={amount}>{Number(amount) * 2}</span>{" "}
                    {unit}
                  </strong>
                </li>
              ))}
            </ul>
            <p>{r.note}</p>
          </section>
        ))}
      </div>
    </div>
    <small>
      {t(
        "Illustrative quantities; adjust to taste.",
        "예시 분량이며 기호에 맞게 조절하세요.",
        "分量は例です。好みに合わせて調整してください。",
      )}
    </small>
  </div>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("skeuomorphism", (root, say) => {
    const select = root.querySelector<HTMLSelectElement>("[data-servings]")!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-recipe]")];
    const choose = (id: string) => {
      tabs.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.recipe === id)),
      );
      root
        .querySelectorAll<HTMLElement>("[data-recipe-panel]")
        .forEach((p, i) => (p.hidden = String(i) !== id));
      root.querySelector<HTMLImageElement>("img")!.hidden = id !== "0";
    };
    const update = () => {
      root
        .querySelectorAll<HTMLElement>("[data-amount]")
        .forEach(
          (e) =>
            (e.textContent = String(
              Number(e.dataset.amount) * Number(select.value),
            )),
        );
      say(
        `${select.parentElement!.textContent!.trim().split("\n")[0]} · ${select.value}`,
      );
    };
    tabs.forEach((b) =>
      b.addEventListener("click", () => {
        choose(b.dataset.recipe!);
        say(b.textContent!);
      }),
    );
    select.addEventListener("change", update);
    return () => {
      select.value = "2";
      choose("0");
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: repeating-linear-gradient(
      0deg,
      #755238 0 3px,
      #79563b 3px 40px
    );
    color: #3b2b1e;
    padding: 24px;
    border-radius: 12px;
  }
  .notebook {
    background: #fff9e9;
    border-radius: 4px 15px 15px 4px;
    padding: 28px 24px 28px 32px;
    border-left: 10px solid #734331;
    box-shadow:
      2px 4px 10px #261b1d66,
      inset 8px 0 10px #ad927333;
  }
  h2 {
    font-family: Georgia, serif;
    font-style: italic;
    margin-top: 12px;
  }
  nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  button {
    background: #f8e3b6;
    color: #3b2b1e;
    border: 1px solid #987a4e;
    border-radius: 5px;
  }
  button[aria-pressed="true"] {
    background: #734331;
    color: white;
  }
  .spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
  }
  img {
    width: 100%;
    height: auto;
    border: 6px solid white;
    box-shadow: 1px 3px 6px #34291b33;
    align-self: start;
  }
  label {
    margin-bottom: 22px;
  }
  ul {
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    border-bottom: 1px solid #cbbca2;
    padding: 14px 0;
  }
  li strong {
    white-space: nowrap;
  }
  footer {
    color: white;
  }
  footer button {
    background: #fff9e9;
  }
  @container (width<560px) {
    .spread {
      grid-template-columns: 1fr;
    }
    .notebook {
      padding: 20px 14px;
    }
    .demo {
      padding: 14px;
    }
  }

  .notebook {
    position: relative;
    border-left-width: 20px;
    padding-left: 42px;
    box-shadow:
      4px 5px #e6d7b5,
      8px 9px #c6b38b,
      12px 16px 24px #261b1d88,
      inset 14px 0 22px #ad927366;
  }
  .notebook::before {
    content: "";
    position: absolute;
    left: -12px;
    top: 24px;
    bottom: 24px;
    width: 28px;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 33px,
      #b1a99b 33px 37px,
      #fff 37px 40px,
      #736b5d 40px 43px,
      transparent 43px 66px
    );
  }
  h2 {
    font-size: clamp(2rem, 6cqi, 3.5rem);
  }
  .spread > div {
    background: repeating-linear-gradient(
      transparent 0 31px,
      #bcae8d33 31px 32px
    );
  }
  @container (width < 560px) {
    .notebook {
      border-left-width: 12px;
      padding-left: 24px;
    }
  }
</style>
