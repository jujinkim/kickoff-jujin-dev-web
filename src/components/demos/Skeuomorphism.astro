---
import type { Lang } from "../../lib/i18n";
import { workshop } from "./workshop";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const w = workshop(lang);
const prefix = "skeuomorphism-" + lang;
---

<section
  class="demo"
  data-comparison="tasks"
  data-demo="skeuomorphism"
  lang={lang}
  data-reset-message={w.resetMessage}
  data-completed-label={w.completed}
  data-progress-label={w.progress}
>
  <header>
    <div>
      <small>{w.identity} · 01</small>
      <h2>{w.project}</h2>
    </div>
    <span class="mark" aria-hidden="true">
      ✳
    </span>
  </header>
  <nav aria-label={w.menu}>
    {[
      ["overview", w.overview],
      ["tasks", w.tasksTitle],
      ["resources", w.resourcesTitle],
    ].map(([target, label]) => (
      <a href={`#${prefix}-${target}`} data-section-link>
        {label}
      </a>
    ))}
  </nav>
  <div class="book">
    <div class="workspace">
      <div class="work-main">
        <section
          class="intro"
          id={`${prefix}-overview`}
          tabindex="-1"
          aria-label={w.overview}
        >
          <h3>{w.goal}</h3>
          <p data-description>{w.description}</p>
        </section>
        <section id={`${prefix}-tasks`} tabindex="-1" aria-label={w.tasksTitle}>
          <h3>{w.tasksTitle}</h3>
          <div class="controls">
            <label>
              {w.status}
              <select data-filter data-interactive disabled>
                <option value="all">{w.all}</option>
                <option value="open">{w.open}</option>
                <option value="done">{w.done}</option>
              </select>
            </label>
          </div>
          <ul>
            {w.tasks.map((text, i) => (
              <li data-task>
                <label>
                  <input type="checkbox" data-check data-interactive disabled />
                  <span class="task-label">{text}</span>
                </label>
                <small aria-hidden="true">0{i + 1}</small>
              </li>
            ))}
          </ul>
          <p data-empty hidden>
            {w.empty}
          </p>
        </section>
      </div>
      <aside>
        <section class="progress-panel" aria-label={w.progress}>
          <h3>{w.progress}</h3>
          <div class="progress-values">
            <span>
              {w.completed} <strong data-count>0 / 3</strong>
            </span>
            <strong data-percent>0%</strong>
          </div>
          <progress data-progress value="0" max="3" aria-label={w.progress}>
            0 / 3
          </progress>
        </section>
        <section
          class="resources"
          id={`${prefix}-resources`}
          tabindex="-1"
          aria-label={w.resourcesTitle}
        >
          <h3>{w.resourcesTitle}</h3>
          {w.resources.map((resource) => (
            <details data-resource>
              <summary>
                {resource.title}
                <span>{w.note}</span>
              </summary>
              <p>{resource.note}</p>
            </details>
          ))}
        </section>
      </aside>
    </div>
  </div>
  <footer>
    <div class="footer-line">
      <small data-footer-summary>{w.summary}</small>
      <button class="reset" type="button" data-reset data-interactive disabled>
        {w.reset}
      </button>
    </div>
    <p role="status" aria-live="polite" aria-atomic="true">
      {w.initialMessage}
    </p>
  </footer>
</section>
<script>
  import { mountTasks } from "./tasks";
  mountTasks("skeuomorphism");
</script>
<style>
  /* Local control baseline. Astro scopes every selector to this component. */
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  :is(h2, h3, p) {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: 2rem;
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  :is(button, select, input, textarea) {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }

  :is(button, select, input:not([type="checkbox"]):not([type="range"])) {
    min-height: 44px;
    padding: 8px 12px;
  }
  :is(button, select) {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  :is(input, textarea, select) {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }

  [data-task] label {
    flex-wrap: nowrap;
    min-width: 0;
  }
  [data-task] input {
    flex: none;
  }
  [data-task] small {
    flex: none;
    white-space: nowrap;
  }

  .demo {
    container-type: inline-size;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
  }
  header .mark {
    font-size: 2.8rem;
    flex: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 24px;
  }
  nav a {
    color: inherit;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    text-decoration: none;
  }
  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 24px;
  }
  .work-main,
  aside {
    min-width: 0;
  }
  .intro {
    margin-bottom: 24px;
  }
  h2,
  h3 {
    font-family: inherit;
  }
  h3 {
    line-height: 1.3;
  }
  .controls {
    margin: 18px 0;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 12px;
  }
  li label {
    flex: 1;
    min-height: 44px;
    cursor: pointer;
  }
  li:has(:checked) .task-label {
    text-decoration: line-through;
  }
  .progress-panel {
    padding: 20px;
    margin-bottom: 24px;
  }
  .progress-values {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }
  progress {
    width: 100%;
    height: 12px;
    display: block;
  }
  details {
    margin-top: 12px;
    padding: 16px;
  }
  summary {
    cursor: pointer;
    min-height: 44px;
  }
  summary span {
    display: block;
    margin-top: 6px;
    font-size: 0.8rem;
  }
  details p {
    margin: 16px 0 0;
    line-height: 1.6;
  }
  footer {
    margin-top: 28px;
    padding-top: 20px;
  }
  footer .footer-line {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }
  footer .reset {
    margin: 0;
  }
  [data-empty] {
    padding: 20px 0;
  }
  @container (width < 600px) {
    .workspace {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .demo {
    background: repeating-linear-gradient(0deg, #704932 0 3px, #79513a 3px 7px);
    color: #493324;
    border: 5px solid #583a28;
    border-radius: 8px;
    box-shadow: inset 0 0 15px #362215;
  }
  header {
    background: #9a6143;
    color: #fff8e8;
    border: 2px dashed #efc7a2;
    padding: 22px;
    border-radius: 8px;
  }
  nav {
    margin: 20px 0;
  }
  nav a {
    background: #edcf91;
    border: 1px solid #805c35;
    border-radius: 4px 4px 0 0;
    box-shadow: 2px 3px 3px #24170d66;
  }
  .book {
    padding: 8px;
    background: #c59d68;
    border-radius: 4px;
    box-shadow: 0 8px 12px #281a14;
  }
  .workspace {
    gap: 2px;
  }
  .work-main,
  aside {
    background: repeating-linear-gradient(#fff6dc 0 31px, #d8cfb8 32px 33px);
    padding: 24px;
  }
  .work-main {
    border-right: 8px solid #dfc7a0;
  }
  aside {
    box-shadow: inset 5px 0 10px #68502933;
  }
  h2,
  h3 {
    font-family: Georgia, serif;
  }
  li {
    border-bottom: 1px solid #bdb094;
    padding-inline: 0;
  }
  .progress-panel {
    background: #f5e5bf;
    border: 1px solid #b69e70;
  }
  details {
    background: #ffeab0;
    box-shadow: 2px 3px 5px #654d3044;
  }
  footer {
    color: #fff7df;
  }
  button,
  select {
    color: #493324;
    border: 1px solid #8c663e;
    background: linear-gradient(#fff3d3, #ddc393);
    border-radius: 4px;
    box-shadow: 0 3px 0 #684728;
  }
  input,
  progress {
    accent-color: #785234;
  }
  @container (width < 600px) {
    .work-main {
      border-right: 0;
      border-bottom: 6px solid #dfc7a0;
    }
  }
</style>
