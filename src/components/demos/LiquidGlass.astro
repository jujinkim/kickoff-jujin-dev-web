---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { photo } from "./photos";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const photos = [
  {
    file: "beach-diary.png",
    name: t("Morning beach", "아침 해변", "朝の浜辺"),
    note: t(
      "Sea foam reaches the dune path.",
      "모래언덕 길 끝까지 밀려온 파도.",
      "砂丘の道へ届く波。",
    ),
  },
  {
    file: "harbor-diary.png",
    name: t("Evening harbor", "저녁 항구", "夕暮れの港"),
    note: t(
      "Boats return in the last warm light.",
      "마지막 햇살을 받으며 돌아온 배들.",
      "最後の光に照らされて戻った船。",
    ),
  },
  {
    file: "lake-walk.png",
    name: t("Quiet lake", "고요한 호수", "静かな湖"),
    note: t(
      "A pause on the way home.",
      "돌아오는 길의 잠깐의 쉼.",
      "帰り道のひと休み。",
    ),
  },
];
---

<section
  class="demo"
  data-demo="liquid-glass"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <svg class="filter-definitions" aria-hidden="true" width="0" height="0">
    <defs>
      <filter
        id={`liquid-lens-${lang}`}
        x="-15%"
        y="-30%"
        width="130%"
        height="160%"
        color-interpolation-filters="sRGB"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.008 0.025"
          numOctaves="1"
          seed="9"
          result="bend"
        />
        <feDisplacementMap
          in="SourceGraphic"
          in2="bend"
          scale="32"
          xChannelSelector="R"
          yChannelSelector="G"
        />
      </filter>
    </defs>
  </svg>
  <div class="photo-stage">
    {photos.map((p, i) => (
      <figure data-photo hidden={i !== 0}>
        <img
          {...photo(
            p.file,
            "(max-width: 640px) 100vw, 960px",
            i === 0 ? "eager" : "lazy",
          )}
          alt={p.name}
          width={i === 1 ? 1024 : 1536}
          height={i === 1 ? 1536 : 1024}
        />
        <figcaption>
          <strong>{p.name}</strong>
          <span>{p.note}</span>
        </figcaption>
      </figure>
    ))}
    <div class="float-layer" data-expanded="false">
      <div class="lens-surface" aria-hidden="true">
        <img
          {...photo(photos[0].file)}
          alt=""
          width="1536"
          height="1024"
          data-lens-image
          style={`filter: url(#liquid-lens-${lang})`}
        />
      </div>
      <div class="navigation">
        <button
          type="button"
          data-prev
          data-interactive
          disabled
          aria-label={t("Previous photo", "이전 사진", "前の写真")}
        >
          ←
        </button>
        <h2>
          {t("Coastal diary", "해변 일기", "海辺の日記")}{" "}
          <span data-position>1 / 3</span>
        </h2>
        <button
          type="button"
          data-next
          data-interactive
          disabled
          aria-label={t("Next photo", "다음 사진", "次の写真")}
        >
          →
        </button>
        <button
          type="button"
          data-tools-toggle
          aria-expanded="false"
          aria-controls={`liquid-tools-${lang}`}
          data-interactive
          disabled
        >
          {t("View tools", "도구 보기", "ツールを表示")}
        </button>
      </div>
      <div data-tools id={`liquid-tools-${lang}`} hidden>
        <label>
          <input type="checkbox" data-opaque data-interactive disabled />
          {t("Opaque panels", "불투명 패널", "不透明なパネル")}
        </label>
        <p>
          {t(
            "Use arrows to browse three photographs. Tools stay in the navigation layer.",
            "화살표로 사진 세 장을 둘러보세요. 도구는 탐색 영역에 머뭅니다.",
            "矢印で3枚の写真を見られます。ツールは操作レイヤーにまとまります。",
          )}
        </p>
      </div>
    </div>
  </div>
  <p class="intro">
    {t(
      "Lensing bends the photo under the floating controls. Open the tools to expand the capsule. This amplified web study is not Apple’s native rendering.",
      "떠 있는 조작부 아래 사진이 렌즈처럼 휘어 보입니다. 도구를 열면 캡슐이 펼쳐집니다. 특징을 강조한 웹 예제로, Apple의 네이티브 렌더링은 아닙니다.",
      "浮いた操作部の下で写真がレンズのように曲がります。ツールを開くとカプセルが広がります。特徴を強調したWebの例で、Appleのネイティブ描画ではありません。",
    )}
  </p>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("liquid-glass", (root, say) => {
    const photos = [...root.querySelectorAll<HTMLElement>("[data-photo]")];
    const tools = root.querySelector<HTMLElement>("[data-tools]")!;
    const toggle = root.querySelector<HTMLButtonElement>(
      "[data-tools-toggle]",
    )!;
    const opaque = root.querySelector<HTMLInputElement>("[data-opaque]")!;
    const surface = root.querySelector<HTMLElement>(".float-layer")!;
    const stage = root.querySelector<HTMLElement>(".photo-stage")!;
    const lens = root.querySelector<HTMLImageElement>("[data-lens-image]")!;
    let index = 0;
    const alignLens = () => {
      const area = stage.getBoundingClientRect();
      const box = surface.getBoundingClientRect();
      Object.assign(lens.style, {
        width: `${area.width}px`,
        height: `${area.height}px`,
        left: `${area.left - box.left}px`,
        top: `${area.top - box.top}px`,
      });
    };
    new ResizeObserver(alignLens).observe(surface);
    const syncLens = () => {
      const source = photos[index].querySelector<HTMLImageElement>("img")!;
      lens.srcset = source.srcset;
      lens.sizes = source.sizes;
      lens.src = source.src;
      alignLens();
    };
    syncLens();
    const update = () => {
      photos.forEach((p, i) => (p.hidden = i !== index));
      root.querySelector("[data-position]")!.textContent =
        `${index + 1} / ${photos.length}`;
      syncLens();
      say(
        photos[index]
          .querySelector<HTMLElement>("figcaption")!
          .innerText.replace(/\n+/g, " · "),
      );
    };
    root.querySelector("[data-next]")!.addEventListener("click", () => {
      index = (index + 1) % photos.length;
      update();
    });
    root.querySelector("[data-prev]")!.addEventListener("click", () => {
      index = (index + photos.length - 1) % photos.length;
      update();
    });
    toggle.addEventListener("click", () => {
      tools.hidden = !tools.hidden;
      toggle.setAttribute("aria-expanded", String(!tools.hidden));
      surface.dataset.expanded = String(!tools.hidden);
    });
    opaque.addEventListener(
      "change",
      () => (root.dataset.opaque = String(opaque.checked)),
    );
    return () => {
      index = 0;
      update();
      tools.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      surface.dataset.expanded = "false";
      opaque.checked = false;
      root.dataset.opaque = "false";
    };
  });
</script>
<style>
  .demo {
    container-type: inline-size;
    color-scheme: light;
    color: #102a32;
    background: #edf3f5;
    padding: 12px;
    border-radius: 36px;
    overflow-wrap: anywhere;
  }
  * {
    box-sizing: border-box;
  }
  [hidden] {
    display: none !important;
  }
  .filter-definitions {
    position: absolute;
    pointer-events: none;
  }
  .photo-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 680px;
    isolation: isolate;
    border-radius: 28px;
    overflow: hidden;
    padding: 24px;
  }
  figure {
    position: absolute;
    inset: 0;
    margin: 0;
    z-index: -1;
  }
  figure > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    position: absolute;
    top: 24px;
    left: 24px;
    right: 24px;
    color: #fff;
    background: #102a32ed;
    padding: 20px;
    border-radius: 4px;
  }
  figcaption strong {
    display: block;
    font-size: clamp(1.4rem, 4cqi, 2.4rem);
  }
  figcaption span {
    display: block;
    margin-top: 8px;
    line-height: 1.6;
  }
  .float-layer {
    position: relative;
    isolation: isolate;
    width: min(100%, 500px);
    align-self: center;
    border: 2px solid #ffffffdf;
    border-radius: 70px;
    padding: 22px;
    background: #ffffff38;
    backdrop-filter: blur(1px) saturate(1.3);
    box-shadow:
      inset 0 4px 3px #fff,
      inset 0 -5px 8px #143c5766,
      0 22px 38px #102a325e;
    transition:
      border-radius 260ms ease,
      width 260ms ease;
  }
  .float-layer::after {
    content: "";
    position: absolute;
    inset: 2px;
    border-radius: inherit;
    pointer-events: none;
    border-top: 2px solid #fff;
    border-bottom: 2px solid #ffffffa6;
    box-shadow:
      inset 5px 0 10px #fff9,
      inset -4px 0 8px #fff8;
  }
  .float-layer[data-expanded="true"] {
    width: min(100%, 650px);
    border-radius: 34px;
  }
  .lens-surface {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
  }
  .lens-surface img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-width: none;
    transform: scale(1.1);
    opacity: 0.9;
  }
  .navigation {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
    align-items: center;
    gap: 12px;
  }
  .navigation h2 {
    margin: 0;
    text-align: center;
    font-size: 1rem;
    line-height: 1.4;
    background: #f6fbffee;
    border-radius: 20px;
    padding: 12px 8px;
  }
  .navigation h2 span {
    display: block;
    font-size: 0.85rem;
    font-weight: 400;
  }
  button {
    min-height: 48px;
    min-width: 44px;
    padding: 10px 12px;
    font: inherit;
    font-weight: 700;
    color: #102a32;
    background: #f6fbfff2;
    border: 1px solid #385a69;
    border-radius: 30px;
    cursor: pointer;
  }
  [data-prev],
  [data-next] {
    aspect-ratio: 1;
    padding: 0;
    font-size: 1.4rem;
  }
  [data-tools-toggle] {
    grid-column: 1 / -1;
    justify-self: center;
    padding-inline: 24px;
  }
  [data-tools] {
    margin-top: 16px;
    padding: 20px;
    border-radius: 22px;
    background: #f6fbfff2;
  }
  [data-tools] label {
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1.5;
  }
  input {
    width: 22px;
    height: 22px;
    flex: none;
    accent-color: #183f50;
  }
  [data-tools] p {
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 16px 0 0;
  }
  .intro {
    margin: 20px 12px;
    font-size: 0.9rem;
    line-height: 1.7;
  }
  footer {
    padding: 0 12px 8px;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.9rem;
  }
  :focus-visible {
    outline: 3px dashed #102a32;
    outline-offset: 4px;
  }
  section[data-opaque="true"] .float-layer {
    background: #f3f9fb;
    backdrop-filter: none;
  }
  section[data-opaque="true"] .lens-surface {
    display: none;
  }
  @container (width < 450px) {
    .photo-stage {
      min-height: 620px;
      padding: 16px;
    }
    figcaption {
      top: 16px;
      left: 16px;
      right: 16px;
      padding: 16px;
    }
    .float-layer {
      padding: 18px 12px;
      border-radius: 42px;
    }
    .navigation {
      gap: 6px;
      grid-template-columns: 44px minmax(0, 1fr) 44px;
    }
    .navigation h2 {
      font-size: 0.85rem;
    }
    [data-tools] {
      padding: 14px;
    }
  }
  @supports not (backdrop-filter: blur(1px)) {
    .float-layer {
      background: #f3f9fb;
    }
    .lens-surface {
      display: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .float-layer {
      background: #f3f9fb;
      backdrop-filter: none;
    }
    .lens-surface {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }
  @media (forced-colors: active) {
    .float-layer,
    figcaption,
    button,
    .navigation h2,
    [data-tools] {
      background: Canvas;
      color: CanvasText;
      border: 1px solid CanvasText;
      backdrop-filter: none;
    }
    .lens-surface,
    .float-layer::after {
      display: none;
    }
    :focus-visible {
      outline-color: Highlight;
    }
  }
</style>
