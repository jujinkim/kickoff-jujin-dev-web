---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const essentials = [
  t("Water bottle", "물병", "水筒"),
  t("Warm layer", "보온 옷", "防寒着"),
  t("Route map", "경로 지도", "ルート地図"),
];
---

<section
  class="demo"
  data-demo="minimalism"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>{t("A DAY ON THE TRAIL", "하루 산행", "日帰りの山歩き")}</small>
    <h2>{t("Ready to leave.", "출발 준비.", "出発の準備。")}</h2>
    <p>
      {t(
        "Keep the essentials in sight.",
        "필수 준비물부터 확인하세요.",
        "必需品から確認しましょう。",
      )}
    </p>
  </header>
  <ul>
    {essentials.map((x) => (
      <li>
        <label>
          <input type="checkbox" data-pack data-interactive disabled />
          <span>{x}</span>
        </label>
      </li>
    ))}
  </ul>
  <p class="count">
    <strong data-count>0 / 3</strong>{" "}
    {t("essentials packed", "필수 준비물 완료", "必需品を準備済み")}
  </p>
  <details>
    <summary>
      {t("Optional comforts", "선택 준비물", "あると便利なもの")}
    </summary>
    <p>
      {t(
        "A sitting mat and a small camera. Check the weather and route before adding more.",
        "방석과 작은 카메라. 날씨와 경로를 확인한 뒤 더 챙기세요.",
        "座布団と小さなカメラ。天気とルートを確認してから追加しましょう。",
      )}
    </p>
  </details>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("minimalism", (root, say) => {
    const checks = [...root.querySelectorAll<HTMLInputElement>("[data-pack]")];
    const update = () => {
      const v = `${checks.filter((c) => c.checked).length} / 3`;
      root.querySelector("[data-count]")!.textContent = v;
      say(v);
    };
    checks.forEach((c) => c.addEventListener("change", update));
    return () => {
      checks.forEach((c) => (c.checked = false));
      root.querySelector("details")!.open = false;
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #fcfcf8;
    color: #273329;
    padding: clamp(24px, 6vw, 60px);
  }
  header {
    max-width: 520px;
    margin-bottom: 38px;
  }
  h2 {
    font-weight: 400;
    margin-top: 18px;
  }
  ul {
    padding: 0;
    list-style: none;
    margin: 0;
  }
  li {
    padding: 20px 0;
    border-bottom: 1px solid #879285;
  }
  li label {
    flex-wrap: nowrap;
    cursor: pointer;
  }
  input {
    accent-color: #344b38;
  }
  li:has(:checked) span {
    text-decoration: line-through;
  }
  .count {
    margin: 24px 0 36px;
  }
  details {
    border-top: 1px solid #879285;
    padding-top: 20px;
  }
  summary {
    min-height: 44px;
  }
  details p {
    margin-top: 18px;
  }
  button {
    border: 0;
    text-decoration: underline;
    text-underline-offset: 5px;
    padding-left: 0;
  }

  .demo {
    padding: clamp(28px, 7vw, 84px);
  }
  header,
  ul,
  .count,
  details,
  footer {
    max-width: 480px;
    margin-inline: auto;
  }
  header {
    margin-bottom: 64px;
  }
  h2 {
    font-size: clamp(2.3rem, 7cqi, 4.5rem);
    line-height: 1.2;
    font-weight: 300;
  }
  li {
    padding-block: 28px;
    border-bottom-color: #bac1b7;
  }
  details {
    margin-top: 56px;
  }
</style>
