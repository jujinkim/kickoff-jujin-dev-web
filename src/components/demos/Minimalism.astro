---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
---

<section
  class="demo"
  data-demo="minimalism"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <header>
    <span>{t("OBJECT STUDIES", "사물 연구", "かたちの研究")}</span>
    <span data-number>01 / 03</span>
  </header>
  <div
    class="work"
    data-work="0"
    role="img"
    aria-label={t(
      "Abstract geometric sculpture",
      "추상 기하 조형",
      "抽象的な幾何造形",
    )}
  >
    <div></div>
  </div>
  <h2 data-title>{t("Balance", "균형", "均衡")}</h2>
  <p>
    {t(
      "Form, light, and a little space.",
      "형태, 빛, 그리고 작은 여백.",
      "かたち、光、そして少しの余白。",
    )}
  </p>
  <div class="controls">
    <button type="button" data-prev data-interactive disabled>
      ← {t("Previous", "이전", "前へ")}
    </button>
    <button type="button" data-next data-interactive disabled>
      {t("Next", "다음", "次へ")} →
    </button>
  </div>

  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("minimalism", (root, say) => {
    let index = 0;
    const names = {
      en: ["Balance", "Orbit", "Fold"],
      ko: ["균형", "궤도", "접힘"],
      ja: ["均衡", "軌道", "折り"],
    }[root.lang as "en" | "ko" | "ja"];
    const update = () => {
      root.querySelector<HTMLElement>("[data-work]")!.dataset.work =
        String(index);
      root.querySelector("[data-title]")!.textContent = names[index];
      root.querySelector("[data-number]")!.textContent = `0${index + 1} / 03`;
      say(names[index]);
    };
    root.querySelector("[data-prev]")!.addEventListener("click", () => {
      index = (index + 2) % 3;
      update();
    });
    root.querySelector("[data-next]")!.addEventListener("click", () => {
      index = (index + 1) % 3;
      update();
    });
    return () => {
      index = 0;
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  .demo * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.12;
  }
  h3 {
    font-size: 1.2rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  button,
  select,
  input,
  textarea {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]):not([type="range"]) {
    min-height: 44px;
    padding: 8px 12px;
  }
  button,
  select {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  input,
  textarea,
  select {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
      animation: none !important;
    }
  }
  .demo {
    background: #f9f8f3;
    color: #33312d;
    padding: clamp(24px, 5vw, 56px);
  }
  header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }
  .work {
    height: 280px;
    display: grid;
    place-items: center;
    margin: 20px 0 40px;
  }
  .work div {
    width: 140px;
    height: 200px;
    background: #a4a195;
    border-radius: 80px 80px 0 0;
    box-shadow: 24px 20px 0 #e5e2d9;
    transform: rotate(-10deg);
  }
  .work[data-work="1"] div {
    border-radius: 50%;
    height: 140px;
    background: #bd856c;
    transform: rotate(0);
  }
  .work[data-work="2"] div {
    border-radius: 0;
    background: #718474;
    transform: rotate(20deg);
  }
  h2 {
    font-size: 1.7rem;
    font-weight: 400;
  }
  button {
    border: 0;
    border-bottom: 1px solid #aaa;
    padding-left: 0;
  }
</style>
