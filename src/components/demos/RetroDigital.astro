---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const games = [
  {
    name: t("Star pilot", "별빛 비행사", "星のパイロット"),
    time: "18:00–18:30",
    note: t(
      "Take turns after each flight.",
      "비행을 마칠 때마다 교대합니다.",
      "飛行を終えるたびに交代します。",
    ),
  },
  {
    name: t("Pixel rally", "픽셀 랠리", "ピクセルラリー"),
    time: "19:00–19:30",
    note: t(
      "Two racers, three laps per round.",
      "두 사람이 한 회차에 세 바퀴를 달립니다.",
      "2人で1回に3周走ります。",
    ),
  },
];
---

<section
  class="demo"
  data-demo="retro-digital"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <span aria-hidden="true">▦</span>{" "}
    {t("ARCADE NIGHT", "오락실 모임", "ゲームの夕べ")}
  </header>
  <div class="desktop">
    <h2>
      {t("Meet. Play. Repeat.", "모여서, 한 판 더.", "集まって、もう一戦。")}
    </h2>
    <p>
      {t(
        "Saturday · Community hall · 18:00",
        "토요일 · 마을 회관 · 18:00",
        "土曜日 · 公民館 · 18:00",
      )}
    </p>
    <label>
      {t("Game", "게임", "ゲーム")}
      <select data-game data-interactive disabled>
        {games.map((g, i) => (
          <option value={i}>{g.name}</option>
        ))}
      </select>
    </label>
    <button
      type="button"
      data-open
      data-interactive
      disabled
      aria-expanded="false"
      aria-controls={`retro-window-${lang}`}
    >
      {t("Open session info", "회차 정보 열기", "回の案内を開く")}
    </button>
    <section class="window" id={`retro-window-${lang}`} data-window hidden>
      <div class="titlebar">
        <strong>{t("Session info", "회차 정보", "回の案内")}</strong>
        <button
          type="button"
          data-close
          data-interactive
          disabled
          aria-label={t(
            "Close session info",
            "회차 정보 닫기",
            "回の案内を閉じる",
          )}
        >
          ×
        </button>
      </div>
      {games.map((g, i) => (
        <div data-session hidden={i !== 0}>
          <h3>{g.name}</h3>
          <strong>{g.time}</strong>
          <p>{g.note}</p>
        </div>
      ))}
    </section>
  </div>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("retro-digital", (root, say) => {
    const select = root.querySelector<HTMLSelectElement>("[data-game]")!;
    const win = root.querySelector<HTMLElement>("[data-window]")!;
    const open = root.querySelector<HTMLButtonElement>("[data-open]")!;
    const show = (on: boolean) => {
      win.hidden = !on;
      open.setAttribute("aria-expanded", String(on));
    };
    select.addEventListener("change", () => {
      root
        .querySelectorAll<HTMLElement>("[data-session]")
        .forEach((p, i) => (p.hidden = i !== Number(select.value)));
      if (!win.hidden) say(select.selectedOptions[0].text);
    });
    open.addEventListener("click", () => {
      show(true);
      say(select.selectedOptions[0].text);
    });
    root.querySelector("[data-close]")!.addEventListener("click", () => {
      show(false);
      open.focus();
    });
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !win.hidden) {
        show(false);
        open.focus();
      }
    });
    return () => {
      select.value = "0";
      root
        .querySelectorAll<HTMLElement>("[data-session]")
        .forEach((p, i) => (p.hidden = i !== 0));
      show(false);
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #c4c6cd;
    color: #161722;
    border: 4px outset #eee;
    font-family: monospace;
    padding: 8px;
  }
  header,
  .titlebar {
    background: #253a75;
    color: #fff;
    padding: 12px;
    font-weight: 700;
  }
  .desktop {
    padding: 24px;
    background: #d9dfdc;
    min-height: 420px;
  }
  h2 {
    letter-spacing: -0.04em;
  }
  .desktop label {
    margin: 24px 0;
  }
  button,
  select {
    border: 3px outset #f6f6f6;
    border-radius: 0;
    background: #d8d9dd;
    color: #161722;
  }
  .window {
    margin-top: 24px;
    border: 3px outset #eee;
    background: #f7f6e9;
  }
  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 12px;
  }
  .titlebar button {
    min-width: 44px;
  }
  [data-session] {
    padding: 22px;
  }
  [data-session] p {
    margin-top: 16px;
  }
  footer {
    padding: 16px;
  }

  .demo {
    border-width: 7px;
  }
  .desktop {
    background-color: #d9dfdc;
    background-image: radial-gradient(#8d9993 1px, transparent 1px);
    background-size: 4px 4px;
  }
  .desktop > h2,
  .desktop > p,
  .desktop > label {
    background: #d9dfdc;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    text-transform: uppercase;
  }
  .window {
    border-width: 5px;
    box-shadow: 7px 7px #161722;
  }
  .titlebar {
    border-bottom: 3px solid #161722;
  }
  button:active {
    border-style: inset;
  }
</style>
