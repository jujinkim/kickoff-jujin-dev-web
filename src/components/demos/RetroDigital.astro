---
import type { Lang } from "../../lib/i18n";
import { workshop } from "./workshop";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const w = workshop(lang);
const prefix = "retro-digital-" + lang;
---

<section
  class="demo"
  data-comparison="tasks"
  data-demo="retro-digital"
  lang={lang}
  data-reset-message={w.resetMessage}
  data-completed-label={w.completed}
  data-progress-label={w.progress}
>
  <div class="desktop-title">
    <span>{w.project} / 01</span>
    <span aria-hidden="true">░ ▒ ▓</span>
  </div>
  <header>
    <div>
      <small>{w.identity} · 01</small>
      <h2>{w.project}</h2>
    </div>
    <span class="mark" aria-hidden="true">
      ✳
    </span>
  </header>
  <nav aria-label={w.menu}>
    {[
      ["overview", w.overview],
      ["tasks", w.tasksTitle],
      ["resources", w.resourcesTitle],
    ].map(([target, label]) => (
      <a href={`#${prefix}-${target}`} data-section-link>
        {label}
      </a>
    ))}
  </nav>
  <div class="workspace">
    <div class="work-main">
      <section
        class="intro"
        id={`${prefix}-overview`}
        tabindex="-1"
        aria-label={w.overview}
      >
        <h3>{w.goal}</h3>
        <p data-description>{w.description}</p>
      </section>
      <section id={`${prefix}-tasks`} tabindex="-1" aria-label={w.tasksTitle}>
        <div class="window-title">
          <h3>{w.tasksTitle}</h3>
          <span aria-hidden="true">▣</span>
        </div>
        <div class="controls">
          <label>
            {w.status}
            <select data-filter data-interactive disabled>
              <option value="all">{w.all}</option>
              <option value="open">{w.open}</option>
              <option value="done">{w.done}</option>
            </select>
          </label>
        </div>
        <ul>
          {w.tasks.map((text, i) => (
            <li data-task>
              <label>
                <input type="checkbox" data-check data-interactive disabled />
                <span class="task-label">{text}</span>
              </label>
              <small aria-hidden="true">0{i + 1}</small>
            </li>
          ))}
        </ul>
        <p data-empty hidden>
          {w.empty}
        </p>
      </section>
    </div>
    <aside>
      <section class="progress-panel" aria-label={w.progress}>
        <div class="window-title">
          <h3>{w.progress}</h3>
          <span aria-hidden="true">▣</span>
        </div>
        <div class="progress-values">
          <span>
            {w.completed} <strong data-count>0 / 3</strong>
          </span>
          <strong data-percent>0%</strong>
        </div>
        <progress data-progress value="0" max="3" aria-label={w.progress}>
          0 / 3
        </progress>
      </section>
      <section
        class="resources"
        id={`${prefix}-resources`}
        tabindex="-1"
        aria-label={w.resourcesTitle}
      >
        <div class="window-title">
          <h3>{w.resourcesTitle}</h3>
          <span aria-hidden="true">▣</span>
        </div>
        {w.resources.map((resource) => (
          <details data-resource>
            <summary>
              {resource.title}
              <span>{w.note}</span>
            </summary>
            <p>{resource.note}</p>
          </details>
        ))}
      </section>
    </aside>
  </div>
  <footer>
    <div class="footer-line">
      <small data-footer-summary>{w.summary}</small>
      <button class="reset" type="button" data-reset data-interactive disabled>
        {w.reset}
      </button>
    </div>
    <p role="status" aria-live="polite" aria-atomic="true">
      {w.initialMessage}
    </p>
  </footer>
</section>
<script>
  import { mountTasks } from "./tasks";
  mountTasks("retro-digital");
</script>
<style>
  /* Local control baseline. Astro scopes every selector to this component. */
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  :is(h2, h3, p) {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: 2rem;
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  :is(button, select, input, textarea) {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }

  :is(button, select, input:not([type="checkbox"]):not([type="range"])) {
    min-height: 44px;
    padding: 8px 12px;
  }
  :is(button, select) {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  :is(input, textarea, select) {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }

  [data-task] label {
    flex-wrap: nowrap;
    min-width: 0;
  }
  [data-task] input {
    flex: none;
  }
  [data-task] small {
    flex: none;
    white-space: nowrap;
  }

  .demo {
    container-type: inline-size;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
  }
  header .mark {
    font-size: 2.8rem;
    flex: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 24px;
  }
  nav a {
    color: inherit;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    text-decoration: none;
  }
  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 24px;
  }
  .work-main,
  aside {
    min-width: 0;
  }
  .intro {
    margin-bottom: 24px;
  }
  h2,
  h3 {
    font-family: inherit;
  }
  h3 {
    line-height: 1.3;
  }
  .controls {
    margin: 18px 0;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 12px;
  }
  li label {
    flex: 1;
    min-height: 44px;
    cursor: pointer;
  }
  li:has(:checked) .task-label {
    text-decoration: line-through;
  }
  .progress-panel {
    padding: 20px;
    margin-bottom: 24px;
  }
  .progress-values {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }
  progress {
    width: 100%;
    height: 12px;
    display: block;
  }
  details {
    margin-top: 12px;
    padding: 16px;
  }
  summary {
    cursor: pointer;
    min-height: 44px;
  }
  summary span {
    display: block;
    margin-top: 6px;
    font-size: 0.8rem;
  }
  details p {
    margin: 16px 0 0;
    line-height: 1.6;
  }
  footer {
    margin-top: 28px;
    padding-top: 20px;
  }
  footer .footer-line {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }
  footer .reset {
    margin: 0;
  }
  [data-empty] {
    padding: 20px 0;
  }
  @container (width < 600px) {
    .workspace {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .demo {
    background: repeating-linear-gradient(
      45deg,
      #326f73 0 2px,
      #35777b 2px 4px
    );
    color: #161c29;
    font-family: ui-monospace, monospace;
  }
  .desktop-title {
    padding: 10px 14px;
    background: #142f72;
    color: white;
    border: 2px outset #e7e7e7;
    font-size: 0.8rem;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  header {
    padding: 20px;
    background: #d5d6d2;
    border: 3px outset #fff;
    margin-bottom: 16px;
  }
  header .mark {
    background: #142f72;
    color: #f5ec98;
    padding: 0 10px;
    box-shadow: 4px 4px 0 #777;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    letter-spacing: -0.06em;
  }
  nav {
    padding: 6px;
    background: #d5d6d2;
    border: 3px outset #fff;
  }
  nav a {
    border: 2px outset #fff;
    background: #d5d6d2;
    text-decoration: underline;
  }
  nav a:active {
    border-style: inset;
  }
  .work-main,
  .progress-panel,
  .resources {
    background: #d5d6d2;
    border: 3px outset #fff;
    padding: 16px;
  }
  .window-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 8px;
    background: #142f72;
    color: white;
    margin: -10px -10px 18px;
  }
  .window-title h3 {
    margin: 0;
  }
  .intro {
    background: #fffbe9;
    border: 2px inset #fff;
    padding: 16px;
  }
  li {
    background: #fff;
    border-bottom: 1px dotted #888;
    padding: 14px 8px;
  }
  ul {
    border: 2px inset #fff;
  }
  details {
    background: #eee;
    border: 3px outset #fff;
    padding: 0;
  }
  summary {
    padding: 12px;
  }
  details[open] summary {
    background: #142f72;
    color: white;
  }
  details p {
    padding: 14px;
    margin: 0;
  }
  button,
  select {
    background: #d5d6d2;
    border: 3px outset #fff;
    border-radius: 0;
  }
  button:active {
    border-style: inset;
  }
  input,
  progress {
    accent-color: #142f72;
  }
  footer {
    background: #d5d6d2;
    border: 3px outset #fff;
    padding: 14px;
  }
  progress {
    height: 20px;
  }
</style>
