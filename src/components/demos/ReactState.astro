---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { platformText } from "./platform";
import "./platform-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  p = platformText(lang);
---

<section
  data-demo="react"
  data-platform
  lang={lang}
  data-reset-message={p.resetMessage}
  data-update-path={t(
    "Event → state setter → render",
    "이벤트 → 상태 설정 → 렌더링",
    "イベント → 状態設定 → 描画",
  )}
>
  <header>
    <p class="eyebrow">{p.simulation}</p>
    <h2>{t("Home planner", "집안 계획", "家庭の計画")}</h2>
  </header>
  <p>
    {t(
      "Save either card. Each card counts once; the other card stays unchanged.",
      "각 카드를 저장하세요. 카드마다 한 번만 집계하며 다른 카드 상태는 유지됩니다.",
      "各カードを保存します。カードごとに1回だけ数え、もう一方は変わりません。",
    )}
  </p>
  <div class="owner">
    <h3>{t("Shared save state", "공유 저장 상태", "共通の保存状態")}</h3>
    <p>
      {t(
        "Title props ↓ · parent state supplies each card’s saved status",
        "제목 프로퍼티 ↓ · 부모 상태에서 카드별 저장 여부 전달",
        "タイトルのプロップス ↓ · 親の状態から各カードに保存状況を渡す",
      )}
    </p>
    <div class="cards">
      <article>
        <p>{t("Shopping List", "장보기 목록", "買い物リスト")}</p>
        <h3>
          {t("For the week ahead", "다음 한 주를 위해", "これからの一週間に")}
        </h3>
        <button
          type="button"
          data-save="Shopping List"
          data-label={t("Shopping List", "장보기 목록", "買い物リスト")}
          aria-pressed="false"
          data-interactive
          disabled
        >
          {p.save}
        </button>
      </article>
      <article>
        <p>{t("Weekly Menu", "주간 식단", "週間メニュー")}</p>
        <h3>{t("Dinner, decided", "저녁 메뉴 정하기", "夕食を決めておく")}</h3>
        <button
          type="button"
          data-save="Weekly Menu"
          data-label={t("Weekly Menu", "주간 식단", "週間メニュー")}
          aria-pressed="false"
          data-interactive
          disabled
        >
          {p.save}
        </button>
      </article>
    </div>
  </div>
  <ol class="flow">
    <li>{t("Save event", "저장 이벤트", "保存イベント")}</li>
    <li>
      {t(
        "State setter requests rendering",
        "상태 설정 함수가 렌더링 요청",
        "状態設定が描画を要求",
      )}
    </li>
    <li>
      {t("Render labels and total", "문구와 합계 렌더링", "ラベルと合計を描画")}
    </li>
  </ol>
  <p class="total">
    {p.count}: <strong data-count>0</strong> / 2
  </p>
  <p data-state>
    {t("Shopping List", "장보기 목록", "買い物リスト")}: 0 ·{" "}
    {t("Weekly Menu", "주간 식단", "週間メニュー")}: 0
  </p>
  <p class="trace" data-path-state>
    {p.waiting}
  </p>
  <div class="controls">
    <button type="button" data-reset data-interactive disabled>
      {p.reset}
    </button>
  </div>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountUi } from "./ui-behavior";
  mountUi("react");
</script>
<style>
  section {
    background: #f3f6fb;
    color: #172640;
    padding: clamp(16px, 3vw, 30px);
    border: 1px solid #8696ad;
    border-radius: 6px;
  }
  .eyebrow {
    color: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  header {
    border-bottom: 1px solid #aab7c9;
    margin-bottom: 1.2rem;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 20px 0;
  }
  .cards article:first-child {
    background: #f5ecd7;
  }
  .cards article:last-child {
    background: #e5efe4;
  }
  .cards article {
    padding: 28px;
    border: 1px solid #74869e;
    background: white;
    border-radius: 8px;
  }
  header h2 {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    margin-bottom: 24px;
  }
  .cards article h3 {
    font-family: Georgia, serif;
    font-size: 1.8rem;
    font-weight: 400;
    min-height: 2.4em;
  }
  .cards article button {
    width: 100%;
  }
  .total {
    font-size: 1.3rem;
    font-weight: 700;
  }
  .trace {
    border-left: 4px solid #395783;
    padding: 12px;
    background: #e0eaf7;
  }
  .flow {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style-position: inside;
  }
  .flow li {
    padding: 14px;
    border: 1px solid #7889a2;
  }
  @container (max-width:560px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .owner {
    padding: 16px;
    border: 2px solid #375d84;
    border-radius: 14px;
  }
  .flow {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @container (max-width:560px) {
    .flow {
      grid-template-columns: 1fr;
    }
  }

  .owner {
    border: 6px solid #375d84;
    padding: 24px;
  }
  .owner > h3 {
    font-size: 1.6rem;
  }
  .cards {
    gap: 24px;
  }
  .cards article {
    border-top: 7px solid #375d84;
  }
  .flow {
    gap: 22px;
  }
  .flow li {
    border: 3px solid #375d84;
    font-weight: 700;
  }
  .total strong {
    font-size: 3rem;
  }
</style>
