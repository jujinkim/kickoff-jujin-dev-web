---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { moneyText } from "./monetization";
import "./monetization-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  m = moneyText(lang);
---

<section
  data-demo="prepaid-credits"
  data-money
  lang={lang}
  data-reset-message={m.resetMessage}
>
  <header>
    <p class="eyebrow">{m.fiction}</p>
    <h2>{t("Prepaid credits", "선불 크레딧", "前払いクレジット")}</h2>
  </header>
  <p>{m.billing}</p>
  <div class="wallet">
    <span>{m.balance}</span>
    <output data-balance>1000</output>
    <p>
      {t(
        "credits · 1 per export",
        "크레딧 · 내보내기당 1",
        "クレジット · 出力1回につき1",
      )}
    </p>
    <label>
      {t("Remaining share", "남은 비율", "残りの割合")}
      <progress data-progress value="1000" max="1000"></progress>
    </label>
  </div>
  <label>
    {m.exports}
    <input
      type="number"
      min="0"
      max="10000"
      step="1"
      value="100"
      data-quantity
      data-interactive
      disabled
    />
  </label>
  <div class="controls">
    <button type="button" data-consume data-interactive disabled>
      {t("Run exports", "내보내기 실행", "出力を実行")}
    </button>
    <button type="button" data-topup data-interactive disabled>
      {t(
        "Add 1,000 credits (simulated)",
        "1,000크레딧 충전 (가상)",
        "1,000クレジット追加（仮）",
      )}
    </button>
  </div>
  <div class="controls">
    <button type="button" data-spend="100" data-interactive disabled>
      {t("Month 1: 100", "월 1: 100", "1か月目：100")}
    </button>
    <button type="button" data-spend="300" data-interactive disabled>
      {t("Month 2: 300", "월 2: 300", "2か月目：300")}
    </button>
    <button type="button" data-spend="600" data-interactive disabled>
      {t("Month 3: 600", "월 3: 600", "3か月目：600")}
    </button>
  </div>
  <p>
    {t("Exports completed", "완료한 내보내기", "完了した出力")}:{" "}
    <b data-spent>0</b>
  </p>
  <p>
    {t(
      "Insufficient balance blocks the whole request. No expiry here. Credit purchase price omitted.",
      "잔액 부족 시 요청 전체를 차단합니다. 여기서는 만료가 없으며 크레딧 구매 가격은 생략했습니다.",
      "残高不足なら要求全体を止めます。この例では期限がなく、クレジット購入価格は省略しています。",
    )}
  </p>
  <p class="assumptions">{m.omitted}</p>
  <div class="controls">
    <button type="button" data-reset data-interactive disabled>
      {m.reset}
    </button>
  </div>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import type { Lang } from "../../lib/i18n";
  import { mount, local } from "./shared";
  import { moneyText, moneyField as field, readQuantity } from "./monetization";
  mount("prepaid-credits", (root, say) => {
    const m = moneyText(root.lang as Lang),
      t = local(root.lang as Lang),
      input = field<HTMLInputElement>(root, "[data-quantity]");
    let balance = 1000,
      spent = 0,
      granted = 1000;
    const update = () => {
      field(root, "[data-balance]").textContent = String(balance);
      field(root, "[data-spent]").textContent = String(spent);
      const progress = field<HTMLProgressElement>(root, "[data-progress]");
      progress.max = granted;
      progress.value = balance;
    };
    const consume = (q: number | null) => {
      if (q === null) {
        say(m.invalid);
        return;
      }
      if (q > balance) {
        say(
          t(
            "Insufficient credits. Nothing deducted.",
            "크레딧이 부족합니다. 차감하지 않았습니다.",
            "クレジット不足です。差し引いていません。",
          ),
        );
        return;
      }
      balance -= q;
      spent += q;
      update();
      say(`${m.exports}: ${q}. ${m.balance}: ${balance}`);
    };
    field(root, "[data-consume]").addEventListener("click", () =>
      consume(readQuantity(input)),
    );
    input.addEventListener("input", () => {
      if (readQuantity(input) === null) say(m.invalid);
    });
    root.querySelectorAll<HTMLButtonElement>("[data-spend]").forEach((button) =>
      button.addEventListener("click", () => {
        input.value = button.dataset.spend!;
        consume(readQuantity(input));
      }),
    );
    field(root, "[data-topup]").addEventListener("click", () => {
      balance += 1000;
      granted += 1000;
      update();
      say(`${m.balance}: ${balance}`);
    });
    return () => {
      balance = 1000;
      spent = 0;
      granted = 1000;
      input.value = "100";
      input.removeAttribute("aria-invalid");
      update();
    };
  });
</script>
<style>
  .wallet {
    background: #e1ece8;
    padding: 1.2rem;
    border: 2px solid #52766e;
    border-radius: 12px;
  }
  .wallet output {
    font-size: 3rem;
  }
  .wallet label {
    margin-bottom: 0;
  }
</style>
