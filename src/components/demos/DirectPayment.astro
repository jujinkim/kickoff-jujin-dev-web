---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { moneyText } from "./monetization";
import "./monetization-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  m = moneyText(lang);
---

<section data-demo="direct-payment" data-money lang={lang}>
  <header>
    <p class="eyebrow">{m.fiction}</p>
    <h2>
      {t("Customer direct payment", "고객 직접 결제", "顧客の直接支払い")}
    </h2>
  </header>
  <p>
    {t(
      "Reading service · customer-funded access",
      "읽기 서비스 · 고객이 접근 비용 부담",
      "読書サービス · 顧客がアクセス費用を負担",
    )}
  </p>
  <ol class="exchange">
    <li>
      {t("Reader → 12 → Publisher", "독자 → 12 → 발행자", "読者 → 12 → 発行者")}
    </li>
    <li>
      {t(
        "Publisher → reading access → Reader",
        "발행자 → 읽기 접근 → 독자",
        "発行者 → 読書アクセス → 読者",
      )}
    </li>
  </ol>
  <p class="value">
    {t(
      "Payment processor: handles payment; seller role is a separate contract.",
      "결제 처리 업체: 결제를 처리하며 판매자 역할은 별도 계약으로 정합니다.",
      "決済処理業者：決済を処理し、販売者の役割は別の契約で定めます。",
    )}
  </p>
  <p class="assumptions">{m.omitted}</p>
</section>
<style>
  .exchange {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
    counter-reset: path;
  }
  .exchange li {
    border: 2px solid #567a73;
    background: #fff;
    padding: 1rem;
    counter-increment: path;
  }
  .exchange li::before {
    content: counter(path, decimal-leading-zero);
    display: block;
    font-weight: 800;
    color: #25634f;
    margin-bottom: 0.5rem;
  }
  .value {
    border-left: 5px solid #b07838;
    padding: 0.7rem 1rem;
    background: #fff;
  }
</style>
