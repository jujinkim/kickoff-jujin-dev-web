---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
import "./fonts.css";
---

<section
  class="demo"
  data-demo="sans-serif"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <div class="sign">
    <small>NOTO SANS / {t("WAYFINDING", "길 안내", "道案内")}</small>
    <h2>
      {t("Platform", "승강장", "ホーム")} <strong>02 ↗</strong>
    </h2>
    <p>
      {t(
        "Northbound · Next train 09:42",
        "북쪽 방향 · 다음 열차 09:42",
        "北行き · 次の列車 09:42",
      )}
    </p>
  </div>
  <div class="sample" data-sample>
    <p>{t("Exit / Info", "출구 / 안내", "出口 / 案内")}</p>
    <p class="glyphs">Il1 O0 5689</p>
  </div>
  <div class="controls">
    <label>
      {t("Size", "크기", "サイズ")}
      <input
        data-size
        type="range"
        min="24"
        max="72"
        value="48"
        data-interactive
        disabled
      />
      <output data-size-value>48px</output>
    </label>
    <label>
      {t("Weight", "굵기", "太さ")}
      <input
        data-weight
        type="range"
        min="400"
        max="700"
        step="100"
        value="400"
        data-interactive
        disabled
      />
      <output data-weight-value>400</output>
    </label>
  </div>
  <p class="font-note">
    {t(
      "Self-hosted specimen. Latin uses the named face; Korean and Japanese use Noto CJK subsets. Other characters may use a fallback.",
      "자체 호스팅 표본. 라틴은 표시된 서체, 한·일은 Noto CJK 서브셋입니다. 다른 문자는 대체 글꼴로 표시될 수 있습니다.",
      "自前配信の見本。ラテン文字は表示の書体、韓国語・日本語はNoto CJKサブセット。ほかの文字は代替書体になる場合があります。",
    )}
  </p>
  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("sans-serif", (root, say) => {
    const size = root.querySelector<HTMLInputElement>("[data-size]")!,
      weight = root.querySelector<HTMLInputElement>("[data-weight]")!;
    const update = () => {
      const sample = root.querySelector<HTMLElement>("[data-sample]")!;
      sample.style.fontSize = `${size.value}px`;
      sample.style.fontWeight = weight.value;
      root.querySelector("[data-size-value]")!.textContent = `${size.value}px`;
      root.querySelector("[data-weight-value]")!.textContent = weight.value;
      say(`${size.value}px / ${weight.value}`);
    };
    size.addEventListener("input", update);
    weight.addEventListener("input", update);
    return () => {
      size.value = "48";
      weight.value = "400";
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  .demo * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.12;
  }
  h3 {
    font-size: 1.2rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  button,
  select,
  input,
  textarea {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]):not([type="range"]) {
    min-height: 44px;
    padding: 8px 12px;
  }
  button,
  select {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  input,
  textarea,
  select {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
      animation: none !important;
    }
  }
  .demo {
    background: #f2f6f8;
    color: #142d42;
    font-family: "Demo Sans", var(--demo-sans-cjk, sans-serif), sans-serif;
  }
  .sign {
    background: #143b58;
    color: white;
    padding: 24px;
    border-left: 12px solid #f0ce57;
  }
  .sign h2 {
    font-size: 2rem;
  }
  .sign strong {
    display: block;
    font-size: 4rem;
  }
  .sample {
    font-size: 48px;
    font-weight: 400;
    padding: 30px 0;
    line-height: 1.5;
  }
  .sample p {
    margin-bottom: 8px;
  }
  .glyphs {
    letter-spacing: 0.03em;
  }
  .font-note {
    font-size: 0.75rem;
  }
</style>
