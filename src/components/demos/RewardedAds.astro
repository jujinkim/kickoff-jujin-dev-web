---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { moneyText } from "./monetization";
import "./monetization-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  m = moneyText(lang);
---

<section
  data-demo="rewarded-ads"
  data-money
  lang={lang}
  data-reset-message={m.resetMessage}
>
  <header>
    <p class="eyebrow">{m.fiction}</p>
    <h2>{t("Rewarded ads", "보상형 광고", "リワード広告")}</h2>
  </header>
  <p>{m.puzzle}</p>
  <div class="offer">
    <h3>
      {t(
        "Complete one simulated ad → one hint",
        "모의 광고 1개 완료 → 힌트 1개",
        "模擬広告1本を完了 → ヒント1個",
      )}
    </h3>
    <p>
      {t(
        "Optional. Hint stays in this app and cannot be transferred. Interrupting gives no reward; normal play stays available.",
        "선택 사항입니다. 힌트는 앱 안에서만 쓰며 양도할 수 없습니다. 중단하면 보상이 없고 일반 플레이는 계속 가능합니다.",
        "任意です。ヒントはこのアプリ内でのみ使え、譲渡できません。中断では報酬なしで通常プレイは続けられます。",
      )}
    </p>
    <div class="controls">
      <button type="button" data-opt-in data-interactive disabled>
        {t("Choose ad participation", "광고 참여 선택", "広告への参加を選ぶ")}
      </button>
      <button type="button" data-skip data-interactive disabled>
        {t("Decline / interrupt", "거절 / 중단", "断る / 中断")}
      </button>
    </div>
  </div>
  <div class="ad-stage">
    <strong data-ad-state>
      {t("No ad started", "시작한 광고 없음", "開始した広告なし")}
    </strong>
    <p>
      {t(
        "Simulation only · no ad request",
        "시뮬레이션 전용 · 실제 광고 요청 없음",
        "模擬のみ · 実際の広告要求なし",
      )}
    </p>
    <button
      type="button"
      data-complete
      aria-disabled="true"
      data-interactive
      disabled
    >
      {t("Complete simulated ad", "모의 광고 완료", "模擬広告を完了")}
    </button>
  </div>
  <div class="reward">
    <span>{m.hints}</span>
    <output data-rewards>0</output>
  </div>
  <div class="controls">
    <button type="button" data-play data-interactive disabled>
      {t("Play normally", "일반 플레이", "通常プレイ")}
    </button>
  </div>
  <p>
    {t("Normal play count", "일반 플레이 횟수", "通常プレイ回数")}:{" "}
    <b data-plays>0</b>
  </p>
  <p class="assumptions">
    {t(
      "Reward once per completed attempt. No money transfer; revenue and network charges omitted.",
      "완료한 참여마다 보상은 한 번입니다. 실제 송금은 없으며 수익·네트워크 비용은 생략했습니다.",
      "完了した参加ごとに報酬は一度です。実際の送金はなく、収益・ネットワーク費用は省略しています。",
    )}
  </p>
  <div class="controls">
    <button type="button" data-reset data-interactive disabled>
      {m.reset}
    </button>
  </div>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import type { Lang } from "../../lib/i18n";
  import { mount, local } from "./shared";
  import { moneyText, moneyField as field } from "./monetization";
  mount("rewarded-ads", (root, say) => {
    const m = moneyText(root.lang as Lang),
      t = local(root.lang as Lang);
    let phase: "idle" | "watching" | "completed" | "skipped" = "idle",
      rewards = 0,
      plays = 0;
    const update = (announce = true) => {
      root.dataset.phase = phase;
      const label =
        phase === "watching"
          ? t(
              "Participating · completion required",
              "참여 중 · 완료 필요",
              "参加中 · 完了が必要",
            )
          : phase === "completed"
            ? t(
                "Completed · one hint granted",
                "완료 · 힌트 1개 지급",
                "完了 · ヒント1個を付与",
              )
            : phase === "skipped"
              ? t(
                  "Declined or interrupted · no reward",
                  "거절 또는 중단 · 보상 없음",
                  "拒否または中断 · 報酬なし",
                )
              : t("No ad started", "시작한 광고 없음", "開始した広告なし");
      field(root, "[data-ad-state]").textContent = label;
      field(root, "[data-rewards]").textContent = String(rewards);
      field(root, "[data-plays]").textContent = String(plays);
      field(root, "[data-opt-in]").setAttribute(
        "aria-disabled",
        String(phase === "watching"),
      );
      field(root, "[data-complete]").setAttribute(
        "aria-disabled",
        String(phase !== "watching"),
      );
      field(root, "[data-skip]").setAttribute(
        "aria-disabled",
        String(phase === "completed"),
      );
      if (announce) say(`${label}. ${m.hints}: ${rewards}`);
    };
    field(root, "[data-opt-in]").addEventListener("click", () => {
      if (phase === "watching") {
        say(m.blocked);
        return;
      }
      phase = "watching";
      update();
    });
    field(root, "[data-skip]").addEventListener("click", () => {
      if (phase === "completed") {
        say(m.blocked);
        return;
      }
      phase = "skipped";
      update();
    });
    field(root, "[data-complete]").addEventListener("click", () => {
      if (phase !== "watching") {
        say(m.blocked);
        return;
      }
      phase = "completed";
      rewards++;
      update();
    });
    field(root, "[data-play]").addEventListener("click", () => {
      plays++;
      update(false);
      say(`${m.success} ${plays}`);
    });
    update(false);
    return () => {
      phase = "idle";
      rewards = 0;
      plays = 0;
      update(false);
    };
  });
</script>
<style>
  .offer {
    background: #e1ece8;
    border: 2px solid #52766e;
    padding: 1rem;
  }
  .ad-stage {
    border: 2px dashed #956122;
    padding: 1rem;
    margin: 1rem 0;
    background: #fff;
  }
  .reward {
    display: flex;
    gap: 1rem;
    align-items: center;
    border-bottom: 2px solid #52766e;
    padding: 0.6rem;
  }
  .reward output {
    margin-left: auto;
  }
</style>
