---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { requirementsText } from "./requirements";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  r = requirementsText(lang);
const stages = [
  [
    t("When · situation", "언제 · 상황", "いつ · 状況"),
    t(
      "My journey interrupts reading",
      "이동 중 읽기를 멈춰야 할 때",
      "移動中に読書を中断するとき",
    ),
  ],
  [
    t("I want · motivation", "원하는 것 · 동기", "したい · 動機"),
    t(
      "I want a way back to A17",
      "A17로 돌아올 방법을 남기고 싶다",
      "A17に戻る手がかりがほしい",
    ),
  ],
  [
    t("So I can · outcome", "이유 · 기대 결과", "その結果 · 望む成果"),
    t(
      "So I can finish later",
      "나중에 마저 읽을 수 있도록",
      "後で最後まで読めるように",
    ),
  ],
];
---

<section data-demo="job-story" lang={lang}>
  <header>
    <p class="eyebrow">{r.fiction}</p>
    <h2>
      {t(
        "Understand the interruption",
        "읽기를 멈추는 상황 이해",
        "読書を中断する状況を理解",
      )}
    </h2>
    <p data-fixture>{r.fixture}</p>
  </header>
  <ol class="need">
    {stages.map(([label, text], index) => (
      <li>
        <span class="number" aria-hidden="true">
          {index + 1}
        </span>
        <div>
          <span class="label">{label}</span>
          <strong>{text}</strong>
        </div>
      </li>
    ))}
  </ol>
  <div class="solutions">
    <h3>
      {t(
        "Then evaluate solutions",
        "그다음 해결책 검토",
        "その後で解決策を検討",
      )}
    </h3>
    <ul>
      <li>{t("Save A17’s link", "A17 링크 저장", "A17のリンクを保存")}</li>
      <li>
        {t(
          "Reminder with A17’s link",
          "A17 링크를 담은 알림",
          "A17のリンク付きリマインダー",
        )}
      </li>
    </ul>
    <p>
      {t(
        "If choosing saving: discuss duplicates and failed writes separately.",
        "저장을 선택한다면 중복·쓰기 실패를 별도 논의합니다.",
        "保存を選ぶなら、重複や書き込み失敗は別途検討します。",
      )}
    </p>
  </div>
  <p class="boundary" data-boundary>
    {r.boundary}
  </p>
</section>
<style>
  .eyebrow {
    color: #40314e;
  }
  section {
    container-type: inline-size;
    background: #f3eff7;
    color: #40314e;
    border: 1px solid #94839e;
    border-radius: 12px;
    padding: clamp(16px, 4vw, 30px);
    font-family: system-ui, sans-serif;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  p,
  h2,
  h3,
  ol,
  ul {
    margin: 0;
  }
  h2 {
    font-size: clamp(1.2rem, 3vw, 1.65rem);
    line-height: 1.3;
    margin: 0.4rem 0 0.7rem;
  }
  .eyebrow,
  .label {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .need {
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
    margin: 1.25rem 0;
  }
  .need li {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .number {
    border: 1px solid #765f86;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    font-weight: 700;
  }
  .need li > div {
    flex: 1;
    border-left: 3px solid #765f86;
    padding: 0.65rem 1rem;
    background: #fff;
    min-width: 0;
  }
  .label,
  .need strong {
    display: block;
  }
  .label {
    color: #695577;
    margin-bottom: 0.3rem;
  }
  .need strong {
    font-size: 1.05rem;
  }
  .solutions {
    border-top: 2px dashed #94839e;
    padding-top: 1rem;
  }
  h3 {
    font-size: 0.9rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0;
  }
  ul li {
    background: #fff;
    border: 1px solid #94839e;
    padding: 0.7rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .solutions p,
  .boundary {
    font-size: 0.85rem;
  }
  .boundary {
    margin-top: 1rem;
  }
  @container (max-width: 430px) {
    ul {
      grid-template-columns: 1fr;
    }
    .need li {
      gap: 0.6rem;
    }
    .need li > div {
      padding: 0.65rem;
    }
  }
  @media (forced-colors: active) {
    .number,
    .need li > div,
    .solutions,
    ul li {
      border-color: CanvasText;
    }
  }
</style>
