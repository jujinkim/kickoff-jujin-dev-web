---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { moneyText } from "./monetization";
import "./monetization-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  m = moneyText(lang, "base-plus-overage");
---

<section
  data-demo="base-plus-overage"
  data-money
  lang={lang}
  data-reset-message={m.resetMessage}
>
  <header>
    <p class="eyebrow">{m.fiction}</p>
    <h2>
      {t("Base fee plus overage", "기본료+초과 사용량", "基本料＋超過利用量")}
    </h2>
  </header>
  <p>{m.baseline}</p>
  <div class="included">
    <strong>
      {t(
        "Base 20 · includes 100 exports",
        "기본료 20 · 100회 포함",
        "基本料20 · 100回を含む",
      )}
    </strong>
    <p>
      {t(
        "Extra exports: 0.10 each",
        "초과 내보내기: 회당 0.10",
        "超過出力：1回0.10",
      )}
    </p>
  </div>
  <div
    class="quantity-cases"
    role="group"
    aria-label={t(
      "Compare boundary quantities",
      "경계 수량 비교",
      "境界の数量を比較",
    )}
  >
    <button type="button" data-quantity-preset="0" data-interactive disabled>
      <span>{t("Quantity", "수량", "数量")} 0</span>
      <strong>→ 20.00</strong>
    </button>
    <button type="button" data-quantity-preset="100" data-interactive disabled>
      <span>{t("Quantity", "수량", "数量")} 100</span>
      <strong>→ 20.00</strong>
    </button>
    <button type="button" data-quantity-preset="101" data-interactive disabled>
      <span>{t("Quantity", "수량", "数量")} 101</span>
      <strong>→ 20.10</strong>
    </button>
  </div>
  <label>
    {m.exports}
    <input
      type="number"
      min="0"
      max="10000"
      step="1"
      value="120"
      data-quantity
      data-interactive
      disabled
    />
  </label>
  <div class="controls">
    <button type="button" data-less data-interactive disabled>
      {t("Remove one", "1 감소", "1減らす")}
    </button>
    <button type="button" data-more data-interactive disabled>
      {t("Add one", "1 추가", "1増やす")}
    </button>
  </div>
  <div class="result">
    <span>{m.total}</span>
    <output data-total>22.00</output>
    <p data-formula>20.00 + 20 × 0.10 = 22.00</p>
  </div>
  <p class="assumptions">{m.omitted}</p>
  <div class="controls">
    <button type="button" data-reset data-interactive disabled>
      {m.reset}
    </button>
  </div>
  <p data-contract-context class="contract-context">
    {t(
      "The customer pays 20 monthly including 100 transcript exports, plus 0.10 per excess export. At 120 the total is 22; at zero or 100 it remains 20. Three seats are context, not a multiplier.",
      "고객은 월 100회 전사 출력을 포함한 20과 초과 출력당 0.10을 냅니다. 120회는 22, 0회나 100회는 20입니다. 3좌석은 상황 설명이며 곱하는 계수가 아닙니다.",
      "顧客は月100回の文字起こし出力を含む20と、超過1回ごとに0.10を払います。120回は22、0回や100回は20です。3席は状況説明で、掛け算の係数ではありません。",
    )}
  </p>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountPricing } from "./monetization-pricing";
  mountPricing("base-plus-overage", 120);
</script>
<style>
  .included {
    padding: 1rem;
    border-left: 5px solid #52766e;
    background: #fff;
  }
  .result {
    background: #e1ece8;
    border: 2px solid #52766e;
    padding: 1rem;
    margin: 1rem 0;
  }
  .result p {
    margin-bottom: 0;
  }

  .quantity-cases {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0;
  }
  .quantity-cases button {
    flex: 1 1 130px;
    display: grid;
    gap: 8px;
    padding: 18px;
    border: 2px solid currentColor;
    text-align: left;
  }
  .quantity-cases strong {
    font-size: 1.5rem;
  }
  .result output {
    font-size: clamp(2.5rem, 7cqi, 4rem);
    font-weight: 800;
  }

  .included {
    border: 6px solid #70543b;
    padding: 28px;
  }
  .included strong {
    font-size: 1.5rem;
  }
  .included p {
    border-top: 4px dashed #70543b;
    margin-top: 24px;
    padding-top: 24px;
  }
</style>
