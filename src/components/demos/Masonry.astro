---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { photo } from "./photos";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const photos = [
  {
    file: "beach-diary.png",
    w: 1536,
    h: 1024,
    title: t("Morning shore", "아침 물가", "朝の岸辺"),
    note: t(
      "Low waves arrive beside the dune path. The broad horizon stays visible without cropping.",
      "모래언덕 길 옆으로 낮은 파도가 밀려옵니다. 넓은 수평선을 자르지 않고 보여줍니다.",
      "砂丘の道に低い波が届きます。広い水平線を切り取らずに見せます。",
    ),
  },
  {
    file: "harbor-diary.png",
    w: 1024,
    h: 1536,
    title: t("Harbor at dusk", "해 질 무렵 항구", "夕暮れの港"),
    note: t(
      "The portrait frame follows the boats from the foreground to the last light on the water.",
      "세로 구도는 앞쪽 배에서 물 위 마지막 빛까지 이어집니다.",
      "縦の構図が手前の船から水面の最後の光へ続きます。",
    ),
  },
  {
    file: "lake-walk.png",
    w: 1536,
    h: 1024,
    title: t("A lake detour", "호수로 돌아가기", "湖への寄り道"),
    note: t(
      "Pines frame the path. We paused here before continuing home, keeping the entire shoreline in the frame.",
      "소나무가 길을 감쌉니다. 물가 전체를 담고 잠깐 쉰 뒤 집으로 향했습니다.",
      "松が道を囲みます。岸辺全体を写し、少し休んでから帰りました。",
    ),
  },
  {
    file: "beach-diary.png",
    w: 1536,
    h: 1024,
    title: t("One last look", "마지막 눈길", "最後のひと眺め"),
    note: t(
      "The same beach photograph appears again with a longer memory. Different caption lengths also affect card height; opening this note must move later cards without overlap.",
      "같은 해변 사진에 더 긴 기억을 붙였습니다. 캡션 길이도 카드 높이에 영향을 줍니다. 이 메모를 열면 뒤의 카드가 겹치지 않게 움직여야 합니다.",
      "同じ浜辺の写真に長い思い出を添えました。説明の長さもカードの高さに影響します。メモを開くと後のカードが重ならずに移動する必要があります。",
    ),
  },
];
---

<section
  class="demo"
  data-demo="masonry"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>{t("TRAVEL JOURNAL", "여행 기록", "旅の記録")}</small>
    <h2>{t("Places we paused", "잠시 머문 곳", "足を止めた場所")}</h2>
    <p>
      {t(
        "Wide shores, tall harbors, room for each memory.",
        "가로로 넓은 물가와 세로로 긴 항구, 각 기억의 자리.",
        "横に広い岸辺と縦に長い港、それぞれの記憶の場所。",
      )}
    </p>
  </header>
  <div class="board">
    {photos.map((p, i) => (
      <article data-tile>
        <img
          {...photo(p.file, "(max-width: 640px) 100vw, 400px")}
          width={p.w}
          height={p.h}
          alt={p.title}
        />
        <div class="description">
          <small>0{i + 1}</small>
          <h3>{p.title}</h3>
          <details>
            <summary>{t("Read memory", "기억 읽기", "思い出を読む")}</summary>
            <p>{p.note}</p>
          </details>
        </div>
      </article>
    ))}
  </div>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("masonry", (root, say) => {
    const board = root.querySelector<HTMLElement>(".board")!;
    const tiles = [...root.querySelectorAll<HTMLElement>("[data-tile]")];
    let pending = false;
    const layout = () => {
      pending = false;
      const cols =
        board.clientWidth < 450 ? 1 : board.clientWidth < 650 ? 2 : 3;
      const gap = 18;
      const width = (board.clientWidth - gap * (cols - 1)) / cols;
      const heights = Array<number>(cols).fill(0);
      board.dataset.positioned = "true";
      tiles.forEach((tile) => {
        tile.style.width = `${width}px`;
        const col = heights.indexOf(Math.min(...heights));
        tile.style.transform = `translate(${col * (width + gap)}px,${heights[col]}px)`;
        heights[col] += tile.offsetHeight + gap;
      });
      board.style.height = `${Math.max(...heights) - gap}px`;
    };
    const queue = () => {
      if (!pending) {
        pending = true;
        requestAnimationFrame(layout);
      }
    };
    const observer = new ResizeObserver(queue);
    observer.observe(board);
    tiles.forEach((tile) => observer.observe(tile));
    root.querySelectorAll("details").forEach((d) =>
      d.addEventListener("toggle", () => {
        queue();
        if (d.open)
          say(d.closest("article")!.querySelector("h3")!.textContent!);
      }),
    );
    root
      .querySelectorAll("img")
      .forEach((img) => img.addEventListener("load", queue));
    document.fonts.ready.then(queue);
    queue();
    window.addEventListener("pagehide", () => observer.disconnect(), {
      once: true,
    });
    return () => {
      root.querySelectorAll("details").forEach((d) => (d.open = false));
      queue();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #f0ebe2;
    color: #403b35;
  }
  h2 {
    font-family: Georgia, serif;
    font-weight: 400;
    margin-top: 16px;
  }
  .board {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 28px;
    align-items: start;
  }
  .board[data-positioned="true"] {
    display: block;
  }
  .board[data-positioned="true"] article {
    position: absolute;
    top: 0;
    left: 0;
  }
  article {
    background: #fffdf7;
    border: 1px solid #c5bbae;
    min-width: 0;
  }
  img {
    width: 100%;
    height: auto;
    display: block;
  }
  .description {
    padding: 18px;
  }
  h3 {
    margin-top: 8px;
    font-size: 1.15rem;
  }
  summary {
    min-height: 44px;
  }
  details p {
    font-size: 0.9rem;
    margin-top: 16px;
  }
  button {
    background: #fffdf7;
  }
  @container (width<450px) {
    .board {
      grid-template-columns: 1fr;
    }
  }

  .board {
    gap: 24px;
  }
  article {
    border: 0;
    box-shadow: 0 3px 8px #403b351a;
  }
  article:nth-child(1) img {
    aspect-ratio: 2.7;
    object-fit: cover;
  }
  article:nth-child(2) img {
    aspect-ratio: 0.55;
    object-fit: cover;
  }
  article:nth-child(3) img {
    aspect-ratio: 1;
    object-fit: cover;
  }
  article:nth-child(4) img {
    aspect-ratio: 1.8;
    object-fit: cover;
  }
</style>
