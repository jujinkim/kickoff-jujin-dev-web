---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { platformText } from "./platform";
import "./platform-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  p = platformText(lang);
---

<section
  data-demo="unreal-engine"
  data-platform
  lang={lang}
  data-reset-message={p.resetMessage}
>
  <header>
    <p class="eyebrow">{p.simulation}</p>
    <h2>Unreal Engine</h2>
  </header>
  <p>
    {t(
      "In a village game, move the player into the coin. Authored contact logic awards one point and removes it.",
      "마을 게임에서 플레이어를 동전으로 이동하세요. 작성한 접촉 로직이 1점을 주고 대상을 제거합니다.",
      "村のゲームでプレイヤーをコインへ移動します。独自の接触処理が1点を与えて削除します。",
    )}
  </p>
  <div class="controls">
    <button type="button" data-touch data-interactive disabled>
      {t("Move to coin", "동전으로 이동", "コインへ移動")}
    </button>
    <button type="button" data-reset data-interactive disabled>
      {p.reset}
    </button>
  </div>
  <label>
    <input type="checkbox" data-contact-off data-interactive disabled />
    {t("Disable contact", "접촉 끄기", "接触を無効にする")}
  </label>
  <figure class="scene">
    <svg
      viewBox="0 0 360 170"
      role="img"
      aria-label={t(
        "Scene schematic; object states are listed below.",
        "씬 도식. 오브젝트 상태는 아래에 표시됩니다.",
        "シーンの模式図。状態は下に表示します。",
      )}
    >
      <path
        d="M20 140 L320 140 L345 115 L60 115 Z"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
      <g data-player transform="translate(0 0)">
        <rect x="55" y="78" width="30" height="42" fill="currentColor" />
        <text x="60" y="104" fill="white">
          P
        </text>
      </g>
      <g data-item>
        <path
          d="M240 82 L254 101 L240 120 L226 101 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
        />
        <text x="236" y="106" fill="currentColor">
          I
        </text>
      </g>
      <path
        d="M40 20 h32 v20 h-32 Z M72 23 l14 -8 v30 l-14 -8"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
      <text x="48" y="36" fill="currentColor">
        C
      </text>
    </svg>
    <figcaption>
      P: {t("Player", "플레이어", "プレイヤー")} · I:{" "}
      {t("Coin", "동전", "コイン")} · C: {t("Camera", "카메라", "カメラ")} · ─:{" "}
      {t("Floor", "바닥", "床")}
    </figcaption>
  </figure>
  <p class="score">
    {t("Score", "점수", "得点")}: <strong data-score>0</strong> ·{" "}
    {t("Coin", "동전", "コイン")}:{" "}
    <span data-item-state>{t("Present", "있음", "存在")}</span>
  </p>
  <div class="composition">
    <h3>
      {t(
        "Initial level: player, floor, camera, collectible Actors",
        "초기 레벨: 플레이어·바닥·카메라·아이템 액터",
        "初期レベル：プレイヤー・床・カメラ・アイテムのアクター",
      )}
    </h3>
    <p>
      {t(
        "Collectible Blueprint class: mesh + collision components",
        "아이템 Blueprint 클래스: 메시 + 충돌 컴포넌트",
        "アイテムのBlueprintクラス：メッシュ + 衝突コンポーネント",
      )}
    </p>
    <ol class="flow">
      <li>{t("Overlap event", "겹침 이벤트", "重なりイベント")}</li>
      <li>
        {t(
          "Guard: item present?",
          "검사: 아이템 존재?",
          "判定：アイテムは存在？",
        )}
      </li>
      <li>
        {t(
          "Score +1 → remove Actor",
          "점수 +1 → 액터 제거",
          "得点+1 → アクター削除",
        )}
      </li>
    </ol>
  </div>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountEngine } from "./engine-behavior";
  mountEngine("unreal-engine");
</script>
<style>
  section {
    background: #f3f6fb;
    color: #172640;
    padding: clamp(16px, 3vw, 30px);
    border: 1px solid #8696ad;
    border-radius: 12px;
  }
  .eyebrow {
    color: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  header {
    border-bottom: 1px solid #aab7c9;
    margin-bottom: 1.2rem;
  }

  .scene {
    margin: 20px 0;
    padding: 16px;
    background: #e2eaf4;
    border: 1px solid #697f9c;
  }
  svg {
    width: 100%;
    max-height: 220px;
    display: block;
  }
  figcaption {
    font-size: 0.85rem;
  }
  .score {
    font-size: 1.2rem;
    margin-top: 20px;
  }
  .composition {
    padding: 18px;
    border: 1px solid #788ba7;
  }
  .composition li {
    margin: 0.5rem 0;
  }
  .flow {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style-position: inside;
    padding: 0;
  }
  .flow li {
    padding: 12px;
    border: 1px solid #667b9a;
    flex: 1;
    min-width: 120px;
  }
  .composition {
    background: #e7e4f2;
  }
  .flow li {
    border-radius: 10px;
    background: #fff;
  }
</style>
