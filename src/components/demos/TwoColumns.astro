---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { resources } from "./resources";
import "./comparison-base.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const items = resources(lang);
---

<section
  class="demo"
  data-demo="two-columns"
  data-comparison="resources"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <header>
    <small>{t("COLLECTED / 06", "수집 자료 / 06", "収集資料 / 06")}</small>
    <h2>{t("Visual fragments", "시각의 조각", "視覚のかけら")}</h2>
    <p>
      {t(
        "Browse the same six resources; compare how the layout changes the reading flow.",
        "같은 자료 6개를 살펴보며 배치에 따른 읽기 흐름을 비교하세요.",
        "同じ6件の資料で、配置による読む流れの違いを比べてください。",
      )}
    </p>
  </header>
  <div class="controls">
    <label>
      {t("Preview width", "미리보기 폭", "表示幅")}
      <select data-width data-interactive disabled>
        <option value="wide">{t("Wide", "넓게", "広い")}</option>
        <option value="narrow">{t("Narrow", "좁게", "狭い")}</option>
      </select>
    </label>
  </div>
  <div class="frame" data-width="wide">
    <div class="workspace">
      <nav aria-label={t("Resource filters", "자료 필터", "資料の絞り込み")}>
        <label>
          {t("Topic", "주제", "テーマ")}
          <select data-filter data-interactive disabled>
            <option value="all">{t("All", "전체", "すべて")}</option>
            <option value="color">{t("Color", "색", "色")}</option>
            <option value="form">{t("Form", "형태", "形")}</option>
            <option value="type">{t("Type", "글자", "文字")}</option>
          </select>
        </label>
        <label>
          {t("Order", "순서", "順序")}
          <select data-sort data-interactive disabled>
            <option value="original">
              {t("Collection order", "수집 순서", "収集順")}
            </option>
            <option value="reverse">
              {t("Reverse order", "역순", "逆順")}
            </option>
          </select>
        </label>
        <strong data-count>6 / 6</strong>
      </nav>
      <div class="board">
        {items.map((item) => (
          <article data-tile data-id={item.id} data-topic={item.topic}>
            <div class={`art art-${item.id}`} aria-hidden="true">
              {item.symbol}
            </div>
            <div class="description">
              <small>0{item.id + 1}</small>
              <h3 data-resource-title>{item.title}</h3>
              <p>{item.description}</p>
              <details>
                <summary>{t("Study notes", "연구 메모", "研究メモ")}</summary>
                <p>
                  {t(
                    "Compare shape, spacing, and contrast. Keep this resource beside the next draft and revisit the details.",
                    "형태, 간격, 대비를 비교합니다. 다음 초안 곁에 자료를 두고 세부를 다시 살펴보세요.",
                    "形、間隔、コントラストを比べます。次の案の横に資料を置き、細部を見直してください。",
                  )}
                </p>
              </details>
            </div>
          </article>
        ))}
      </div>
      <aside>
        <h3>{t("Study guide", "연구 안내", "研究ガイド")}</h3>
        <p>
          {t(
            "Collect → compare → revise",
            "수집 → 비교 → 수정",
            "収集 → 比較 → 修正",
          )}
        </p>
        <p>
          {t(
            "Six resources, one collection.",
            "자료 6개, 하나의 모음.",
            "6件の資料、ひとつのコレクション。",
          )}
        </p>
      </aside>
    </div>
  </div>
  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountResources } from "./resource-behavior";
  mountResources("two-columns", false);
</script>
<style>
  .demo {
    background: #f3ece5;
    color: #443730;
  }
  .frame {
    container-type: inline-size;
    margin: auto;
  }
  .frame[data-width="narrow"] {
    max-width: 300px;
  }
  .workspace {
    display: grid;
    gap: 20px;
    align-items: start;
  }
  .workspace > * {
    min-width: 0;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 16px;
    background: #e5ddd3;
    border: 1px solid #bead9e;
    align-items: center;
  }
  nav select {
    width: 100%;
    min-width: 0;
  }
  nav label {
    min-width: 0;
    display: grid;
    gap: 8px;
  }
  .board {
    display: grid;
    gap: 16px;
    align-items: start;
    min-width: 0;
    position: relative;
  }
  article {
    min-width: 0;
    padding: 14px;
    background: #fffaf4;
    border: 1px solid #bead9e;
  }
  .art {
    display: grid;
    place-items: center;
    height: 120px;
    font-size: 3rem;
    background: #bdc9ad;
    color: #3f5034;
    margin-bottom: 16px;
  }
  .art-1 {
    background: #dfb29c;
    color: #6c3924;
  }
  .art-2 {
    background: #c7cadc;
    color: #454b70;
  }
  .art-3 {
    background: #decf99;
    color: #665824;
  }
  .art-4 {
    background: #d1b7c5;
    color: #664252;
  }
  .art-5 {
    background: #a8c5c2;
    color: #315a56;
  }
  article p,
  aside p {
    font-size: 0.85rem;
    line-height: 1.65;
  }
  details p {
    margin-top: 12px;
  }
  aside {
    border-block: 1px solid #bead9e;
    padding: 16px 0;
  }
  .workspace {
    grid-template-columns: 160px minmax(0, 1fr);
  }
  nav {
    display: grid;
    grid-row: 1 / span 2;
  }
  .board {
    grid-column: 2;
  }
  aside {
    grid-column: 2;
  }
  @container (max-width:450px) {
    .workspace {
      grid-template-columns: 1fr;
    }
    .workspace > * {
      grid-column: auto;
    }
    .board {
      grid-template-columns: 1fr;
    }
    article {
      display: block;
    }
    .art {
      max-width: 100%;
    }
  }
</style>
