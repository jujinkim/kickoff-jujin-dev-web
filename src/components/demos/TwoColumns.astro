---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { photo } from "./photos";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const recipes = [
  {
    title: t(
      "Tomato & basil pasta",
      "토마토 바질 파스타",
      "トマトとバジルのパスタ",
    ),
    time: 20,
    ingredient: "tomato",
    note: t(
      "Tomatoes, basil, pasta, olive oil. Simmer the tomatoes, then toss with cooked pasta and basil.",
      "토마토, 바질, 파스타, 올리브유. 토마토를 졸인 뒤 삶은 파스타와 바질을 섞습니다.",
      "トマト、バジル、パスタ、オリーブ油。トマトを煮詰め、ゆでたパスタとバジルを合わせます。",
    ),
  },
  {
    title: t("Roasted tomato soup", "구운 토마토 수프", "焼きトマトのスープ"),
    time: 40,
    ingredient: "tomato",
    note: t(
      "Roast tomatoes with onion, blend with stock, then warm through. Serve with bread.",
      "토마토와 양파를 구워 육수와 함께 갈고 다시 데웁니다. 빵을 곁들입니다.",
      "トマトと玉ねぎを焼き、スープと合わせて混ぜ、温めます。パンを添えます。",
    ),
  },
  {
    title: t("Mushroom toast", "버섯 토스트", "きのこのトースト"),
    time: 15,
    ingredient: "mushroom",
    note: t(
      "Sauté mushrooms until golden. Spoon over toasted bread with herbs.",
      "버섯을 노릇하게 볶아 구운 빵 위에 올리고 허브를 더합니다.",
      "きのこをこんがり炒め、トーストにのせてハーブを添えます。",
    ),
  },
  {
    title: t("Mushroom risotto", "버섯 리소토", "きのこのリゾット"),
    time: 45,
    ingredient: "mushroom",
    note: t(
      "Toast rice, add hot stock in stages, and stir in browned mushrooms.",
      "쌀을 볶은 뒤 뜨거운 육수를 조금씩 넣고 볶은 버섯을 섞습니다.",
      "米を炒め、熱いスープを少しずつ加え、炒めたきのこを混ぜます。",
    ),
  },
];
---

<section
  data-demo="two-columns"
  lang={lang}
  data-reset-message={t(
    "All recipes restored",
    "모든 요리법을 다시 표시합니다",
    "すべてのレシピに戻しました",
  )}
  data-results-label={t("recipes", "개 요리법", "件のレシピ")}
>
  <header>
    <span class="identity">
      {t("THE EVERYDAY TABLE", "매일의 식탁", "いつもの食卓")}
    </span>
    <h2>
      {t(
        "Good food. Any day.",
        "오늘도 맛있는 한 끼.",
        "いつもの日にも、おいしく。",
      )}
    </h2>
    <p>
      {t(
        "Find a recipe for what is in your kitchen.",
        "주방에 있는 재료로 만들 요리법을 찾아보세요.",
        "キッチンにある材料で作れるレシピを探しましょう。",
      )}
    </p>
  </header>
  <div class="workspace">
    <aside
      class="recipe-filters"
      aria-label={t("Recipe filters", "요리법 필터", "レシピの絞り込み")}
    >
      <h3>{t("On the menu", "오늘의 메뉴", "今日のメニュー")}</h3>
      <label>
        {t("Ingredient", "재료", "材料")}
        <select data-ingredient data-interactive disabled>
          <option value="all">
            {t("All ingredients", "모든 재료", "すべての材料")}
          </option>
          <option value="tomato">{t("Tomato", "토마토", "トマト")}</option>
          <option value="mushroom">{t("Mushroom", "버섯", "きのこ")}</option>
        </select>
      </label>
      <label>
        {t("Cooking time", "조리 시간", "調理時間")}
        <select data-time data-interactive disabled>
          <option value="all">
            {t("Any time", "시간 제한 없음", "指定なし")}
          </option>
          <option value="20">
            {t("20 minutes or less", "20분 이내", "20分以内")}
          </option>
          <option value="10">
            {t("10 minutes or less", "10분 이내", "10分以内")}
          </option>
        </select>
      </label>
      <button type="button" data-reset data-interactive disabled>
        {t("Clear filters", "필터 초기화", "絞り込みを解除")}
      </button>
      <p class="filter-note">
        {t(
          "Change the filters; keep the recipes in view.",
          "요리법을 보면서 필터를 바꿔보세요.",
          "レシピを見ながら条件を変えてみましょう。",
        )}
      </p>
    </aside>
    <div class="recipes">
      <div class="collection-heading">
        <h3>
          {t("From our kitchen", "주방에서 온 요리법", "キッチンからのレシピ")}
        </h3>
        <span data-count>4 / 4</span>
      </div>
      {recipes.map((recipe, i) => (
        <article
          data-recipe
          data-ingredient={recipe.ingredient}
          data-minutes={recipe.time}
        >
          {i === 0 && (
            <img
              {...photo("tomato-pasta.png")}
              alt={t(
                "Tomato and basil pasta in a ceramic bowl",
                "그릇에 담긴 토마토 바질 파스타",
                "器に盛ったトマトとバジルのパスタ",
              )}
              width="1536"
              height="1024"
            />
          )}
          <div class="recipe-copy">
            <span class="recipe-time">
              {recipe.time} {t("min", "분", "分")}
            </span>
            <h3>{recipe.title}</h3>
            <details>
              <summary>{t("Recipe notes", "요리 메모", "調理メモ")}</summary>
              <p>{recipe.note}</p>
            </details>
          </div>
        </article>
      ))}
      <p class="empty" data-empty hidden>
        {t(
          "No recipes match. Clear a filter to try again.",
          "조건에 맞는 요리법이 없습니다. 필터를 풀어 다시 찾아보세요.",
          "条件に合うレシピがありません。条件を解除して試してください。",
        )}
      </p>
    </div>
  </div>
  <p class="status" role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("two-columns", (root, say) => {
    const ingredient = root.querySelector<HTMLSelectElement>(
      "select[data-ingredient]",
    )!;
    const time = root.querySelector<HTMLSelectElement>("select[data-time]")!;
    const recipes = root.querySelectorAll<HTMLElement>("[data-recipe]");
    const update = () => {
      let count = 0;
      recipes.forEach((recipe) => {
        recipe.hidden =
          !(
            ingredient.value === "all" ||
            ingredient.value === recipe.dataset.ingredient
          ) ||
          !(
            time.value === "all" ||
            Number(recipe.dataset.minutes) <= Number(time.value)
          );
        if (!recipe.hidden) count++;
      });
      root.querySelector("[data-count]")!.textContent = `${count} / 4`;
      root.querySelector<HTMLElement>("[data-empty]")!.hidden = count !== 0;
      say(`${count} ${root.dataset.resultsLabel}`);
    };
    ingredient.addEventListener("change", update);
    time.addEventListener("change", update);
    return () => {
      ingredient.value = time.value = "all";
      root
        .querySelectorAll("details")
        .forEach((detail) => (detail.open = false));
      update();
    };
  });
</script>
<style>
  section {
    container-type: inline-size;
    padding: clamp(18px, 3vw, 32px);
    background: #faf7f0;
    color: #38352d;
    color-scheme: light;
    border: 1px solid #d8d0c2;
    border-radius: 6px;
    overflow-wrap: anywhere;
  }
  header {
    border-bottom: 1px solid #cfc7b9;
    padding-bottom: 22px;
    margin-bottom: 28px;
  }
  .identity {
    font-size: 0.7rem;
    letter-spacing: 0.17em;
    color: #6b4f35;
  }
  h2 {
    font-family: Georgia, serif;
    font-weight: 400;
    letter-spacing: -0.025em;
    font-size: clamp(1.7rem, 3.4vw, 2.8rem);
    margin: 16px 0 8px;
  }
  header p {
    font-size: 0.9rem;
    margin: 0;
  }
  .workspace {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) minmax(0, 2fr);
    gap: 28px;
    align-items: start;
  }
  .workspace > * {
    min-width: 0;
  }
  h3 {
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }
  .recipe-filters {
    padding: 0 20px 0 0;
    border-right: 1px solid #cfc7b9;
  }
  label {
    display: grid;
    gap: 10px;
    font-size: 0.82rem;
    font-weight: 600;
    margin: 24px 0;
  }
  select,
  button {
    max-width: 100%;
    width: 100%;
    min-height: 44px;
    padding: 10px;
    border: 1px solid #968978;
    border-radius: 3px;
    background: #fffdf8;
    color: #38352d;
    font-size: 0.85rem;
  }
  .filter-note {
    font-size: 0.8rem;
    color: #635c50;
    margin-top: 20px;
  }
  .collection-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .collection-heading span {
    font-size: 0.8rem;
    white-space: nowrap;
  }
  article {
    border-bottom: 1px solid #cfc7b9;
    padding: 18px 0;
  }
  article:first-of-type {
    padding-top: 0;
  }
  img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    margin-bottom: 18px;
  }
  article h3 {
    font-size: 1.2rem;
    margin: 8px 0;
  }
  .recipe-time {
    font-size: 0.75rem;
    color: #775131;
  }
  summary {
    min-height: 44px;
    padding: 10px 0;
    cursor: pointer;
    font-size: 0.85rem;
  }
  details p {
    font-size: 0.85rem;
    margin: 8px 0;
  }
  .empty {
    padding: 28px;
    background: #ece5d7;
  }
  .status {
    margin: 12px 0 0;
    font-size: 0.85rem;
  }
  .status:empty {
    display: none;
  }
  :focus-visible {
    outline: 3px solid #674b30;
    outline-offset: 3px;
  }
  @container (width < 520px) {
    .workspace {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .recipe-filters {
      border-right: 0;
      border-bottom: 1px solid #cfc7b9;
      padding: 0 0 20px;
    }
    label {
      margin: 16px 0;
    }
    .filter-note {
      display: none;
    }
    img {
      height: 180px;
    }
  }

  .workspace {
    grid-template-columns: minmax(150px, 0.55fr) minmax(0, 2fr);
    gap: 32px;
  }
  .recipe-filters {
    background: #e9e2d3;
    padding: 20px;
    border-right: 4px solid #7c6a51;
  }
  @container (width < 520px) {
    .workspace {
      grid-template-columns: 1fr;
    }
    .recipe-filters {
      border-right: 0;
      border-bottom: 4px solid #7c6a51;
    }
  }
</style>
