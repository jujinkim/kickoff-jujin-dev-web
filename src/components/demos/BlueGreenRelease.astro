---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { platformText } from "./platform";
import "./platform-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  p = platformText(lang);
---

<section
  data-demo="blue-green"
  data-platform
  lang={lang}
  data-reset-message={p.resetMessage}
>
  <header>
    <p class="eyebrow">{p.simulation}</p>
    <h2>
      {t("Blue-green switch", "블루·그린 전환", "ブルーグリーン切り替え")}
    </h2>
  </header>
  <p>
    {t(
      "Verify green, switch traffic, write A17, then simulate failure and switch back.",
      "그린 검증 → 트래픽 전환 → A17 저장 → 장애·복귀 순서로 진행합니다.",
      "グリーン検証 → 切り替え → A17保存 → 障害・復帰の順に進めます。",
    )}
  </p>
  <div class="controls">
    <button type="button" data-previous disabled>
      {p.previous}
    </button>
    <button type="button" data-next disabled>
      {p.next}
    </button>
    <button type="button" data-reset data-interactive disabled>
      {p.reset}
    </button>
  </div>
  <label>
    <input type="checkbox" data-fail-ready data-interactive disabled />
    {t("Fail verification", "검증 실패", "検証を失敗させる")}
  </label>
  <ol class="timeline">
    <li data-stage="0">
      {t(
        "Blue serves; verify green next",
        "블루 처리 중. 다음은 그린 검증",
        "ブルーが処理中。次はグリーン検証",
      )}
    </li>
    <li data-stage="1">
      {t(
        "Green verified; switch next",
        "그린 검증 완료. 다음은 전환",
        "グリーン検証済み。次は切り替え",
      )}
    </li>
    <li data-stage="2">
      {t(
        "Green serves; write or switch back",
        "그린 처리 중. 저장 또는 복귀",
        "グリーンが処理中。保存または復帰",
      )}
    </li>
    <li data-stage="3">
      {t(
        "Failure: traffic returned to blue",
        "장애: 블루로 트래픽 복귀",
        "障害：経路をブルーへ復帰",
      )}
    </li>
  </ol>
  <div class="environments">
    <section>
      <h3>{t("Blue", "블루", "ブルー")} · v1 × 4</h3>
      <strong data-blue-traffic>100%</strong>
      <p>{p.ready}</p>
    </section>
    <section>
      <h3>{t("Green", "그린", "グリーン")} · v2 × 4</h3>
      <strong data-green-traffic>0%</strong>
      <p data-green-state>{p.waiting}</p>
    </section>
  </div>
  <div class="controls">
    <button type="button" data-save disabled>
      {t("Save A17", "A17 저장", "A17を保存")}
    </button>
    <button type="button" data-rollback disabled>
      {t("Simulate failure and switch back", "장애·복귀", "障害・復帰")}
    </button>
  </div>
  <p class="current" data-current>
    {t(
      "Blue serves; verify green next",
      "블루 처리 중. 다음은 그린 검증",
      "ブルーが処理中。次はグリーン検証",
    )}
  </p>
  <aside class="data">
    <h3>{t("Shared store", "공유 저장소", "共有ストア")}</h3>
    <p>{p.compatible}</p>
    <p>
      {p.count}: <strong data-count>0</strong> ·{" "}
      <span data-records>{p.empty}</span>
    </p>
  </aside>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountBlueGreen } from "./release-behavior";
  mountBlueGreen();
</script>
<style>
  section {
    background: #f3f6fb;
    color: #172640;
    padding: clamp(16px, 3vw, 30px);
    border: 1px solid #8696ad;
    border-radius: 12px;
  }
  .eyebrow {
    color: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  header {
    border-bottom: 1px solid #aab7c9;
    margin-bottom: 1.2rem;
  }

  .data {
    padding: 18px;
    margin-top: 20px;
    border: 3px double #496552;
    background: #e9f2ed;
  }
  .current {
    padding: 16px;
    border-left: 4px solid #395882;
    background: #e1eaf8;
  }
  .timeline {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 0;
    list-style-position: inside;
  }
  .timeline li {
    padding: 12px;
    border: 1px solid #8493aa;
    flex: 1;
    min-width: 120px;
  }
  .metrics {
    font-variant-numeric: tabular-nums;
    font-size: 1.2rem;
  }
  .environments {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 24px 0;
  }
  .environments section {
    padding: 22px;
    border: 2px solid #416b96;
    background: #e6edf9;
  }
  .environments section + section {
    border-style: dashed;
    border-color: #446f51;
    background: #e7f1e8;
  }
  .environments strong {
    font-size: 2rem;
  }
  @container (max-width:560px) {
    .environments {
      grid-template-columns: 1fr;
    }
  }
</style>
