---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { moneyText } from "./monetization";
import "./monetization-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  m = moneyText(lang);
---

<section
  data-demo="consumable-purchase"
  data-money
  lang={lang}
  data-reset-message={m.resetMessage}
>
  <header>
    <p class="eyebrow">{m.fiction}</p>
    <h2>{t("Consumable purchase", "소모성 구매", "消耗型購入")}</h2>
  </header>
  <p>
    {m.puzzle} ·{" "}
    {t(
      "No purchased items initially",
      "처음에는 구매한 항목 없음",
      "最初は購入済みアイテムなし",
    )}
  </p>
  <div class="purchase-scene">
    <div class="puzzle-board" aria-hidden="true">
      <span>1</span>
      <span>2</span>
      <span>3</span>
      <span>4</span>
      <span>5</span>
      <span>6</span>
      <span>7</span>
      <span>8</span>
      <span>0</span>
    </div>
    <div class="inventory">
      <h3>{m.hints}</h3>
      <output data-inventory>0</output>
      <p>
        {m.purchases}: <b data-purchases>0</b>
      </p>
    </div>
  </div>
  <div class="controls">
    <button type="button" data-buy data-interactive disabled>
      {t(
        "Buy 3 hints (simulated)",
        "힌트 3개 구매 (가상)",
        "ヒント3個を購入（仮）",
      )}
    </button>
    <button type="button" data-use data-interactive disabled>
      {t("Use one hint", "힌트 1개 사용", "ヒントを1個使う")}
    </button>
  </div>
  <p>
    {t("Uses completed", "완료한 사용", "使用完了回数")}: <b data-uses>0</b>
  </p>
  <p>
    {t(
      "Each hint use deducts one. At zero, use is blocked; another purchase adds three.",
      "힌트를 사용하면 1개 차감합니다. 0개이면 차단하고 재구매하면 3개를 추가합니다.",
      "ヒント使用で1個減ります。0個では止め、再購入で3個増えます。",
    )}
  </p>
  <p class="assumptions">
    {t(
      "No real purchase. Prices, taxes, fees and refunds omitted.",
      "실제 구매가 아닙니다. 가격·세금·수수료·환불은 생략했습니다.",
      "実際の購入ではありません。価格・税金・手数料・返金は省略しています。",
    )}
  </p>
  <div class="controls">
    <button type="button" data-reset data-interactive disabled>
      {m.reset}
    </button>
  </div>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountPurchase } from "./monetization-purchase";
  mountPurchase("consumable-purchase", true);
</script>
<style>
  .purchase-scene {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: center;
  }
  .puzzle-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
    background: #fff;
    padding: 0.8rem;
    border: 2px solid #52766e;
  }
  .puzzle-board span {
    padding: 0.5rem;
    text-align: center;
    border: 1px solid #52766e;
  }
  .inventory {
    padding: 1rem;
    border: 2px dashed #52766e;
  }
  [data-applied="true"] .puzzle-board {
    background: #203843;
    color: #fff;
  }
  [data-applied="true"] .puzzle-board span {
    border-color: #aec6c7;
  }
  @container (max-width:450px) {
    .purchase-scene {
      grid-template-columns: 1fr;
    }
  }
</style>
