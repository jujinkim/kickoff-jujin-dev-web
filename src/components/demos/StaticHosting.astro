---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { platformText } from "./platform";
import "./platform-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  p = platformText(lang);
const item = t("Community Newsletter", "동네 소식지", "地域の便り");
const reader = t("Mina", "민아", "美奈");
---

<section
  data-demo="static-hosting"
  data-platform
  data-record-label={`${reader} / ${item}`}
  lang={lang}
  data-reset-message={p.resetMessage}
  data-read-path={t(
    "Browser → public host → article HTML",
    "브라우저 → 공개 호스트 → 글 HTML",
    "ブラウザー → 公開ホスト → 記事HTML",
  )}
  data-save-path={t(
    "Browser → separate Save API → external store → acknowledged.",
    "브라우저 → 별도 저장 API → 외부 저장소 → 확인 응답.",
    "ブラウザー → 別の保存API → 外部ストア → 確認応答。",
  )}
>
  <header>
    <p class="eyebrow">{p.simulation}</p>
    <h2>{t("Static hosting", "정적 호스팅", "静的ホスティング")}</h2>
  </header>
  <p>
    {t(
      "Read the public article, then save Community Newsletter. Repeated requests share Mina / Community Newsletter.",
      "공개 글을 읽고 동네 소식지를 저장하세요. 반복 요청은 민아 / 동네 소식지를 공유합니다.",
      "公開記事を読み、地域の便りを保存します。再送も美奈 / 地域の便りを共有します。",
    )}
  </p>
  <div class="controls">
    <button type="button" data-read data-interactive disabled>
      {t("Read article", "글 읽기", "記事を読む")}
    </button>
    <button type="button" data-save data-interactive disabled>
      {t("Save Community Newsletter", "동네 소식지 저장", "地域の便りを保存")}
    </button>
    <button type="button" data-restart data-interactive disabled>
      {t("Restart handler", "처리기 재시작", "処理器を再起動")}
    </button>
    <button type="button" data-reset data-interactive disabled>
      {p.reset}
    </button>
  </div>
  <label>
    <input type="checkbox" data-fail-save data-interactive disabled />
    {t("Fail next save", "다음 저장 실패", "次の保存を失敗させる")}
  </label>
  <div class="lanes">
    <section>
      <h3>01 · GET</h3>
      <p>
        {t(
          "Browser → public host → article HTML",
          "브라우저 → 공개 호스트 → 글 HTML",
          "ブラウザー → 公開ホスト → 記事HTML",
        )}
      </p>
      <p>HTML · CSS · JavaScript</p>
    </section>
    <section class="api">
      <h3>02 · POST {item}</h3>
      <p>
        {t(
          "Browser → separate Save API → external store → acknowledged.",
          "브라우저 → 별도 저장 API → 외부 저장소 → 확인 응답.",
          "ブラウザー → 別の保存API → 外部ストア → 確認応答。",
        )}
      </p>
      <p>
        {t("Execution generation", "실행 세대", "実行世代")}:{" "}
        <span data-generation>1</span> ·{" "}
        {t("Calls in this generation", "이 세대의 호출", "この世代の呼び出し")}:{" "}
        <span data-calls>0</span>
      </p>
    </section>
  </div>
  <aside class="store">
    <h3>03 · {p.store}</h3>
    <p>
      {reader} / {item} →{" "}
      {t("one key, one record", "키 하나, 기록 하나", "1キー、1記録")}
    </p>
    <p>
      {p.count}: <strong data-count>0</strong> ·{" "}
      <span data-records>{p.empty}</span>
    </p>
  </aside>
  <p class="trace" data-path-state>
    {p.waiting}
  </p>
  <p class="note">
    {t(
      "The store is simulated in page memory. Restart preserves it; Reset or reload clears it. Deduplication is authored application logic.",
      "저장소도 페이지 메모리의 모형입니다. 재시작은 유지하고 초기화·새로고침은 지웁니다. 중복 방지는 직접 작성한 앱 로직입니다.",
      "ストアもページメモリ上の模型です。再起動では残り、リセット・再読み込みで消えます。重複防止は独自のアプリ処理です。",
    )}
  </p>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountHosting } from "./hosting-behavior";
  mountHosting("static-hosting");
</script>
<style>
  section {
    background: #f3f6fb;
    color: #172640;
    padding: clamp(16px, 3vw, 30px);
    border: 1px solid #8696ad;
    border-radius: 12px;
  }
  .eyebrow {
    color: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  header {
    border-bottom: 1px solid #aab7c9;
    margin-bottom: 1.2rem;
  }

  .lanes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 24px 0;
  }
  .lanes section {
    padding: 18px;
    border: 1px solid #6e829e;
    background: #fff;
  }
  .store {
    padding: 20px;
    border: 3px double #536c58;
    background: #ebf3ed;
    margin: 20px 0;
  }
  .trace {
    padding: 14px;
    border-left: 4px solid #496188;
    background: #e0e9f6;
  }
  .note {
    font-size: 0.85rem;
  }
  .runtime {
    border: 2px dashed #486086;
    padding: 18px;
    margin: 20px 0;
  }
  @container (max-width:560px) {
    .lanes {
      grid-template-columns: 1fr;
    }
  }
  .lanes .api {
    border: 2px dashed #7b5781;
  }
</style>
