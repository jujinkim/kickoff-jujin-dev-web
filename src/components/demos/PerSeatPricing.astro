---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { moneyText } from "./monetization";
import "./monetization-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  m = moneyText(lang, "per-seat-pricing");
---

<section
  data-demo="per-seat-pricing"
  data-money
  lang={lang}
  data-reset-message={m.resetMessage}
>
  <header>
    <p class="eyebrow">{m.fiction}</p>
    <h2>{t("Per-seat pricing", "좌석 과금", "席数課金")}</h2>
  </header>
  <p>{m.baseline}</p>
  <div class="seat-plan">
    <div class="licenses">
      <p>
        {t("8 per licensed seat / month", "월 이용 좌석당 8", "月額1席あたり8")}
      </p>
      <div
        class="quantity-cases"
        role="group"
        aria-label={t(
          "Compare low and high use",
          "적은 이용과 많은 이용 비교",
          "少ない利用と多い利用を比較",
        )}
      >
        <button
          type="button"
          data-quantity-preset="1"
          data-interactive
          disabled
        >
          <span>{t("Quantity", "수량", "数量")} 1</span>
          <strong>→ 8.00</strong>
        </button>
        <button
          type="button"
          data-quantity-preset="3"
          data-interactive
          disabled
        >
          <span>{t("Quantity", "수량", "数量")} 3</span>
          <strong>→ 24.00</strong>
        </button>
        <button
          type="button"
          data-quantity-preset="30"
          data-interactive
          disabled
        >
          <span>{t("Quantity", "수량", "数量")} 30</span>
          <strong>→ 240.00</strong>
        </button>
      </div>
      <label>
        {m.seats}
        <input
          type="number"
          min="0"
          max="10000"
          step="1"
          value="3"
          data-quantity
          data-interactive
          disabled
        />
      </label>
      <div class="controls">
        <button type="button" data-less data-interactive disabled>
          {t("Remove one", "1 감소", "1減らす")}
        </button>
        <button type="button" data-more data-interactive disabled>
          {t("Add one", "1 추가", "1増やす")}
        </button>
      </div>
    </div>
    <div class="result">
      <span>{m.total}</span>
      <output data-total>24.00</output>
      <p data-formula>3 × 8.00 = 24.00</p>
    </div>
  </div>
  <p>
    {t(
      "Exports do not change this price. Proration omitted.",
      "내보내기 횟수는 가격에 영향을 주지 않습니다. 일할 계산은 생략했습니다.",
      "出力回数は価格に影響しません。日割りは省略しています。",
    )}
  </p>
  <p class="assumptions">{m.omitted}</p>
  <div class="controls">
    <button type="button" data-reset data-interactive disabled>
      {m.reset}
    </button>
  </div>
  <p data-contract-context class="contract-context">
    {t(
      "The clinic pays 8 per licensed seat each month: three seats cost 24 and four cost 32. Export count does not change this formula. Zero seats quote zero here; activation requirements remain outside the model.",
      "진료소는 이용 좌석당 월 8을 내므로 3좌석은 24, 4좌석은 32입니다. 출력 수는 산식을 바꾸지 않습니다. 예제의 0좌석 견적은 0이며 개통 요건은 모형 밖입니다.",
      "診療所は利用席ごとに月8を払い、3席は24、4席は32です。出力回数は式に影響しません。例の0席は0ですが、開通要件は模型の対象外です。",
    )}
  </p>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountPricing } from "./monetization-pricing";
  mountPricing("per-seat-pricing", 3);
</script>
<style>
  .seat-plan {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .licenses {
    border: 2px solid #52766e;
    padding: 1rem;
    background: #fff;
  }
  @container (max-width:480px) {
    .seat-plan {
      grid-template-columns: 1fr;
    }
  }
  .result {
    background: #e1ece8;
    border: 2px solid #52766e;
    padding: 1rem;
    margin: 1rem 0;
  }
  .result p {
    margin-bottom: 0;
  }

  .quantity-cases {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0;
  }
  .quantity-cases button {
    flex: 1 1 130px;
    display: grid;
    gap: 8px;
    padding: 18px;
    border: 2px solid currentColor;
    text-align: left;
  }
  .quantity-cases strong {
    font-size: 1.5rem;
  }
  .result output {
    font-size: clamp(2.5rem, 7cqi, 4rem);
    font-weight: 800;
  }

  .licenses {
    border: 4px solid #446379;
    padding: 24px;
  }
  .seat-plan {
    border-bottom: 6px solid #446379;
    padding-bottom: 22px;
  }
</style>
