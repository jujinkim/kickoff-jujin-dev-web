---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { photo } from "./photos";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const routes = [
  {
    title: t("Along the lake", "호숫가 산책", "湖畔の散歩"),
    distance: "2.4 km",
    time: t("45 min", "45분", "45分"),
    description: t(
      "A gentle shoreline path, with a quiet spot for morning reflections.",
      "아침 햇살이 비치는 잔잔한 호수를 따라 걷는 완만한 길입니다.",
      "朝の光が映る静かな湖に沿って歩く、緩やかな道です。",
    ),
  },
  {
    title: t("Into the pines", "소나무 숲길", "松林の小道"),
    distance: "4.1 km",
    time: t("80 min", "80분", "80分"),
    description: t(
      "A longer climb through the trees, ending at a view across the water.",
      "나무 사이로 조금 더 길게 올라가 호수 전망을 만나는 길입니다.",
      "木々の間を少し長く登り、水面を見渡す道です。",
    ),
  },
];
---

<section
  data-demo="glassmorphism"
  lang={lang}
  data-reset-message={t(
    "Lake route restored",
    "호숫가 경로로 복원했습니다",
    "湖畔のルートに戻しました",
  )}
>
  <img
    class="landscape"
    {...photo("lake-walk.png")}
    alt={t(
      "A mountain lake with a shoreline path and pine trees",
      "산과 소나무 사이 호숫가 산책로",
      "山と松林に囲まれた湖畔の小道",
    )}
    width="1536"
    height="1024"
  />
  <div class="scene-content">
    <header class="glass">
      <span class="identity">
        {t("WANDER / PHOTO WALKS", "WANDER / 사진 산책", "WANDER / 写真散歩")}
      </span>
      <span aria-hidden="true">↗</span>
    </header>
    <div class="scene-space" aria-hidden="true"></div>
    <div class="glass route-card">
      <p class="edition">
        {t("FIELD NOTES · 01", "산책 기록 · 01", "散歩の記録 · 01")}
      </p>
      <h2>
        {t(
          "A little closer to nature.",
          "자연에 조금 더 가까이.",
          "自然に、もう少し近く。",
        )}
      </h2>
      <div
        class="route-options"
        role="group"
        aria-label={t("Walking route", "산책 경로", "散歩ルート")}
      >
        {routes.map((route, i) => (
          <button
            type="button"
            data-route={i}
            aria-pressed={i === 0 ? "true" : "false"}
            data-interactive
            disabled
          >
            {route.title}
          </button>
        ))}
      </div>
      {routes.map((route, i) => (
        <div data-route-panel={i} hidden={i !== 0}>
          <h3>{route.title}</h3>
          <p>{route.description}</p>
          <div class="route-meta">
            <strong>{route.distance}</strong>
            <span>{route.time}</span>
            <span>{t("Fictional route", "가상의 경로", "架空のルート")}</span>
          </div>
        </div>
      ))}
    </div>
    <footer class="glass">
      <label>
        <input type="checkbox" data-opaque data-interactive disabled />
        {t("Opaque panels", "불투명 패널", "不透明パネル")}
      </label>
      <button type="button" data-reset data-interactive disabled>
        {t("Reset", "초기화", "リセット")}
      </button>
      <p role="status" aria-live="polite" aria-atomic="true"></p>
    </footer>
  </div>
</section>
<script>
  import { mount } from "./shared";
  mount("glassmorphism", (root, say) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-route]");
    const opaque = root.querySelector<HTMLInputElement>("input[data-opaque]")!;
    const select = (index: string) => {
      buttons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.route === index),
        ),
      );
      root
        .querySelectorAll<HTMLElement>("[data-route-panel]")
        .forEach(
          (panel) => (panel.hidden = panel.dataset.routePanel !== index),
        );
    };
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        select(button.dataset.route!);
        say(button.textContent!.trim());
      }),
    );
    opaque.addEventListener(
      "change",
      () => (root.dataset.opaque = String(opaque.checked)),
    );
    return () => {
      select("0");
      opaque.checked = false;
      root.dataset.opaque = "false";
    };
  });
</script>
<style>
  section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #152c30;
    color-scheme: light;
    background: #9bc2d0;
    border-radius: 8px;
    container-type: inline-size;
  }
  .landscape {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    inset: 0;
    z-index: -1;
  }
  .scene-content {
    padding: clamp(16px, 4vw, 36px);
  }
  .glass {
    background: rgb(255 255 255 / 58%);
    border: 1px solid #ffffffa6;
    border-radius: 14px;
    backdrop-filter: blur(10px) saturate(1.35);
    box-shadow:
      inset 0 1px 0 #ffffffe6,
      inset 0 -1px 0 #ffffff33,
      0 12px 32px #0929323d;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 22px;
  }
  .identity {
    font-size: 0.8rem;
    letter-spacing: 0.09em;
    font-weight: 700;
  }
  .scene-space {
    height: 130px;
  }
  .route-card {
    max-width: 490px;
    padding: clamp(20px, 3vw, 32px);
  }
  .edition {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
  }
  h2 {
    font-family: Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.12;
    margin: 0 0 24px;
    letter-spacing: -0.035em;
  }
  h3 {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
    color: inherit;
  }
  p {
    line-height: 1.65;
    font-size: 0.9rem;
  }
  .route-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  button {
    padding: 10px 14px;
    min-height: 44px;
    border: 1px solid #63777b;
    border-radius: 8px;
    background: #f8ffff;
    color: #152c30;
    font-size: 0.85rem;
  }
  button[aria-pressed="true"] {
    color: white;
    background: #244c4f;
    border-color: #244c4f;
  }
  .route-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 22px;
    padding-top: 14px;
    border-top: 1px solid #829a9e;
    font-size: 0.8rem;
  }
  .route-meta strong {
    font-size: 1.5rem;
    font-weight: 500;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    padding: 12px 18px;
    margin-top: 18px;
  }
  footer label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    min-height: 44px;
  }
  input {
    width: 20px;
    height: 20px;
    accent-color: #244c4f;
  }
  footer button {
    margin-left: auto;
  }
  [role="status"] {
    flex: 1 1 100%;
    font-size: 0.8rem;
    margin: 0;
  }
  [role="status"]:empty {
    display: none;
  }
  :focus-visible {
    outline: 3px solid #152c30;
    outline-offset: 3px;
  }
  section[data-opaque="true"] .glass {
    background: #f1f7f6;
    backdrop-filter: none;
  }
  @media (prefers-reduced-transparency: reduce) {
    .glass {
      background: #f1f7f6;
      backdrop-filter: none;
    }
  }
  @media (forced-colors: active) {
    .glass {
      background: Canvas;
      border: 1px solid CanvasText;
      color: CanvasText;
      backdrop-filter: none;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  @container (width < 400px) {
    .scene-space {
      height: 70px;
    }
    .route-card {
      padding: 20px;
    }
    .route-options button {
      width: 100%;
    }
  }

  .glass {
    backdrop-filter: blur(24px) saturate(1.35);
    background: rgb(255 255 255 / 62%);
    border-radius: 8px;
    border: 1px solid #ffffffd9;
  }
  .route-card {
    border-left: 8px solid #ffffffb8;
  }
  section[data-opaque="true"] .glass {
    backdrop-filter: none;
    background: #f4f8f7;
  }
  @supports not (backdrop-filter: blur(1px)) {
    .glass {
      background: #f4f8f7;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .glass {
      backdrop-filter: none;
      background: #f4f8f7;
    }
  }
  @media (forced-colors: active) {
    .glass {
      background: Canvas;
      border-color: CanvasText;
      backdrop-filter: none;
    }
  }
</style>
