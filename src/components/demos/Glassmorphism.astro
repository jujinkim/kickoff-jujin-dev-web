---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
---

<section
  class="demo"
  data-demo="glassmorphism"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <div class="orb" aria-hidden="true"></div>
  <div class="glass">
    <small>
      {t("LOCAL WEATHER / DEMO", "지역 날씨 / 데모", "地域の天気 / デモ")}
    </small>
    <h2>{t("Seoul", "서울", "ソウル")}</h2>
    <p class="temperature">23°</p>
    <p>
      {t("Clear skies · Feels like 24°", "맑음 · 체감 24°", "晴れ · 体感24°")}
    </p>
    <div class="forecast">
      <span>
        12:00
        <br />
        24°
      </span>
      <span>
        15:00
        <br />
        25°
      </span>
      <span>
        18:00
        <br />
        22°
      </span>
    </div>
  </div>
  <div class="controls glass">
    <label>
      <input type="checkbox" data-night data-interactive disabled />
      {t("Night", "밤", "夜")}
    </label>
    <label>
      <input type="checkbox" data-opaque data-interactive disabled />
      {t("Opaque panels", "불투명 패널", "不透明パネル")}
    </label>
  </div>

  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("glassmorphism", (root, say) => {
    const night = root.querySelector<HTMLInputElement>("[data-night]")!,
      opaque = root.querySelector<HTMLInputElement>("[data-opaque]")!;
    const update = () => {
      root.dataset.night = String(night.checked);
      root.dataset.opaque = String(opaque.checked);
      say(
        [night, opaque]
          .map(
            (x) =>
              `${x.parentElement!.textContent!.trim()}: ${x.checked ? "✓" : "—"}`,
          )
          .join(" · "),
      );
    };
    night.addEventListener("change", update);
    opaque.addEventListener("change", update);
    return () => {
      night.checked = false;
      opaque.checked = false;
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  .demo * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.12;
  }
  h3 {
    font-size: 1.2rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  button,
  select,
  input,
  textarea {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]):not([type="range"]) {
    min-height: 44px;
    padding: 8px 12px;
  }
  button,
  select {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  input,
  textarea,
  select {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  [role="status"] {
    background: #fff;
    border-radius: 4px;
  }
  [role="status"]:empty {
    background: transparent;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
      animation: none !important;
    }
  }
  .demo {
    isolation: isolate;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #568eb3, #d9b3cf 55%, #f4c47c);
    color: #162635;
    border-radius: 22px;
  }
  .demo[data-night="true"] {
    background: linear-gradient(130deg, #172749, #535486, #885c80);
  }
  .orb {
    position: absolute;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: #fff1ba;
    right: 0;
    max-width: 100%;
    top: 15px;
    z-index: -1;
    box-shadow: 0 0 70px #ffedc4;
  }
  .demo[data-night="true"] .orb {
    background: #b6c6ff;
    box-shadow: 0 0 50px #9eade0;
  }
  .glass {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid #fff;
    border-radius: 20px;
    padding: 24px;
    backdrop-filter: blur(18px);
    box-shadow:
      0 16px 40px #1f345328,
      inset 0 1px 1px #fff;
  }
  .temperature {
    font-size: 6rem;
    line-height: 1.2;
  }
  .forecast {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .demo[data-opaque="true"] .glass {
    background: #fff;
    backdrop-filter: none;
  }
  [role="status"] {
    background: #fff;
    border-radius: 4px;
  }
  .reset {
    background: #fff;
  }
  @supports not (backdrop-filter: blur(1px)) {
    .glass {
      background: #fff;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .glass {
      background: #fff;
      backdrop-filter: none;
    }
  }
</style>
