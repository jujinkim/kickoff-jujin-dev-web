---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { platformText } from "./platform";
import "./platform-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  p = platformText(lang);
---

<section
  data-demo="svelte"
  data-platform
  lang={lang}
  data-reset-message={p.resetMessage}
  data-update-path={t(
    "Event → runtime state → compiled update",
    "이벤트 → 실행 중 상태 → 컴파일된 갱신",
    "イベント → 実行中の状態 → コンパイル済み更新",
  )}
>
  <header>
    <p class="eyebrow">{p.simulation}</p>
    <h2>Svelte</h2>
  </header>
  <p>
    {t(
      "Save either card. Each card counts once; the other card stays unchanged.",
      "각 카드를 저장하세요. 카드마다 한 번만 집계하며 다른 카드 상태는 유지됩니다.",
      "各カードを保存します。カードごとに1回だけ数え、もう一方は変わりません。",
    )}
  </p>
  <div class="compile">
    <h3>
      01 ·{" "}
      {t(
        "Build: compile component",
        "빌드: 컴포넌트 컴파일",
        "ビルド：コンポーネントのコンパイル",
      )}
    </h3>
    <p>
      HTML + CSS + JavaScript →{" "}
      {t("browser code", "브라우저 코드", "ブラウザーコード")}
    </p>
  </div>
  <div class="runtime">
    <h3>
      02 ·{" "}
      {t(
        "Browser runtime: later clicks",
        "브라우저 실행: 이후 클릭",
        "ブラウザー実行：後のクリック",
      )}
    </h3>
    <div class="cards">
      <article>
        <p>{t("Bus Timetable", "버스 시간표", "バス時刻表")}</p>
        <h3>{t("Trip planner", "여행 계획", "旅行計画")}</h3>
        <button
          type="button"
          data-save="Bus Timetable"
          data-label={t("Bus Timetable", "버스 시간표", "バス時刻表")}
          aria-pressed="false"
          data-interactive
          disabled
        >
          {p.save}
        </button>
      </article>
      <article>
        <p>{t("Hiking Route", "등산 경로", "登山ルート")}</p>
        <h3>{t("Trip planner", "여행 계획", "旅行計画")}</h3>
        <button
          type="button"
          data-save="Hiking Route"
          data-label={t("Hiking Route", "등산 경로", "登山ルート")}
          aria-pressed="false"
          data-interactive
          disabled
        >
          {p.save}
        </button>
      </article>
    </div>
    <p>
      {t(
        "Event → runtime state → compiled update",
        "이벤트 → 실행 중 상태 → 컴파일된 갱신",
        "イベント → 実行中の状態 → コンパイル済み更新",
      )}
    </p>
  </div>
  <p class="total">
    {p.count}: <strong data-count>0</strong> / 2
  </p>
  <p data-state>
    {t("Bus Timetable", "버스 시간표", "バス時刻表")}: 0 ·{" "}
    {t("Hiking Route", "등산 경로", "登山ルート")}: 0
  </p>
  <p class="trace" data-path-state>
    {p.waiting}
  </p>
  <div class="controls">
    <button type="button" data-reset data-interactive disabled>
      {p.reset}
    </button>
  </div>
  <dl class="runtime-facts" data-runtime-facts>
    <dt>{t("Execution boundary", "실행 경계", "実行境界")}</dt>
    <dd>
      {t(
        "Model: components compile before use; later browser events still update state at runtime.",
        "모형: 컴포넌트는 미리 컴파일하지만 이후 브라우저 이벤트도 실행 중 상태를 바꿉니다.",
        "模型：コンポーネントを先にコンパイルしても、後のイベントは実行時に状態を変えます。",
      )}
    </dd>
    <dt>{t("State and responsibility", "상태와 책임", "状態と責任")}</dt>
    <dd>
      {t(
        "Shared records own the total until reload. This explanation does not load the Svelte runtime.",
        "공유 기록이 새로고침 전까지 합계를 소유합니다. 설명 모형은 Svelte 런타임을 로드하지 않습니다.",
        "共通記録が再読み込みまで合計を持ちます。この説明はSvelteランタイムを読み込みません。",
      )}
    </dd>
  </dl>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountUi } from "./ui-behavior";
  mountUi("svelte");
</script>
<style>
  section {
    background: #f3f6fb;
    color: #172640;
    padding: clamp(16px, 3vw, 30px);
    border: 1px solid #8696ad;
    border-radius: 12px;
  }
  .eyebrow {
    color: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  header {
    border-bottom: 1px solid #aab7c9;
    margin-bottom: 1.2rem;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 20px 0;
  }
  .cards article {
    padding: 20px;
    border: 1px solid #74869e;
    background: white;
    border-radius: 8px;
  }
  .total {
    font-size: 1.3rem;
    font-weight: 700;
  }
  .trace {
    border-left: 4px solid #395783;
    padding: 12px;
    background: #e0eaf7;
  }
  .flow {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style-position: inside;
  }
  .flow li {
    padding: 14px;
    border: 1px solid #7889a2;
  }
  @container (max-width:560px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .compile {
    padding: 20px;
    background: #fff0e7;
    border: 2px dashed #985437;
    margin-bottom: 18px;
  }
  .runtime {
    padding: 16px;
    border: 2px solid #985437;
    border-radius: 12px;
  }
  .runtime-facts {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 2fr);
    gap: 10px 16px;
    border-block: 1px solid currentColor;
    padding: 18px 0;
    margin: 18px 0;
    font-size: 0.85rem;
  }
  .runtime-facts dt {
    font-weight: 700;
  }
  .runtime-facts dd {
    margin: 0;
    min-width: 0;
  }
  @container (width<480px) {
    .runtime-facts {
      grid-template-columns: 1fr;
    }
  }

  .compile {
    border: 5px solid #88503c;
    padding: 26px;
    margin-bottom: 42px;
    position: relative;
  }
  .compile::after {
    content: "↓";
    position: absolute;
    bottom: -44px;
    left: 48%;
    font-size: 2rem;
    font-weight: 900;
  }
  .runtime {
    border: 5px dashed #88503c;
    padding: 26px;
  }
  .runtime > h3,
  .compile > h3 {
    font-size: 1.4rem;
  }
  .total strong {
    font-size: 3rem;
  }
</style>
