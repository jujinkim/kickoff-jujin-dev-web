---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { moneyText } from "./monetization";
import "./monetization-controls.css";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  m = moneyText(lang, "usage-based");
---

<section
  data-demo="usage-based"
  data-money
  lang={lang}
  data-reset-message={m.resetMessage}
>
  <header>
    <p class="eyebrow">{m.fiction}</p>
    <h2>{t("Usage-based billing", "사용량 기반 과금", "従量課金")}</h2>
  </header>
  <p>{m.billing}</p>
  <div class="meter">
    <h3>
      {t(
        "Month 1 · 0.02 per export",
        "첫 달 · 내보내기당 0.02",
        "1か月目 · 出力1回0.02",
      )}
    </h3>
    <label>
      {m.exports}
      <input
        type="number"
        min="0"
        max="10000"
        step="1"
        value="100"
        data-quantity
        data-interactive
        disabled
      />
    </label>
    <div class="controls">
      <button type="button" data-less data-interactive disabled>
        {t("Remove one", "1 감소", "1減らす")}
      </button>
      <button type="button" data-more data-interactive disabled>
        {t("Add one", "1 추가", "1増やす")}
      </button>
    </div>
  </div>
  <ol class="ledger">
    <li>
      {m.month} 1: <b data-month-charge>2.00</b>
    </li>
    <li>{m.month} 2: 300 × 0.02 = 6.00</li>
    <li>{m.month} 3: 600 × 0.02 = 12.00</li>
  </ol>
  <div class="result">
    <span>{m.total}</span>
    <output data-total>20.00</output>
    <p data-formula>100 × 0.02 + 6.00 + 12.00 = 20.00</p>
  </div>
  <p class="assumptions">{m.omitted}</p>
  <div class="controls">
    <button type="button" data-reset data-interactive disabled>
      {m.reset}
    </button>
  </div>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountPricing } from "./monetization-pricing";
  mountPricing("usage-based", 100);
</script>
<style>
  .meter {
    background: #fff;
    border-left: 5px solid #52766e;
    padding: 1rem;
  }
  .ledger {
    padding-left: 1.4rem;
  }
  .ledger li {
    padding: 0.7rem 0;
    border-bottom: 1px solid #a5b7b2;
  }
  .result {
    background: #e1ece8;
    border: 2px solid #52766e;
    padding: 1rem;
    margin: 1rem 0;
  }
  .result p {
    margin-bottom: 0;
  }
</style>
