---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
import "./fonts.css";
---

<section
  class="demo"
  data-demo="proportional"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <small>NOTO SANS / {t("TYPE LAB", "조판 실험실", "組版実験室")}</small>
  <h2>{t("Letters take space", "글자가 차지하는 공간", "文字が占める空間")}</h2>
  <label>
    {t("Specimen", "표본", "見本")}
    <input
      data-text
      type="text"
      maxlength="60"
      value="iiiWWW 0123"
      data-interactive
      disabled
    />
  </label>
  <div class="sample" data-sample>
    iiiWWW 0123
  </div>
  <p class="measurement" data-measure>
    {t(
      "Measured advances appear after fonts load.",
      "글꼴 로드 후 전진 폭을 표시합니다.",
      "書体の読み込み後に送り幅を表示します。",
    )}
  </p>
  <div class="numbers">
    <span>111.11</span>
    <span>888.88</span>
    <span>123.45</span>
  </div>
  <div class="controls">
    <label>
      <input type="checkbox" data-guides data-interactive disabled />
      {t("Advance guides", "전진 폭 가이드", "送り幅ガイド")}
    </label>
    <label>
      <input type="checkbox" data-tabular data-interactive disabled />
      {t("Tabular digits", "숫자 열 정렬", "等幅数字")}
    </label>
  </div>
  <p class="font-note">
    {t(
      "Widths below are measured, not estimated from outlines. This Latin font does not promise equal widths for CJK, emoji, or fallback glyphs.",
      "아래 폭은 윤곽 추정이 아닌 실측입니다. 이 라틴 글꼴은 한·일 문자, 이모지, 대체 글꼴의 동일 폭을 보장하지 않습니다.",
      "幅は輪郭からの推測ではなく実測です。このラテン書体はCJK、絵文字、代替文字の等幅を保証しません。",
    )}
  </p>

  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("proportional", (root, say) => {
    const input = root.querySelector<HTMLInputElement>("[data-text]")!,
      guides = root.querySelector<HTMLInputElement>("[data-guides]")!,
      sample = root.querySelector<HTMLElement>("[data-sample]")!;
    const tabular = root.querySelector<HTMLInputElement>("input[data-tabular]");
    const measure = () => {
      const range = document.createRange();
      const widths = [...sample.childNodes].map((node) => {
        range.selectNodeContents(node);
        return range.getBoundingClientRect().width.toFixed(2);
      });
      root.querySelector("[data-measure]")!.textContent =
        `${widths.join(" / ")} px`;
    };
    const update = () => {
      sample.replaceChildren(
        ...Array.from(input.value).map((char) => {
          const span = document.createElement("span");
          span.textContent = char;
          return span;
        }),
      );
      sample.classList.toggle("guides", guides.checked);
      const numbers = root.querySelector<HTMLElement>(".numbers");
      if (numbers && tabular) numbers.dataset.tabular = String(tabular.checked);
      measure();
      say(
        `${input.value.length} / 60 · ${guides.parentElement!.textContent}: ${guides.checked ? "✓" : "—"}`,
      );
    };
    input.addEventListener("input", update);
    guides.addEventListener("change", update);
    tabular?.addEventListener("change", update);
    document.fonts.ready.then(() => {
      update();
      say("");
    });
    return () => {
      input.value = "iiiWWW 0123";
      guides.checked = false;
      if (tabular) tabular.checked = false;
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  .demo * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.12;
  }
  h3 {
    font-size: 1.2rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  button,
  select,
  input,
  textarea {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]):not([type="range"]) {
    min-height: 44px;
    padding: 8px 12px;
  }
  button,
  select {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  input,
  textarea,
  select {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
      animation: none !important;
    }
  }
  .demo {
    background: #f8f4e9;
    color: #353a35;
  }
  h2 {
    font-size: 2rem;
  }
  .sample {
    font-family: "Demo Sans", monospace;
    font-size: 32px;
    line-height: 2;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 24px 0;
    min-height: 64px;
  }
  .sample:global(.guides) {
    background-image: linear-gradient(#ffffff08, #ffffff08);
  }
  .sample :global(span) {
    display: inline;
  }
  .sample:global(.guides) :global(span) {
    outline: 1px solid #b29c76;
    background: #e7daba66;
  }
  .measurement {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .numbers {
    font-family: "Demo Sans", sans-serif;
    font-size: 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-variant-numeric: proportional-nums;
  }
  .numbers[data-tabular="true"] {
    font-variant-numeric: tabular-nums;
  }
  .code {
    font-family: "Demo Mono", monospace;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    border-top: 1px solid #82958b;
    padding-top: 20px;
    font-size: 16px;
    background: transparent;
    color: inherit;
  }
  .font-note {
    font-size: 0.75rem;
  }
</style>
