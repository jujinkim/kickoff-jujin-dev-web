---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
---

<section
  class="demo"
  data-demo="material-3-expressive"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>{t("NEIGHBORS TOGETHER", "이웃과 함께", "ご近所と一緒に")}</small>
    <h2>{t("A picnic for everyone", "함께하는 소풍", "みんなのピクニック")}</h2>
    <p>
      {t(
        "Saturday · Riverside lawn · 12:00",
        "토요일 · 강변 잔디밭 · 12:00",
        "土曜日 · 川辺の芝生 · 12:00",
      )}
    </p>
  </header>
  <div class="invitation">
    <div class="flower" data-reactive-shape aria-hidden="true">
      ✳
    </div>
    <div class="rsvp">
      <label>
        {t("People in your group", "참가 인원", "参加人数")}
        <select data-people data-interactive disabled>
          {[1, 2, 3, 4, 5, 6].map((n) => (
            <option value={n}>{n}</option>
          ))}
        </select>
      </label>
      <button
        class="join"
        type="button"
        data-join
        aria-pressed="false"
        data-interactive
        disabled
        data-off={t("Join picnic", "참가하기", "参加する")}
        data-on={t("Cancel participation", "참가 취소", "参加を取り消す")}
      >
        {t("Join picnic", "참가하기", "参加する")}
      </button>
      <p
        class="state"
        data-state
        data-off={t("No participation yet", "참가 전", "まだ参加していません")}
        data-on={t(
          "Participation confirmed",
          "참가 완료",
          "参加を受け付けました",
        )}
      >
        {t("No participation yet", "참가 전", "まだ参加していません")}
      </p>
      <p>
        {t("Reserved places", "확보한 자리", "確保した席")}:{" "}
        <strong data-places>0</strong>
      </p>
    </div>
  </div>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("material-3-expressive", (root, say) => {
    const people = root.querySelector<HTMLSelectElement>("[data-people]")!;
    const join = root.querySelector<HTMLButtonElement>("[data-join]")!;
    const state = root.querySelector<HTMLElement>("[data-state]")!;
    let joined = false;
    const update = () => {
      join.setAttribute("aria-pressed", String(joined));
      join.textContent = joined ? join.dataset.on! : join.dataset.off!;
      state.textContent = joined ? state.dataset.on! : state.dataset.off!;
      root.querySelector("[data-places]")!.textContent = joined
        ? people.value
        : "0";
      root.dataset.joined = String(joined);
      say(`${state.textContent} · ${joined ? people.value : 0}`);
    };
    join.addEventListener("click", () => {
      joined = !joined;
      update();
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
        root
          .querySelector("[data-reactive-shape]")!
          .animate(
            [
              { transform: "rotate(0) scale(1)" },
              { transform: "rotate(25deg) scale(.9)" },
              { transform: "rotate(0) scale(1)" },
            ],
            { duration: 400 },
          );
    });
    people.addEventListener("change", update);
    return () => {
      joined = false;
      people.value = "1";
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #f1e9ff;
    color: #302147;
    border-radius: 28px;
  }
  header {
    max-width: 620px;
  }
  h2 {
    font-weight: 800;
    letter-spacing: -0.045em;
    margin-top: 16px;
  }
  .invitation {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: center;
    margin-top: 30px;
  }
  .flower {
    background: #cdebb2;
    color: #314d16;
    border-radius: 45% 20% 45% 20%;
    display: grid;
    place-items: center;
    font-size: clamp(6rem, 22cqi, 11rem);
    aspect-ratio: 1;
  }
  .rsvp {
    background: #e2d3fa;
    padding: 26px;
    border-radius: 38px 38px 12px 38px;
  }
  .rsvp label {
    display: grid;
    gap: 12px;
  }
  select {
    background: #fff;
    border: 0;
    border-radius: 16px;
  }
  .join {
    width: 100%;
    background: #5b2e91;
    color: white;
    border: 0;
    border-radius: 30px;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 22px 0;
  }
  .state {
    font-weight: 700;
  }
  footer button {
    background: #e2d3fa;
    border: 0;
    border-radius: 24px;
  }
  @container (width<540px) {
    .invitation {
      grid-template-columns: 1fr;
    }
    .flower {
      max-width: 210px;
      width: 100%;
      justify-self: center;
    }
  }

  .demo {
    border-radius: 48px 12px 48px 12px;
  }
  h2 {
    font-size: clamp(2.5rem, 9cqi, 5.4rem);
    line-height: 1.02;
  }
  .flower {
    border-radius: 50% 12% 50% 12%;
    background: #c5ee93;
  }
  .rsvp {
    border-radius: 64px 20px 64px 20px;
    padding: clamp(20px, 4cqi, 38px);
  }
  .join {
    min-height: 72px;
    border-radius: 38px 14px 38px 14px;
    font-size: 1.25rem;
  }
  .join[aria-pressed="true"] {
    border-radius: 12px 38px 12px 38px;
  }
</style>
