---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { photo } from "./photos";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const items = [
  { id: "photo", name: t("Beach photograph", "해변 사진", "浜辺の写真") },
  { id: "ticket", name: t("Ferry ticket", "페리 표", "フェリーの切符") },
  { id: "note", name: t("Harbor note", "항구 메모", "港のメモ") },
];
---

<section
  class="demo"
  data-demo="tactile-collage"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>{t("KEEPSAKES / SUMMER", "여름의 추억", "夏の思い出")}</small>
    <h2>
      {t("Little things, kept.", "작은 기억을 모아.", "小さな思い出を集めて。")}
    </h2>
  </header>
  <ol class="board">
    {items.map((item, i) => (
      <li data-piece={item.id} class={item.id}>
        <button
          type="button"
          data-select={item.id}
          aria-pressed={i === 0}
          data-interactive
          disabled
        >
          {item.name}
        </button>
        {item.id === "photo" ? (
          <img
            {...photo("beach-diary.png")}
            width="1536"
            height="1024"
            alt={t(
              "Waves on a sandy beach",
              "모래 해변에 밀려오는 파도",
              "砂浜に寄せる波",
            )}
          />
        ) : item.id === "ticket" ? (
          <div class="ticket-print">
            <strong>{t("COAST → ISLAND", "해안 → 섬", "海岸 → 島")}</strong>
            <p>09:20 · 1 {t("passenger", "명", "名")}</p>
            <small>
              {t(
                "Souvenir ticket · not valid for travel",
                "기념용 표 · 승선 불가",
                "思い出の切符 · 乗船不可",
              )}
            </small>
          </div>
        ) : (
          <p class="handnote">
            {t(
              "We stayed until the boats came home. Next time, bring a sketchbook.",
              "배들이 돌아올 때까지 머물렀다. 다음에는 스케치북을 가져가야지.",
              "船が戻るまで過ごした。今度はスケッチブックを持ってこよう。",
            )}
          </p>
        )}
      </li>
    ))}
  </ol>
  <div class="controls">
    <button type="button" data-earlier data-interactive disabled>
      {t("Move earlier", "앞으로 이동", "前へ移動")}
    </button>
    <button type="button" data-later data-interactive disabled>
      {t("Move later", "뒤로 이동", "後ろへ移動")}
    </button>
  </div>
  <p>
    {t(
      "Select a keepsake, then change its reading order.",
      "추억 조각을 선택한 뒤 읽는 순서를 바꿔 보세요.",
      "思い出の品を選んで、読む順序を変えてみましょう。",
    )}
  </p>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("tactile-collage", (root, say) => {
    const list = root.querySelector("ol")!;
    const original = [...root.querySelectorAll<HTMLElement>("[data-piece]")];
    const buttons = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-select]"),
    ];
    let selected = original[0];
    const choose = (id: string) => {
      selected = original.find((e) => e.dataset.piece === id)!;
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.select === id)),
      );
    };
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        choose(b.dataset.select!);
        say(b.textContent!);
      }),
    );
    const move = (direction: number) => {
      const items = [...list.children];
      const i = items.indexOf(selected);
      const next = i + direction;
      if (next < 0 || next >= items.length) {
        say(`${i + 1} / ${items.length}`);
        return;
      }
      if (direction < 0) list.insertBefore(selected, items[next]);
      else list.insertBefore(items[next], selected);
      say(
        `${selected.querySelector("button")!.textContent}: ${next + 1} / ${items.length}`,
      );
    };
    root
      .querySelector("[data-earlier]")!
      .addEventListener("click", () => move(-1));
    root
      .querySelector("[data-later]")!
      .addEventListener("click", () => move(1));
    return () => {
      original.forEach((e) => list.append(e));
      choose("photo");
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #e7decd;
    color: #423527;
    background-image: radial-gradient(#a18b6638 0.8px, transparent 0.8px);
    background-size: 7px 7px;
    padding: 30px;
  }
  header {
    margin-bottom: 30px;
  }
  h2 {
    font-family: Georgia, serif;
    font-style: italic;
    margin-top: 16px;
  }
  .board {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .board li {
    position: relative;
    padding: 20px 16px;
    background: #fffaf0;
    box-shadow: 3px 5px 7px #68513a33;
    min-width: 0;
    border: 1px solid #c7bda9;
  }
  .board li::before {
    content: "";
    position: absolute;
    top: -9px;
    left: 32%;
    width: 65px;
    height: 20px;
    background: #b79a6780;
    transform: rotate(-4deg);
  }
  .photo {
    grid-row: span 2;
  }
  .ticket {
    border-block: 4px dashed #89775c !important;
    background: #f4d798 !important;
  }
  .note {
    background: #e8edb6 !important;
  }
  img {
    width: 100%;
    height: auto;
    margin-top: 16px;
    display: block;
  }
  .ticket-print {
    margin-top: 22px;
  }
  .ticket-print strong {
    font-size: 1.25rem;
  }
  .handnote {
    font-family: Georgia, serif;
    font-style: italic;
    margin-top: 20px;
    line-height: 1.8;
  }
  .board button {
    width: 100%;
    text-align: left;
    border: 1px solid #89775c;
    background: #fffaf0;
  }
  .board button[aria-pressed="true"] {
    outline: 3px solid #625333;
    outline-offset: 3px;
    font-weight: 700;
  }
  .controls button,
  footer button {
    background: #fffaf0;
    border: 1px solid #89775c;
  }
  @container (width<580px) {
    .board {
      grid-template-columns: 1fr;
    }
    .photo {
      grid-row: auto;
    }
  }

  .board {
    gap: 36px;
    padding: 16px 6px;
  }
  .board li {
    box-shadow: 5px 9px 14px #68513a55;
  }
  .board li::before {
    width: 90px;
    height: 27px;
    top: -14px;
    background: #b79a67b3;
  }
  .ticket {
    border-inline: 7px dotted #e7decd;
  }
  .note {
    border-radius: 2px 2px 28px 2px;
  }
  @container (width > 600px) {
    .photo {
      transform: rotate(-2deg);
    }
    .ticket {
      transform: rotate(3deg);
    }
    .note {
      transform: rotate(-3deg);
    }
  }
</style>
