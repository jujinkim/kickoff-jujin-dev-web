---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { boundariesText } from "./boundaries";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  b = boundariesText(lang, "layered-architecture");
const layers = [
  [
    t("Presentation", "표현", "表示"),
    "HTTP / CLI",
    t(
      "Receives IDs; displays Saved",
      "ID 입력 · 저장 완료 표시",
      "IDを受け取り、保存完了を表示",
    ),
  ],
  [
    t("Application", "애플리케이션", "アプリケーション"),
    t(
      "SaveArticle(Jun, Borrowing Rules)",
      "SaveArticle(준, 대출 규칙)",
      "SaveArticle(ジュン, 貸出ルール)",
    ),
    t(
      "Validates IDs; coordinates saving",
      "ID 검증 · 저장 조율",
      "IDの検証と保存の調整",
    ),
  ],
  [
    t("Persistence", "저장", "保存"),
    `${b.memory} / ${b.database}`,
    t("Records one saved entry", "저장 항목 한 건 기록", "保存項目を1件記録"),
  ],
];
---

<section data-demo="layered-architecture" lang={lang}>
  <header>
    <p class="eyebrow">{b.fiction}</p>
    <h2>
      {t(
        "Three responsibilities, one process",
        "세 책임, 하나의 프로세스",
        "三つの責務、一つのプロセス",
      )}
    </h2>
    <p data-fixture>{b.fixture}</p>
  </header>
  <div class="deployment" data-process>
    <p class="process-label">{b.process}</p>
    <ol class="layers">
      {layers.map(([label, name, detail], index) => (
        <li data-layer>
          <div class="layer">
            <span class="number" aria-hidden="true">
              0{index + 1}
            </span>
            <div>
              <h3>{label}</h3>
              <p class="name">{name}</p>
              <p>{detail}</p>
            </div>
          </div>
          {index < 2 && (
            <div class="relations">
              <p data-import>
                <span class="arrow solid" aria-hidden="true">
                  ↓
                </span>
                {b.imports} ↓
              </p>
              <p data-call>
                <span class="arrow dashed" aria-hidden="true">
                  ↓
                </span>
                {b.calls} ↓
              </p>
            </div>
          )}
        </li>
      ))}
    </ol>
    <p class="return" data-return>
      {t(
        "↑ Saved returns: persistence → application → presentation",
        "↑ 저장 완료 반환: 저장 → 애플리케이션 → 표현",
        "↑ 保存完了の戻り：保存 → アプリケーション → 表示",
      )}
    </p>
  </div>
  <p class="rule" data-boundary>
    {t(
      "Closed-layer example: no skipping. Replace HTTP with CLI; validation stays in the application.",
      "폐쇄형 예시: 계층 건너뛰기 금지. HTTP를 CLI로 바꿔도 검증은 애플리케이션에 유지.",
      "閉鎖型の例：飛び越し禁止。HTTPをCLIに替えても検証はアプリケーションに残る。",
    )}
  </p>
  <ul class="outcomes" data-outcomes>
    <li>{b.outcome}</li>
    <li>{b.failure}</li>
  </ul>
  <p class="footnote">{b.alternatives}</p>
</section>
<style>
  section {
    container-type: inline-size;
    padding: clamp(16px, 4vw, 28px);
    background: #edf3f8;
    color: #20384c;
    border: 1px solid #8499ab;
    border-radius: 12px;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  p,
  h2,
  h3,
  ol,
  ul {
    margin: 0;
  }
  .eyebrow {
    color: #20384c;
    font-size: 0.8rem;
    font-weight: 700;
  }
  h2 {
    font-size: clamp(1.2rem, 3vw, 1.65rem);
    line-height: 1.3;
    margin: 0.4rem 0 0.7rem;
  }
  .deployment {
    border: 2px dotted #54738c;
    padding: 1rem;
    margin: 1.2rem 0;
  }
  .process-label {
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.8rem;
  }
  .layers {
    list-style: none;
    padding: 0;
  }
  .layer {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.85rem;
    background: #fff;
    border: 1px solid #6e879c;
    border-left: 5px solid #365c7a;
  }
  .number {
    font-family: monospace;
    font-size: 1rem;
  }
  h3 {
    font-size: 0.95rem;
  }
  .name {
    font-weight: 650;
    margin: 0.2rem 0;
  }
  .layer p:last-child {
    font-size: 0.85rem;
  }
  .relations {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 0.45rem 1rem;
    font-size: 0.75rem;
  }
  .relations p {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .arrow {
    display: inline-grid;
    place-items: center;
    border-left: 2px solid;
    padding-left: 0.3rem;
    font-size: 1.1rem;
  }
  .dashed {
    border-left-style: dashed;
  }
  .return {
    margin-top: 0.8rem;
    font-size: 0.85rem;
  }
  .rule {
    border-left: 3px solid #365c7a;
    padding-left: 0.8rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .outcomes {
    margin-top: 1rem;
    padding-left: 1.2rem;
    font-size: 0.85rem;
  }
  .outcomes li + li {
    margin-top: 0.35rem;
  }
  .footnote {
    margin-top: 0.8rem;
    font-size: 0.75rem;
  }
  @container (max-width: 430px) {
    .deployment {
      padding: 0.7rem;
    }
    .layer {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .relations {
      padding: 0.4rem 0;
      gap: 0.5rem;
    }
  }
  @media (forced-colors: active) {
    .deployment,
    .layer,
    .rule {
      border-color: CanvasText;
    }
  }
</style>
