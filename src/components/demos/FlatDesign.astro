---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const services = [
  t("General consultation", "일반 진료", "一般診療"),
  t("Health check", "건강 검진", "健康診断"),
];
---

<section
  class="demo"
  data-demo="flat-design"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>{t("NEIGHBORHOOD CLINIC", "동네 의원", "まちのクリニック")}</small>
    <h2>{t("Plan your visit", "진료 예약", "診察の予約")}</h2>
    <p>
      {t(
        "Choose a service and an available time.",
        "진료 항목과 가능한 시간을 고르세요.",
        "診療内容と空いている時間を選びましょう。",
      )}
    </p>
  </header>
  <form>
    <fieldset>
      <legend>1 · {t("Service", "진료 항목", "診療内容")}</legend>
      <label>
        <span>{t("Appointment type", "예약 종류", "予約の種類")}</span>
        <select data-service data-interactive disabled>
          {services.map((s, i) => (
            <option value={i}>{s}</option>
          ))}
        </select>
      </label>
    </fieldset>
    <fieldset>
      <legend>2 · {t("Saturday", "토요일", "土曜日")}</legend>
      <div class="slots">
        {["09:00", "10:30", "14:00"].map((s, i) => (
          <button
            type="button"
            data-slot
            aria-pressed={i === 0}
            data-interactive
            disabled
          >
            {s}
          </button>
        ))}
      </div>
    </fieldset>
    <button type="submit" data-confirm data-interactive disabled>
      {t("Review booking", "예약 내용 확인", "予約内容を確認")}
    </button>
  </form>
  <section class="receipt" data-receipt hidden>
    <h3>{t("Demo booking summary", "가상 예약 내용", "架空の予約内容")}</h3>
    <p data-booking></p>
    <small>
      {t(
        "No appointment is sent to a clinic.",
        "의원에 예약을 전송하지 않습니다.",
        "クリニックへの予約は送信されません。",
      )}
    </small>
  </section>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("flat-design", (root, say) => {
    const service = root.querySelector<HTMLSelectElement>("[data-service]")!;
    const slots = [...root.querySelectorAll<HTMLButtonElement>("[data-slot]")];
    const receipt = root.querySelector<HTMLElement>("[data-receipt]")!;
    let time = "09:00";
    const select = (s: string) => {
      time = s;
      slots.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.textContent === s)),
      );
      receipt.hidden = true;
    };
    slots.forEach((b) =>
      b.addEventListener("click", () => select(b.textContent!)),
    );
    service.addEventListener("change", () => (receipt.hidden = true));
    root.querySelector("form")!.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = `${service.selectedOptions[0].text} · ${time}`;
      root.querySelector("[data-booking]")!.textContent = text;
      receipt.hidden = false;
      say(text);
    });
    return () => {
      service.value = "0";
      select("09:00");
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #f3fafb;
    color: #123d48;
  }
  header {
    background: #006273;
    color: white;
    padding: 24px;
    margin: -16px -16px 26px;
  }
  header h2 {
    margin-top: 12px;
  }
  form {
    display: grid;
    gap: 24px;
  }
  fieldset {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    font-weight: 700;
    margin-bottom: 14px;
  }
  fieldset label {
    display: grid;
    gap: 8px;
  }
  .slots {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  button {
    border: 0;
    background: #006273;
    color: white;
    border-radius: 3px;
  }
  .slots button {
    background: white;
    color: #123d48;
    border: 2px solid #006273;
  }
  .slots button[aria-pressed="true"] {
    background: #006273;
    color: white;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .receipt {
    padding: 24px;
    background: #d2edf0;
    margin-top: 24px;
    border-left: 5px solid #006273;
  }

  .demo {
    background: #fff;
  }
  header {
    margin: 0 0 32px;
    padding: 30px;
    border-radius: 0;
  }
  header h2 {
    font-size: clamp(2rem, 5cqi, 3.4rem);
  }
  .slots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .slots button {
    padding: 24px 10px;
    border-radius: 0;
  }
  .receipt {
    border-left-width: 10px;
    border-radius: 0;
  }
  button,
  input,
  select {
    box-shadow: none;
    background-image: none;
  }
  @container (width < 380px) {
    .slots {
      grid-template-columns: 1fr;
    }
  }
</style>
