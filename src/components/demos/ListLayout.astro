---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
---

<section
  class="demo"
  data-demo="list-layout"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <small>{t("READING ROOM", "읽는 방", "読書室")}</small>
  <h2>{t("On the list", "읽을 목록", "読むものリスト")}</h2>
  <div class="controls">
    <label>
      {t("Topic", "주제", "テーマ")}
      <select data-topic data-interactive disabled>
        <option value="all">{t("All", "전체", "すべて")}</option>
        <option value="space">{t("Space", "공간", "空間")}</option>
        <option value="type">{t("Type", "글자", "文字")}</option>
      </select>
    </label>
    <label>
      {t("Sort", "정렬", "並べ替え")}
      <select data-sort data-interactive disabled>
        <option value="new">{t("Newest", "최신순", "新しい順")}</option>
        <option value="short">{t("Shortest", "짧은순", "短い順")}</option>
      </select>
    </label>
  </div>
  <ol>
    {[
      t("Spaces between", "사이의 공간", "間の空間"),
      t("Letters in motion", "움직이는 글자", "動く文字"),
      t("A room to read", "읽기 위한 방", "読むための部屋"),
      t("Signs of the city", "도시의 안내판", "街の案内板"),
    ].map((title, i) => (
      <li
        data-row
        data-topic={i % 2 ? "type" : "space"}
        data-minutes={[8, 3, 5, 2][i]}
        data-date={4 - i}
      >
        <span class="index">0{i + 1}</span>
        <div>
          <h3>{title}</h3>
          <p>
            {t(
              "Notes on attention and everyday design.",
              "집중과 일상 디자인에 관한 기록.",
              "注意と日常のデザインについての記録。",
            )}
          </p>
        </div>
        <small>
          2026.09.{24 - i}
          <br />
          {[8, 3, 5, 2][i]} {t("min", "분", "分")}
        </small>
      </li>
    ))}
  </ol>

  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("list-layout", (root, say) => {
    const topic = root.querySelector<HTMLSelectElement>("select[data-topic]")!,
      sort = root.querySelector<HTMLSelectElement>("[data-sort]")!,
      list = root.querySelector("ol")!;
    const rows = [...root.querySelectorAll<HTMLElement>("[data-row]")];
    const update = () => {
      const ordered = [...rows].sort((a, b) =>
        sort.value === "short"
          ? Number(a.dataset.minutes) - Number(b.dataset.minutes)
          : Number(b.dataset.date) - Number(a.dataset.date),
      );
      let count = 0;
      ordered.forEach((row) => {
        row.hidden = topic.value !== "all" && row.dataset.topic !== topic.value;
        if (!row.hidden) count++;
        list.append(row);
      });
      say(`${count} / ${rows.length} · ${sort.selectedOptions[0].textContent}`);
    };
    topic.addEventListener("change", update);
    sort.addEventListener("change", update);
    return () => {
      topic.value = "all";
      sort.value = "new";
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  .demo * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.12;
  }
  h3 {
    font-size: 1.2rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  button,
  select,
  input,
  textarea {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]):not([type="range"]) {
    min-height: 44px;
    padding: 8px 12px;
  }
  button,
  select {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  input,
  textarea,
  select {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
      animation: none !important;
    }
  }
  .demo {
    background: #fffdf8;
    color: #2b3330;
  }
  h2 {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  ol {
    list-style: none;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) 90px;
    gap: 14px;
    align-items: start;
    border-top: 1px solid #acb4a9;
    padding: 22px 0;
  }
  .index {
    color: #526558;
  }
  li p {
    font-size: 0.85rem;
    margin: 0;
  }
  li small {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 450px) {
    li {
      grid-template-columns: 24px minmax(0, 1fr);
    }
    li small {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
