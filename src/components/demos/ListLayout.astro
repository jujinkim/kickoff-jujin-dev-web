---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const books = [
  { title: "Pride and Prejudice", author: "Jane Austen", available: true },
  { title: "Frankenstein", author: "Mary Shelley", available: false },
  {
    title: "Alice’s Adventures in Wonderland",
    author: "Lewis Carroll",
    available: true,
  },
  { title: "A Room of One’s Own", author: "Virginia Woolf", available: true },
];
---

<section
  class="demo"
  data-demo="list-layout"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>{t("READING ROOM", "작은 도서관", "小さな図書館")}</small>
    <h2>{t("Find your next book", "다음에 읽을 책", "次に読む一冊")}</h2>
  </header>
  <div class="controls">
    <label class="search">
      {t("Title or author", "제목 또는 저자", "書名または著者")}
      <input
        type="search"
        data-search
        maxlength="80"
        data-interactive
        disabled
      />
    </label>
    <label>
      {t("Availability", "대출 상태", "貸出状況")}
      <select data-availability data-interactive disabled>
        <option value="all">{t("All books", "전체 도서", "すべての本")}</option>
        <option value="available">
          {t("Available now", "대출 가능", "貸出可能")}
        </option>
      </select>
    </label>
  </div>
  <p>
    {t("Results", "검색 결과", "検索結果")}: <strong data-count>4</strong>
  </p>
  <ul>
    {books.map((b, i) => (
      <li
        data-book
        data-available={String(b.available)}
        data-search-text={`${b.title} ${b.author}`}
      >
        <span class="number" aria-hidden="true">
          0{i + 1}
        </span>
        <div>
          <h3 lang="en">{b.title}</h3>
          <p lang="en">{b.author}</p>
        </div>
        <strong class="availability">
          {b.available
            ? t("Available", "대출 가능", "貸出可能")
            : t("On loan", "대출 중", "貸出中")}
        </strong>
      </li>
    ))}
  </ul>
  <p data-empty hidden>
    {t(
      "No matching books. Clear the search or include all books.",
      "일치하는 책이 없습니다. 검색어를 지우거나 전체 도서를 선택하세요.",
      "一致する本がありません。検索語を消すか、すべての本を選んでください。",
    )}
  </p>
  <small>
    {t(
      "Real titles; fictional lending status.",
      "실제 책 제목이며 대출 상태는 가상입니다.",
      "実在の書名ですが、貸出状況は架空です。",
    )}
  </small>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("list-layout", (root, say) => {
    const search = root.querySelector<HTMLInputElement>("[data-search]")!;
    const available = root.querySelector<HTMLSelectElement>(
      "[data-availability]",
    )!;
    const update = () => {
      let n = 0;
      const query = search.value.trim().toLocaleLowerCase();
      root.querySelectorAll<HTMLElement>("[data-book]").forEach((b) => {
        b.hidden =
          !b.dataset.searchText!.toLocaleLowerCase().includes(query) ||
          (available.value === "available" && b.dataset.available !== "true");
        if (!b.hidden) n++;
      });
      root.querySelector("[data-count]")!.textContent = String(n);
      root.querySelector<HTMLElement>("[data-empty]")!.hidden = n > 0;
      say(String(n));
    };
    search.addEventListener("input", update);
    available.addEventListener("change", update);
    return () => {
      search.value = "";
      available.value = "all";
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #faf8f1;
    color: #38362e;
  }
  h2 {
    font-family: Georgia, serif;
    font-weight: 400;
    margin-top: 16px;
  }
  .controls {
    align-items: end;
    background: #ede9dc;
    padding: 18px;
  }
  .controls label {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .search {
    flex: 1;
  }
  input {
    width: 100%;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 20px 0;
  }
  li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 120px;
    gap: 16px;
    align-items: baseline;
    padding: 24px 0;
    border-top: 1px solid #b3ad9e;
  }
  li h3 {
    font-family: Georgia, serif;
    font-size: 1.2rem;
  }
  li p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }
  .number {
    font-size: 0.8rem;
  }
  .availability {
    font-size: 0.85rem;
  }
  button {
    background: #38362e;
    color: white;
  }
  @container (width<470px) {
    li {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .availability {
      grid-column: 2;
    }
    .controls label {
      width: 100%;
    }
  }

  ul {
    border-bottom: 3px solid #38362e;
  }
  li {
    padding: 24px 12px;
    border-top: 2px solid #b3ad9e;
  }
  li:nth-child(even) {
    background: #eeeadf;
  }
  .number {
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .availability {
    border-left: 3px solid #38362e;
    padding-left: 12px;
  }
</style>
