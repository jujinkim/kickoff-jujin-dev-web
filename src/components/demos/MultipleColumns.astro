---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const titles = [
  t("Overview", "개요", "概要"),
  t("Materials", "재료", "素材"),
  t("Process", "과정", "工程"),
];
const bodies = [
  t(
    "A shared place for observations. Start with a question and gather evidence.",
    "관찰을 모으는 공간입니다. 질문에서 시작해 근거를 모읍니다.",
    "観察を集める場所。問いから始め、根拠を集めます。",
  ),
  t(
    "Paper, pencil, and a camera. Choose tools that keep the record easy to revisit.",
    "종이, 연필, 카메라. 기록을 다시 살피기 쉬운 도구를 선택합니다.",
    "紙、鉛筆、カメラ。記録を見返しやすい道具を選びます。",
  ),
  t(
    "Observe, group, and review. Keep the source attached to each finding.",
    "관찰하고 분류하고 검토합니다. 발견마다 출처를 함께 남깁니다.",
    "観察、分類、確認。それぞれの発見に出典を残します。",
  ),
];
---

<section
  class="demo"
  data-demo="multiple-columns"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <div class="controls">
    <label>
      {t("Preview width", "미리보기 폭", "表示幅")}
      <select data-width data-interactive disabled>
        <option value="wide">{t("Wide", "넓게", "広い")}</option>
        <option value="narrow">{t("Narrow", "좁게", "狭い")}</option>
      </select>
    </label>
  </div>
  <div class="frame">
    <div class="workspace">
      <nav aria-label={t("Documents", "문서", "文書")}>
        <strong>{t("FIELD GUIDE", "현장 가이드", "現場ガイド")}</strong>
        {titles.map((title, i) => (
          <button
            type="button"
            data-doc={i}
            aria-pressed={i === 0 ? "true" : "false"}
            data-interactive
            disabled
          >
            {title}
          </button>
        ))}
      </nav>
      <article>
        <small>
          DOC / <span data-doc-number>01</span>
        </small>
        <h2 data-doc-title>{titles[0]}</h2>
        <p data-doc-body>{bodies[0]}</p>
        <div class="diagram" aria-hidden="true">
          <span>01</span>
          <span>→</span>
          <span>02</span>
          <span>→</span>
          <span>03</span>
        </div>
        <p>
          {t(
            "Select a document to keep the navigation in place while changing the reading area.",
            "문서를 선택하면 탐색은 유지되고 읽기 영역만 바뀝니다.",
            "文書を選ぶとナビゲーションを保ったまま、読む領域だけが変わります。",
          )}
        </p>
      </article>
      <aside>
        <small>{t("RELATED MATERIAL", "관련 자료", "関連資料")}</small>
        <h3 data-related>{titles[1]}</h3>
        <p>
          {t(
            "Reference notes and context stay beside the active document.",
            "참고 노트와 맥락을 선택한 문서 옆에 둡니다.",
            "参考ノートと背景を選択中の文書の隣に置きます。",
          )}
        </p>
        <strong>↗ 03</strong>
      </aside>
    </div>
  </div>
  <div
    hidden
    data-bodies={JSON.stringify(bodies)}
    data-titles={JSON.stringify(titles)}
  ></div>
  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("multiple-columns", (root, say) => {
    const width = root.querySelector<HTMLSelectElement>("[data-width]")!;
    const frame = root.querySelector<HTMLElement>(".frame")!;
    width.addEventListener("change", () => {
      frame.dataset.width = width.value;
      say(width.selectedOptions[0].textContent!);
    });
    const data = root.querySelector<HTMLElement>("[data-bodies]")!;
    const titles = JSON.parse(data.dataset.titles!) as string[],
      bodies = JSON.parse(data.dataset.bodies!) as string[];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-doc]")];
    const show = (index: number) => {
      buttons.forEach((b, i) =>
        b.setAttribute("aria-pressed", String(i === index)),
      );
      root.querySelector("[data-doc-title]")!.textContent = titles[index];
      root.querySelector("[data-doc-body]")!.textContent = bodies[index];
      root.querySelector("[data-doc-number]")!.textContent = `0${index + 1}`;
      const related = root.querySelector("[data-related]");
      if (related) related.textContent = titles[(index + 1) % 3];
      say(titles[index]);
    };
    buttons.forEach((b, i) => b.addEventListener("click", () => show(i)));
    return () => {
      width.value = "wide";
      frame.dataset.width = "wide";
      show(0);
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  .demo * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.12;
  }
  h3 {
    font-size: 1.2rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  button,
  select,
  input,
  textarea {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]):not([type="range"]) {
    min-height: 44px;
    padding: 8px 12px;
  }
  button,
  select {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  input,
  textarea,
  select {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
      animation: none !important;
    }
  }
  .demo {
    background: #e8eef0;
    color: #203945;
  }
  .frame {
    container-type: inline-size;
    margin: auto;
  }
  .frame[data-width="narrow"] {
    max-width: 300px;
  }
  .workspace {
    display: grid;
    grid-template-columns: 145px minmax(0, 1fr) 150px;
    border: 1px solid #8fa4ae;
  }
  nav {
    background: #d8e3e8;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  nav strong {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  nav button {
    text-align: left;
    border: 0;
  }
  nav button[aria-pressed="true"] {
    background: #214b60;
    color: white;
  }
  article {
    background: #fff;
    padding: 24px;
    min-width: 0;
  }
  h2 {
    font-size: 1.8rem;
  }
  .diagram {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    padding: 24px 0;
    font-size: 1.5rem;
  }
  aside {
    padding: 20px;
    background: #f3f1e6;
    border-left: 1px solid #b6bfbc;
  }
  p {
    line-height: 1.7;
  }
  @container (max-width:620px) {
    .workspace {
      grid-template-columns: 1fr;
    }
    nav {
      border-bottom: 1px solid #8fa4ae;
    }
    aside {
      border-left: 0;
      border-top: 1px solid #b6bfbc;
    }
  }
</style>
