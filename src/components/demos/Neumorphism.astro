---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
import "./comparison-base.css";
---

<section
  class="demo"
  data-comparison="tasks"
  data-demo="neumorphism"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <header>
    <span>✓</span>
    <div>
      <small>
        {t("PROJECT / TODAY", "프로젝트 / 오늘", "プロジェクト / 今日")}
      </small>
      <h2>{t("Make room", "공간 만들기", "余白をつくる")}</h2>
    </div>
  </header>
  <div class="controls">
    <label>
      {t("Status", "상태", "状態")}
      <select data-filter data-interactive disabled>
        <option value="all">{t("All", "전체", "すべて")}</option>
        <option value="open">{t("Open", "진행 중", "未完了")}</option>
        <option value="done">{t("Done", "완료", "完了")}</option>
      </select>
    </label>
    <strong data-count>0 / 3</strong>
  </div>
  <ul>
    {[
      t("Gather references", "참고 자료 모으기", "参考資料を集める"),
      t("Draw the first draft", "첫 초안 그리기", "最初の案を描く"),
      t("Review labels", "라벨 검토하기", "ラベルを確認する"),
    ].map((text, i) => (
      <li data-task>
        <label>
          <input type="checkbox" data-check data-interactive disabled />
          <span>{text}</span>
        </label>
        <small>0{i + 1}</small>
      </li>
    ))}
  </ul>
  <p data-empty hidden>
    {t(
      "No tasks in this state.",
      "해당 상태의 작업이 없습니다.",
      "この状態のタスクはありません。",
    )}
  </p>

  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mountTasks } from "./tasks";
  mountTasks("neumorphism");
</script>
<style>
  .demo {
    background: #f1f5f9;
    color: #17304e;
  }
  header {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 22px;
  }
  header > span {
    font-size: 3rem;
  }
  h2 {
    font-size: 2rem;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 20px 12px;
    border-bottom: 1px solid;
  }
  li:has(:checked) span {
    text-decoration: line-through;
  }
  .controls {
    justify-content: space-between;
  }
  .demo {
    background: #e3e8ed;
    color: #35475a;
    border: 1px solid #a5b1bf;
    border-radius: 26px;
  }
  header {
    border-radius: 22px;
    box-shadow:
      9px 9px 18px #bdc4ce,
      -9px -9px 18px #fff;
    border: 1px solid #bdc4ce;
  }
  ul {
    display: grid;
    gap: 20px;
  }
  li {
    background: #e3e8ed;
    border: 1px solid #bdc4ce;
    border-radius: 18px;
    box-shadow:
      6px 6px 12px #bdc4ce,
      -6px -6px 12px #fff;
  }
  li:has(:checked) {
    box-shadow:
      inset 4px 4px 8px #bdc4ce,
      inset -4px -4px 8px #fff;
  }
  button,
  select {
    background: #e3e8ed;
    color: #35475a;
    border: 1px solid #9ba9b9;
    border-radius: 12px;
    box-shadow:
      4px 4px 8px #bdc4ce,
      -4px -4px 8px #fff;
  }
  button:active {
    box-shadow:
      inset 4px 4px 8px #bdc4ce,
      inset -4px -4px 8px #fff;
  }
  input {
    accent-color: #476784;
  }
</style>
