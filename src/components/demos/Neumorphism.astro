---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const moves = [
  t("Shoulder roll", "어깨 돌리기", "肩回し"),
  t("Ankle circle", "발목 돌리기", "足首回し"),
];
---

<section
  class="demo"
  data-demo="neumorphism"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>{t("A QUIET BREAK", "잠깐의 휴식", "静かな休憩")}</small>
    <h2>{t("Stretch timer", "스트레칭 타이머", "ストレッチタイマー")}</h2>
  </header>
  <div class="timer">
    <div class="dial">
      <strong data-seconds>30</strong>
      <span>{t("seconds remaining", "초 남음", "秒 残り")}</span>
    </div>
    <label>
      {t("Movement", "동작", "動き")}
      <select data-move data-interactive disabled>
        {moves.map((m, i) => (
          <option value={i}>{m}</option>
        ))}
      </select>
    </label>
    <div class="controls">
      <button
        type="button"
        data-start
        aria-pressed="false"
        data-interactive
        disabled
      >
        {t("Start", "시작", "開始")}
      </button>
      <button
        type="button"
        data-pause
        aria-pressed="false"
        data-interactive
        disabled
      >
        {t("Pause", "일시정지", "一時停止")}
      </button>
    </div>
    <p
      data-phase
      data-idle={t("Ready", "준비", "準備完了")}
      data-running={t("Running", "진행 중", "計測中")}
      data-paused={t("Paused", "일시정지됨", "一時停止中")}
      data-done={t("Complete", "완료", "完了")}
    >
      {t("Ready", "준비", "準備完了")}
    </p>
  </div>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("neumorphism", (root, say) => {
    const output = root.querySelector<HTMLElement>("[data-seconds]")!;
    const phase = root.querySelector<HTMLElement>("[data-phase]")!;
    const start = root.querySelector<HTMLButtonElement>("[data-start]")!;
    const pause = root.querySelector<HTMLButtonElement>("[data-pause]")!;
    const move = root.querySelector<HTMLSelectElement>("[data-move]")!;
    let left = 30,
      deadline = 0,
      timer: ReturnType<typeof setInterval> | undefined;
    const stop = () => {
      if (timer !== undefined) clearInterval(timer);
      timer = undefined;
    };
    const mark = (s: string) => {
      phase.textContent = phase.dataset[s]!;
      start.setAttribute("aria-pressed", String(s === "running"));
      pause.setAttribute("aria-pressed", String(s === "paused"));
      say(phase.textContent);
    };
    const tick = () => {
      left = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
      output.textContent = String(left);
      if (!left) {
        stop();
        mark("done");
      }
    };
    start.addEventListener("click", () => {
      if (timer !== undefined) return;
      if (!left) left = 30;
      deadline = Date.now() + left * 1000;
      timer = setInterval(tick, 200);
      mark("running");
      tick();
    });
    pause.addEventListener("click", () => {
      if (timer === undefined) return;
      tick();
      stop();
      if (left) mark("paused");
    });
    const reset = () => {
      stop();
      left = 30;
      output.textContent = "30";
      mark("idle");
    };
    move.addEventListener("change", reset);
    window.addEventListener("pagehide", stop, { once: true });
    return () => {
      move.value = "0";
      reset();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #e4e9ed;
    color: #273844;
    border-radius: 30px;
    padding: 36px;
  }
  header {
    text-align: center;
  }
  h2 {
    font-size: 2rem;
    margin-top: 14px;
  }
  .timer {
    max-width: 460px;
    margin: 30px auto 0;
    text-align: center;
  }
  .dial {
    width: 220px;
    max-width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    margin: 0 auto 32px;
    box-shadow:
      12px 12px 26px #b5bfc7,
      -12px -12px 26px #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }
  .dial strong {
    font-size: 4rem;
    line-height: 1;
  }
  .dial span {
    font-size: 0.85rem;
  }
  label {
    justify-content: center;
    gap: 16px;
  }
  button,
  select {
    border: 0;
    border-radius: 18px;
    background: #e4e9ed;
    box-shadow:
      5px 5px 10px #b5bfc7,
      -5px -5px 10px #fff;
    color: #273844;
  }
  .controls {
    justify-content: center;
    margin: 30px 0;
  }
  button[aria-pressed="true"] {
    box-shadow:
      inset 4px 4px 8px #b5bfc7,
      inset -4px -4px 8px #fff;
    text-decoration: underline;
    text-underline-offset: 5px;
    font-weight: 800;
  }
  [data-phase] {
    font-weight: 700;
  }
  footer {
    text-align: center;
  }
  @media (forced-colors: active) {
    .dial {
      border: 2px solid CanvasText;
    }
  }

  .dial {
    position: relative;
    isolation: isolate;
    width: min(100%, 310px);
    box-shadow:
      20px 20px 38px #acb8c1,
      -20px -20px 38px #fff;
  }
  .dial::before {
    content: "";
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    z-index: -1;
    box-shadow:
      inset 7px 7px 14px #b5bfc7,
      inset -7px -7px 14px #fff;
  }
  .dial strong {
    font-size: clamp(3rem, 12cqi, 6rem);
  }
  button,
  select {
    box-shadow:
      8px 8px 16px #aebac3,
      -8px -8px 16px #fff;
  }
  button[aria-pressed="true"] {
    box-shadow:
      inset 7px 7px 12px #aebac3,
      inset -7px -7px 12px #fff;
  }
  @media (forced-colors: active) {
    .dial::before {
      display: none;
    }
  }
</style>
