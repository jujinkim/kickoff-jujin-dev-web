---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
---

<section
  class="demo"
  data-demo="neumorphism"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <small>{t("STUDIO", "스튜디오", "スタジオ")} / 01</small>
  <h2>{t("Evening light", "저녁 조명", "夕方の照明")}</h2>
  <div class="lamp" aria-hidden="true">
    <div class="bulb"></div>
  </div>
  <div class="controls">
    <button
      type="button"
      data-power
      aria-pressed="true"
      data-interactive
      disabled
    >
      ⏻ {t("Power", "전원", "電源")}
    </button>
    <label>
      {t("Brightness", "밝기", "明るさ")}
      <input
        type="range"
        min="0"
        max="100"
        value="65"
        data-level
        data-interactive
        disabled
      />
      <output>65%</output>
    </label>
  </div>

  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("neumorphism", (root, say) => {
    const power = root.querySelector<HTMLButtonElement>("[data-power]")!,
      level = root.querySelector<HTMLInputElement>("[data-level]")!;
    let on = true;
    const update = () => {
      power.setAttribute("aria-pressed", String(on));
      root.querySelector<HTMLElement>(".bulb")!.style.opacity = String(
        on ? Number(level.value) / 100 : 0,
      );
      root.querySelector("output")!.textContent = `${on ? level.value : 0}%`;
      say(`${power.textContent}: ${on ? "✓" : "—"} · ${on ? level.value : 0}%`);
    };
    power.addEventListener("click", () => {
      on = !on;
      update();
    });
    level.addEventListener("input", update);
    return () => {
      on = true;
      level.value = "65";
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  .demo * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.12;
  }
  h3 {
    font-size: 1.2rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  button,
  select,
  input,
  textarea {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]):not([type="range"]) {
    min-height: 44px;
    padding: 8px 12px;
  }
  button,
  select {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  input,
  textarea,
  select {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
      animation: none !important;
    }
  }
  .demo {
    background: #e1e6e9;
    color: #33414c;
    border-radius: 28px;
    border: 1px solid #a3afb8;
  }
  .lamp {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    margin: 30px auto;
    display: grid;
    place-items: center;
    box-shadow:
      12px 12px 24px #b1bac1,
      -12px -12px 24px #fff;
    border: 1px solid #adb8bf;
  }
  .bulb {
    width: 90px;
    height: 90px;
    background: #ffdf75;
    border: 2px solid #8b783c;
    border-radius: 50%;
    opacity: 0.65;
    box-shadow: 0 0 32px #ffdc65;
  }
  button {
    background: #e1e6e9;
    border-radius: 14px;
    border: 1px solid #8b99a3;
    box-shadow:
      5px 5px 10px #b1bac1,
      -5px -5px 10px #fff;
  }
  button[aria-pressed="true"] {
    box-shadow:
      inset 4px 4px 8px #b1bac1,
      inset -4px -4px 8px #fff;
    border: 2px solid #33414c;
  }
</style>
