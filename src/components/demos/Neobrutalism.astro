---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const events = [
  {
    kind: "food",
    name: t("Pancake lab", "팬케이크 연구소", "パンケーキ研究所"),
    time: "11:00",
    place: t("Garden", "정원", "庭"),
  },
  {
    kind: "play",
    name: t("Cardboard racers", "골판지 경주", "段ボールレース"),
    time: "13:00",
    place: t("Playground", "운동장", "校庭"),
  },
  {
    kind: "music",
    name: t("School band", "학교 밴드", "学校のバンド"),
    time: "15:00",
    place: t("Stage", "무대", "ステージ"),
  },
];
---

<section
  class="demo"
  data-demo="neobrutalism"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <span class="badge">
      {t("SAT / FREE ENTRY", "토 / 무료 입장", "土 / 入場無料")}
    </span>
    <h2>{t("School fair!", "학교 축제!", "学校祭！")}</h2>
    <p>
      {t(
        "Pick a plan for your afternoon.",
        "오후에 즐길 프로그램을 골라 보세요.",
        "午後に楽しむ予定を選びましょう。",
      )}
    </p>
  </header>
  <div class="controls">
    <label>
      {t("Activities", "활동", "アクティビティ")}
      <select data-filter data-interactive disabled>
        <option value="all">{t("All", "전체", "すべて")}</option>
        <option value="food">{t("Food", "먹거리", "食べ物")}</option>
        <option value="play">{t("Games", "놀이", "遊び")}</option>
        <option value="music">{t("Music", "음악", "音楽")}</option>
      </select>
    </label>
  </div>
  <div class="program">
    {events.map((e) => (
      <article data-event data-kind={e.kind}>
        <strong class="time">{e.time}</strong>
        <h3>{e.name}</h3>
        <p>{e.place}</p>
        <button
          type="button"
          data-interest
          aria-pressed="false"
          data-interactive
          disabled
        >
          <span aria-hidden="true" data-mark>
            ＋
          </span>{" "}
          {t("Interested", "관심 일정", "気になる予定")}
        </button>
      </article>
    ))}
  </div>
  <p class="saved">
    {t("Selected", "선택한 일정", "選んだ予定")}: <strong data-count>0</strong>
  </p>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("neobrutalism", (root, say) => {
    const filter = root.querySelector<HTMLSelectElement>("[data-filter]")!;
    const buttons = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-interest]"),
    ];
    filter.addEventListener("change", () => {
      root
        .querySelectorAll<HTMLElement>("[data-event]")
        .forEach(
          (e) =>
            (e.hidden =
              filter.value !== "all" && e.dataset.kind !== filter.value),
        );
      say(filter.selectedOptions[0].text);
    });
    const count = () => {
      const n = buttons.filter(
        (b) => b.getAttribute("aria-pressed") === "true",
      ).length;
      root.querySelector("[data-count]")!.textContent = String(n);
      say(String(n));
    };
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const on = b.getAttribute("aria-pressed") !== "true";
        b.setAttribute("aria-pressed", String(on));
        b.querySelector("[data-mark]")!.textContent = on ? "✓" : "＋";
        count();
      }),
    );
    return () => {
      filter.value = "all";
      root
        .querySelectorAll<HTMLElement>("[data-event]")
        .forEach((e) => (e.hidden = false));
      buttons.forEach((b) => {
        b.setAttribute("aria-pressed", "false");
        b.querySelector("[data-mark]")!.textContent = "＋";
      });
      count();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #fff0a9;
    color: #18151e;
    border: 3px solid #18151e;
  }
  header {
    padding: 16px 0 28px;
  }
  h2 {
    font-weight: 900;
    letter-spacing: -0.05em;
    margin-top: 20px;
  }
  .badge {
    display: inline-block;
    padding: 8px 14px;
    background: #dcc6ff;
    border: 3px solid;
    box-shadow: 4px 4px #18151e;
  }
  .program {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  article {
    background: #ffbead;
    border: 3px solid;
    padding: 20px;
    box-shadow: 6px 6px #18151e;
  }
  article:nth-child(2) {
    background: #c9e9b2;
  }
  article:nth-child(3) {
    background: #dcc6ff;
  }
  .time {
    display: block;
    font-size: 1.6rem;
    margin-bottom: 18px;
  }
  button,
  select {
    border: 3px solid #18151e;
    box-shadow: 3px 3px #18151e;
    border-radius: 0;
    background: white;
  }
  button[aria-pressed="true"] {
    background: #18151e;
    color: white;
    box-shadow: none;
  }
  .saved {
    margin-top: 30px;
  }
  @container (width<620px) {
    .program {
      grid-template-columns: 1fr;
    }
  }

  .demo {
    background: #ffe640;
    border-width: 5px;
    padding: clamp(22px, 4vw, 40px);
  }
  h2 {
    font-size: clamp(2.3rem, 8cqi, 5rem);
    line-height: 1.05;
  }
  .badge {
    background: #cf98ff;
    box-shadow: 7px 7px #18151e;
    transform: rotate(-3deg);
  }
  article {
    background: #ffad91;
    border-width: 4px;
    box-shadow: 10px 10px #18151e;
  }
  article:nth-child(2) {
    background: #b6ee66;
  }
  article:nth-child(3) {
    background: #cdb0ff;
  }
  button,
  select {
    border-width: 3px;
    box-shadow: 5px 5px #18151e;
  }
  button:active {
    transform: translate(3px, 3px);
    box-shadow: 2px 2px #18151e;
  }
</style>
