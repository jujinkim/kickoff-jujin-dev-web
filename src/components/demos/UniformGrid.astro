---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const titles = [
  t("Color atlas", "색 지도", "色の地図"),
  t("Paper forms", "종이 형태", "紙のかたち"),
  t("City rhythm", "도시 리듬", "街のリズム"),
  t("Quiet geometry", "고요한 기하", "静かな幾何"),
  t("Letter studies", "글자 연구", "文字の研究"),
  t("Light archive", "빛 기록", "光の記録"),
];
---

<section
  class="demo"
  data-demo="uniform-grid"
  lang={lang}
  data-reset-message={t(
    "Initial state restored",
    "초기 상태로 복원했습니다",
    "初期状態に戻しました",
  )}
>
  <small>{t("RESOURCE LIBRARY", "자료실", "資料室")}</small>
  <h2>{t("Useful things", "쓸모 있는 것들", "役立つもの")}</h2>
  <div class="controls">
    <label>
      {t("Category", "분류", "分類")}
      <select data-filter data-interactive disabled>
        <option value="all">{t("All", "전체", "すべて")}</option>
        <option value="visual">{t("Visual", "시각", "ビジュアル")}</option>
        <option value="type">{t("Type", "글자", "文字")}</option>
      </select>
    </label>
  </div>
  <div class="grid">
    {titles.map((title, i) => (
      <article data-card data-kind={i % 2 ? "type" : "visual"}>
        <div class={`art art-${i}`} aria-hidden="true">
          {["◒", "▤", "▦", "◭", "Aa", "◐"][i]}
        </div>
        <h3>{title}</h3>
        <details>
          <summary>{t("Details", "상세", "詳細")}</summary>
          <p>
            {t(
              "A small reference set for your next composition. Compare shape, spacing, and contrast.",
              "다음 구성을 위한 작은 참고 자료입니다. 형태, 간격, 대비를 비교하세요.",
              "次の構成のための小さな参考資料。形、間隔、コントラストを比べてください。",
            )}
          </p>
        </details>
      </article>
    ))}
  </div>

  <button class="reset" type="button" data-reset data-interactive disabled>
    {t("Reset", "초기화", "リセット")}
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { mount } from "./shared";
  mount("uniform-grid", (root, say) => {
    const filter = root.querySelector<HTMLSelectElement>("[data-filter]")!;
    const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")];
    const update = () => {
      cards.forEach(
        (c) =>
          (c.hidden =
            filter.value !== "all" && c.dataset.kind !== filter.value),
      );
      say(`${cards.filter((c) => !c.hidden).length} / ${cards.length}`);
    };
    filter.addEventListener("change", update);
    root
      .querySelectorAll("details")
      .forEach((d) =>
        d.addEventListener("toggle", () =>
          say(d.closest("article")!.querySelector("h3")!.textContent!),
        ),
      );
    return () => {
      filter.value = "all";
      root.querySelectorAll("details").forEach((d) => (d.open = false));
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 3vw, 32px);
    color-scheme: light;
  }
  .demo * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.12;
  }
  h3 {
    font-size: 1.2rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 18px 0;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }
  button,
  select,
  input,
  textarea {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]):not([type="range"]) {
    min-height: 44px;
    padding: 8px 12px;
  }
  button,
  select {
    cursor: pointer;
  }
  button {
    border: 1px solid currentColor;
    background: transparent;
  }
  input,
  textarea,
  select {
    background: #fff;
    color: #172329;
    border: 1px solid #67747c;
  }
  input[type="range"] {
    width: 150px;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  [role="status"] {
    min-height: 1.5em;
    font-size: 0.85rem;
    margin-top: 16px;
  }
  small {
    font-size: 0.8rem;
  }
  .reset {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
      animation: none !important;
    }
  }
  .demo {
    background: #eff0fa;
    color: #242b50;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }
  .grid article {
    background: #fff;
    border: 1px solid #a5acc7;
    padding: 16px;
    min-width: 0;
  }
  .art {
    height: 100px;
    display: grid;
    place-items: center;
    background: #d3daf6;
    color: #293d83;
    font-size: 4rem;
    margin-bottom: 18px;
  }
  .art-1,
  .art-4 {
    background: #f5d9c6;
    color: #93462a;
  }
  .art-2,
  .art-5 {
    background: #d4e8d9;
    color: #2d6844;
  }
  h3 {
    font-size: 1.1rem;
  }
  details p {
    font-size: 0.85rem;
    line-height: 1.6;
    margin-top: 10px;
  }
  @media (max-width: 650px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 420px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
