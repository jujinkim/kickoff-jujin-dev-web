---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { photo } from "./photos";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang);
const plants = [
  {
    name: t("Boston fern", "보스턴고사리", "ボストンファーン"),
    file: "fern-plant.png",
    light: t("Filtered light", "간접광", "間接光"),
    water: t("Keep evenly moist", "촉촉함 유지", "適度な湿り気"),
    group: "filtered",
  },
  {
    name: t("Monstera", "몬스테라", "モンステラ"),
    file: "monstera-plant.png",
    light: t("Filtered light", "간접광", "間接光"),
    water: t("Let the surface dry", "표면이 마른 뒤", "表面が乾いたら"),
    group: "filtered",
  },
  {
    name: t("Rosemary", "로즈메리", "ローズマリー"),
    file: "rosemary-plant.png",
    light: t("Bright sunlight", "밝은 햇빛", "明るい日差し"),
    water: t("Let the surface dry", "표면이 마른 뒤", "表面が乾いたら"),
    group: "sun",
  },
];
---

<section
  class="demo"
  data-demo="uniform-grid"
  lang={lang}
  data-reset-message={t("Reset", "초기화", "リセット")}
>
  <header>
    <small>{t("GREEN CORNER", "초록 한 켠", "緑のコーナー")}</small>
    <h2>
      {t("A plant for your space", "우리 공간의 식물", "部屋に迎える植物")}
    </h2>
    <p>
      {t(
        "Compare the same care fields on every card.",
        "모든 카드에서 같은 관리 항목을 비교하세요.",
        "どのカードでも同じ管理項目を比べられます。",
      )}
    </p>
  </header>
  <div class="controls">
    <label>
      {t("Light", "빛", "光")}
      <select data-light data-interactive disabled>
        <option value="all">{t("All", "전체", "すべて")}</option>
        <option value="filtered">
          {t("Filtered light", "간접광", "間接光")}
        </option>
        <option value="sun">
          {t("Bright sunlight", "밝은 햇빛", "明るい日差し")}
        </option>
      </select>
    </label>
  </div>
  <div class="plants">
    {plants.map((p) => (
      <article data-plant data-light-kind={p.group}>
        <img
          {...photo(p.file, "(max-width: 640px) 100vw, 400px")}
          width="1254"
          height="1254"
          alt={p.name}
        />
        <div class="facts">
          <h3>{p.name}</h3>
          <dl>
            <dt>{t("Light", "빛", "光")}</dt>
            <dd>{p.light}</dd>
            <dt>{t("Water", "물주기", "水やり")}</dt>
            <dd>{p.water}</dd>
          </dl>
        </div>
      </article>
    ))}
  </div>
  <p>
    {t("Showing", "표시 중", "表示中")}: <strong data-count>3</strong>
  </p>
  <footer>
    <button type="button" data-reset data-interactive disabled>
      {t("Reset", "초기화", "リセット")}
    </button>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </footer>
</section>
<script>
  import { mount } from "./shared";
  mount("uniform-grid", (root, say) => {
    const filter = root.querySelector<HTMLSelectElement>("[data-light]")!;
    const update = () => {
      let n = 0;
      root.querySelectorAll<HTMLElement>("[data-plant]").forEach((p) => {
        p.hidden =
          filter.value !== "all" && filter.value !== p.dataset.lightKind;
        if (!p.hidden) n++;
      });
      root.querySelector("[data-count]")!.textContent = String(n);
      say(String(n));
    };
    filter.addEventListener("change", update);
    return () => {
      filter.value = "all";
      update();
    };
  });
</script>
<style>
  .demo {
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(16px, 4vw, 36px);
    color-scheme: light;
    container-type: inline-size;
  }
  * {
    box-sizing: border-box;
  }
  h2,
  h3,
  p {
    margin: 0 0 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 5cqi, 3rem);
    line-height: 1.15;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    line-height: 1.65;
  }
  button,
  select,
  input {
    font: inherit;
    max-width: 100%;
    color: inherit;
  }
  button,
  select,
  input:not([type="checkbox"]) {
    min-height: 44px;
    padding: 10px 14px;
  }
  button,
  summary {
    cursor: pointer;
  }
  button {
    background: transparent;
    border: 1px solid currentColor;
  }
  select,
  input {
    background: #fff;
    color: #18252b;
    border: 1px solid #59656a;
  }
  input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  :focus-visible {
    outline: 3px dashed currentColor;
    outline-offset: 4px;
  }
  [hidden] {
    display: none !important;
  }
  footer {
    margin-top: 28px;
  }
  [role="status"] {
    min-height: 1.5em;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }
  small {
    font-size: 0.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (forced-colors: active) {
    button,
    input,
    select {
      border: 1px solid ButtonText;
    }
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
    }
  }
  .demo {
    background: #eef3e9;
    color: #2d412f;
  }
  h2 {
    font-family: Georgia, serif;
    font-weight: 400;
    margin-top: 16px;
  }
  .plants {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }
  article {
    border: 1px solid #b2c0a6;
    background: #fff;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .facts {
    padding: 20px;
  }
  h3 {
    min-height: 2.8em;
  }
  dl {
    margin: 0;
  }
  dt {
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  dd {
    margin: 0 0 18px;
    font-size: 0.95rem;
  }
  button {
    background: #334f35;
    color: #fff;
  }
  @container (width<610px) {
    .plants {
      grid-template-columns: 1fr;
    }
    h3 {
      min-height: 0;
    }
  }

  .plants {
    gap: 0;
    border: 2px solid #476248;
  }
  article {
    border: 2px solid #476248;
  }
  .facts {
    flex: 1;
    border-top: 3px solid #476248;
  }
  h3 {
    font-size: 1.35rem;
  }
</style>
