---
import type { Lang } from "../../lib/i18n";
import { local } from "./shared";
import { requirementsText } from "./requirements";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = local(lang),
  r = requirementsText(lang, "user-story");
const clauses = [
  [t("Role", "역할", "役割"), t("As a reader", "독자로서", "読者として")],
  [
    t("Goal", "목표", "目標"),
    t(
      "I want to save Morning Walk’s link",
      "아침 산책 링크를 저장하고 싶다",
      "朝の散歩のリンクを保存したい",
    ),
  ],
  [
    t("Benefit", "가치", "価値"),
    t(
      "so I can return later",
      "나중에 다시 찾을 수 있도록",
      "後で戻れるように",
    ),
  ],
];
---

<section data-demo="user-story" lang={lang}>
  <header>
    <p class="eyebrow">{r.fiction}</p>
    <h2>
      {t(
        "One small piece of user value",
        "사용자 가치의 작은 단위",
        "利用者にとっての小さな価値",
      )}
    </h2>
    <p data-fixture>{r.fixture}</p>
  </header>
  <div class="story-card">
    <p class="card-label">
      {t("Start the conversation", "대화를 시작하는 문장", "対話を始める文")}
    </p>
    <dl>
      {clauses.map(([label, text]) => (
        <div>
          <dt>{label}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="acceptance">
    <h3>{t("Agree on acceptance", "인수 기준 합의", "受け入れ基準の合意")}</h3>
    <ol>
      <li data-acceptance="success">
        <strong>
          {t("Save, then repeat", "저장 후 반복", "保存して繰り返す")}
        </strong>
        <span>
          {t(
            "0 → 1 → 1 entries. Never two copies.",
            "0 → 1 → 1건. 중복 항목을 만들지 않음.",
            "0 → 1 → 1件。重複を作らない。",
          )}
        </span>
      </li>
      <li data-acceptance="failure">
        <strong>
          {t(
            "Write fails before saving",
            "저장 전 쓰기 실패",
            "保存前に書き込み失敗",
          )}
        </strong>
        <span>
          {t(
            "0 entries. Report unsaved and offer retry.",
            "0건. 미저장을 알리고 재시도 안내.",
            "0件。未保存を伝え、再試行を案内。",
          )}
        </span>
      </li>
    </ol>
  </div>
  <p class="boundary" data-boundary>
    {r.boundary}
  </p>
</section>
<style>
  .eyebrow {
    color: #293c32;
  }
  section {
    container-type: inline-size;
    color: #293c32;
    background: #f2efe5;
    border: 1px solid #817e70;
    border-radius: 12px;
    padding: clamp(16px, 4vw, 30px);
    font-family: system-ui, sans-serif;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  p,
  h2,
  h3,
  dl,
  dd,
  ol {
    margin: 0;
  }
  h2 {
    font-size: clamp(1.2rem, 3vw, 1.65rem);
    line-height: 1.3;
    margin: 0.4rem 0 0.7rem;
  }
  .eyebrow,
  .card-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .story-card {
    background: #fffdf5;
    border: 1px solid #9a9078;
    border-top: 5px solid #806134;
    padding: 1.1rem;
    margin: 1.25rem 0;
  }
  dl {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  dl > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.7rem;
  }
  dt {
    font-size: 0.8rem;
    font-weight: 700;
    color: #66512f;
  }
  dd {
    font-size: 1.12rem;
    font-weight: 600;
  }
  h3 {
    font-size: 1rem;
  }
  ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    margin-top: 0.8rem;
    list-style: none;
    counter-reset: criterion;
  }
  li {
    counter-increment: criterion;
    border-top: 2px solid #4d6956;
    padding-top: 0.7rem;
  }
  li::before {
    content: counter(criterion, decimal-leading-zero);
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  li strong,
  li span {
    display: block;
  }
  li span {
    margin-top: 0.4rem;
    font-size: 0.9rem;
  }
  .boundary {
    margin-top: 1.2rem;
    padding-top: 0.8rem;
    border-top: 1px dashed #817e70;
    font-size: 0.85rem;
  }
  @container (max-width: 430px) {
    ol {
      grid-template-columns: 1fr;
    }
    dl > div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
  @media (forced-colors: active) {
    .story-card,
    li,
    .boundary {
      border-color: CanvasText;
    }
  }
</style>
