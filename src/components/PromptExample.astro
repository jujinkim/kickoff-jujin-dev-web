---
import { strings, type Lang } from "../lib/i18n";
import { composeStartupPrompt } from "../lib/prompt-builder";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang].promptValue;
const prompt = composeStartupPrompt(lang, {
  name: "",
  description: t.exampleDescription,
  notes: "",
});
---

<aside
  class="prompt-example"
  data-prompt-example
  aria-labelledby="prompt-example-title"
>
  <h2 id="prompt-example-title">{t.exampleTitle}</h2>
  <div class="example-input">
    <p class="example-label">{t.inputLabel}</p>
    <p data-example-description>{t.exampleDescription}</p>
  </div>
  <div class="example-additions">
    <p class="example-label">
      <span aria-hidden="true">＋</span> {t.addedLabel}
    </p>
    <ul role="list">
      {t.requests.map((request) => (
        <li>{request}</li>
      ))}
    </ul>
  </div>
  <details>
    <summary>{t.fullPrompt}</summary>
    <pre
      tabindex="0"
      aria-label={t.fullPrompt}
      data-example-prompt
    >{prompt}</pre>
  </details>
  <p class="example-note">{t.exampleNote}</p>
</aside>

<style>
  .prompt-example {
    min-width: 0;
    align-self: start;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    overflow: hidden;
  }
  h2 {
    margin: 0;
    padding: 20px 24px;
    font-size: 1.15rem;
    border-bottom: 1px solid var(--line);
  }
  .example-input,
  .example-additions {
    padding: 20px 24px;
  }
  .example-input p:last-child {
    margin-bottom: 0;
    font-size: 1rem;
    line-height: 1.7;
  }
  .example-additions {
    border-top: 1px solid var(--line);
    border-left: 3px solid var(--green);
  }
  .example-label {
    margin: 0 0 12px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  ul {
    margin: 0;
    padding-left: 20px;
    font-size: 0.9rem;
    line-height: 1.7;
  }
  li + li {
    margin-top: 8px;
  }
  details {
    border-top: 1px solid var(--line);
    padding: 0 24px;
  }
  summary {
    padding: 16px 0;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
  }
  pre {
    max-height: 22rem;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.8rem;
    line-height: 1.7;
    margin: 0 0 20px;
  }
  pre:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 3px;
  }
  .example-note {
    margin: 0;
    padding: 16px 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  @media (max-width: 440px) {
    h2,
    .example-input,
    .example-additions {
      padding: 16px;
    }
    details {
      padding-inline: 16px;
    }
    .example-note {
      padding: 12px 16px;
    }
  }
</style>
